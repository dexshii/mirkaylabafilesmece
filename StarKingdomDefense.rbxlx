      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[-- Challenges: harder runs of a campaign stage with modifiers. Clearing one awards Trait Crystals.
-- Each challenge pays its full reward once per day (UTC); replays the same day pay `repeatGems` only.
-- Modifiers (see Battle.luau): enemyHp, enemySpeed (multipliers), extraFlying, bossRush, startCash and killCash
-- (multipliers), onlyRarity (only units of that rarity can be placed), maxUnits (total units on the map).
local Challenges = {}

export type ChallengeDef = {
	id: string,
	name: string,
	desc: string,
	map: string,
	stage: number,
	modifiers: { [string]: any },
	crystals: number,
	gems: number,
	repeatGems: number,
}

local list: { ChallengeDef } = {
	{
		id = "skyswarm",
		name = "Sky Swarm",
		desc = "Every wave brings extra flyers. Bring anti-air!",
		map = "meadow",
		stage = 3,
		modifiers = { extraFlying = true },
		crystals = 3,
		gems = 60,
		repeatGems = 15,
	},
	{
		id = "speeddemons",
		name = "Speed Demons",
		desc = "Enemies move 50% faster.",
		map = "meadow",
		stage = 4,
		modifiers = { enemySpeed = 1.5 },
		crystals = 3,
		gems = 60,
		repeatGems = 15,
	},
	{
		id = "commonfolk",
		name = "Common Folk",
		desc = "Only Common units can be placed.",
		map = "desert",
		stage = 2,
		modifiers = { onlyRarity = "Common" },
		crystals = 4,
		gems = 80,
		repeatGems = 20,
	},
	{
		id = "budgetcuts",
		name = "Budget Cuts",
		desc = "Half the starting cash and 40% less cash from kills.",
		map = "desert",
		stage = 4,
		modifiers = { startCash = 0.5, killCash = 0.6 },
		crystals = 4,
		gems = 80,
		repeatGems = 20,
	},
	{
		id = "ironhide",
		name = "Iron Hide",
		desc = "Enemies have double health.",
		map = "frost",
		stage = 3,
		modifiers = { enemyHp = 2 },
		crystals = 5,
		gems = 100,
		repeatGems = 25,
	},
	{
		id = "smallsquad",
		name = "Small Squad",
		desc = "At most 6 units on the map at once.",
		map = "magma",
		stage = 3,
		modifiers = { maxUnits = 6 },
		crystals = 6,
		gems = 120,
		repeatGems = 30,
	},
	{
		id = "bossrush",
		name = "Boss Rush",
		desc = "Every boss in the kingdom, one after another.",
		map = "starcastle",
		stage = 1,
		modifiers = { bossRush = true },
		crystals = 10,
		gems = 200,
		repeatGems = 40,
	},
}

Challenges.List = list
Challenges.ById = {} :: { [string]: ChallengeDef }
for _, def in list do
	Challenges.ById[def.id] = def
end

function Challenges.today(): number
	return math.floor(os.time() / 86400)
end

return Challenges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Enemies</string>
          <string name="Source"><![CDATA[-- Enemies walk (or fly above) the map's path toward your castle.
--   kind: "ground" | "flying"; boss = true for boss enemies (they can be ground or flying)
--   hp / speed (studs per second) / cash (paid on kill) / leak (base damage if it reaches the castle)
--   armor: fraction of damage ignored
--   ability (bosses): see Battle.luau, "summon" | "stun" | "dash" | "shield" | "monarch"
local Enemies = {}

export type EnemyDef = {
	id: string,
	name: string,
	kind: string,
	boss: boolean?,
	hp: number,
	speed: number,
	cash: number,
	leak: number,
	armor: number?,
	splitInto: string?,
	ability: { [string]: any }?,
	scale: number?,
	desc: string,
}

local list: { EnemyDef } = {
	-- ground
	{ id = "grumble", name = "Grumble", kind = "ground", hp = 40, speed = 6, cash = 8, leak = 2, desc = "An angry mushroom. Walks." },
	{ id = "sprinter", name = "Dash Grumble", kind = "ground", hp = 26, speed = 11, cash = 7, leak = 2, desc = "Fast and fragile." },
	{
		id = "shellguard",
		name = "Shellguard",
		kind = "ground",
		hp = 120,
		speed = 4.5,
		cash = 14,
		leak = 4,
		armor = 0.3,
		desc = "Hides in its shell: takes 30% less damage.",
	},
	{
		id = "splitter",
		name = "Fuse Brute",
		kind = "ground",
		hp = 75,
		speed = 5.5,
		cash = 10,
		leak = 3,
		splitInto = "minibomb",
		desc = "Splits into two Mini Fuses when defeated.",
	},
	{ id = "minibomb", name = "Mini Fuse", kind = "ground", hp = 22, speed = 8, cash = 3, leak = 1, scale = 0.6, desc = "Small and quick." },

	-- flying
	{ id = "flutter", name = "Flutter Guy", kind = "flying", hp = 32, speed = 8, cash = 9, leak = 2, desc = "A masked flyer. Only anti-air units can hit it." },
	{
		id = "phantom",
		name = "Phantom",
		kind = "flying",
		hp = 95,
		speed = 5,
		cash = 14,
		leak = 4,
		armor = 0.15,
		desc = "A floating ghost. Tough, and only anti-air units can hit it.",
	},
	{ id = "skyray", name = "Sky Ray", kind = "flying", hp = 60, speed = 10.5, cash = 12, leak = 3, desc = "A fast flying manta." },

	-- bosses
	{
		id = "kinggrumble",
		name = "King Grumble",
		kind = "ground",
		boss = true,
		hp = 1950,
		speed = 3,
		cash = 300,
		leak = 999,
		scale = 3,
		ability = { type = "summon", every = 8, enemy = "grumble", count = 3 },
		desc = "Calls in Grumbles every 8 seconds.",
	},
	{
		id = "sandwyvern",
		name = "Sandstorm Wyvern",
		kind = "flying",
		boss = true,
		hp = 1700,
		speed = 4.5,
		cash = 320,
		leak = 999,
		scale = 2.6,
		ability = { type = "dash", every = 9, mult = 2.5, dur = 2 },
		desc = "A flying boss that dashes forward every 9 seconds.",
	},
	{
		id = "frostgolem",
		name = "Frost Golem",
		kind = "ground",
		boss = true,
		hp = 3150,
		speed = 2.6,
		cash = 360,
		leak = 999,
		armor = 0.1,
		scale = 3,
		ability = { type = "stun", every = 9, radius = 20, dur = 2.5 },
		desc = "Freezes (stuns) your units around it every 9 seconds.",
	},
	{
		id = "lavatitan",
		name = "Magma Titan",
		kind = "ground",
		boss = true,
		hp = 4350,
		speed = 2.4,
		cash = 400,
		leak = 999,
		scale = 3.2,
		ability = { type = "shield", every = 12, dur = 2, heal = 0.05 },
		desc = "Every 12 seconds turns invulnerable for 2 seconds and heals 5%.",
	},
	{
		id = "shadowmonarch",
		name = "Shadow Monarch",
		kind = "ground",
		boss = true,
		hp = 7100,
		speed = 2.5,
		cash = 600,
		leak = 999,
		armor = 0.15,
		scale = 3.4,
		ability = { type = "monarch", every = 10, enemy = "phantom", count = 2, radius = 18, dur = 2 },
		desc = "The final boss. Summons Phantoms and stuns units every 10 seconds.",
	},
}

Enemies.List = list
Enemies.ById = {} :: { [string]: EnemyDef }
for _, def in list do
	Enemies.ById[def.id] = def
end

Enemies.FlyHeight = 9

return Enemies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Maps</string>
          <string name="Source"><![CDATA[-- Campaign maps. Each map has 5 stages; clearing stage 5 (the boss) unlocks the next map.
-- Waypoints are {x, z} in studs on a 240 x 240 field centred on the arena origin; enemies walk them in order and the
-- castle stands on the last one.
local Maps = {}

export type MapDef = {
	id: string,
	name: string,
	desc: string,
	theme: { [string]: any },
	waypoints: { { number } },
	ground: { string },
	flying: { string },
	boss: string,
	hpMult: number,
}

local list: { MapDef } = {
	{
		id = "meadow",
		name = "Mushroom Meadow",
		desc = "Rolling green hills. A gentle start.",
		theme = {
			curb = Color3.fromRGB(150, 120, 80),
			grass2 = Color3.fromRGB(120, 205, 90),
			atmosphere = { density = 0.28, color = Color3.fromRGB(200, 225, 255), decay = Color3.fromRGB(120, 170, 230), haze = 1.2 },
			tint = Color3.fromRGB(255, 252, 240),
			saturation = 0.25,
			ground = Color3.fromRGB(96, 190, 80),
			groundMaterial = Enum.Material.Grass,
			path = Color3.fromRGB(214, 180, 120),
			pathMaterial = Enum.Material.Sand,
			decor = "tree",
			clock = 14,
			ambient = Color3.fromRGB(120, 120, 130),
			fog = Color3.fromRGB(170, 210, 255),
		},
		waypoints = { { -115, -80 }, { -40, -80 }, { -40, 40 }, { 40, 40 }, { 40, -60 }, { 100, -60 }, { 100, 85 } },
		ground = { "grumble", "sprinter", "shellguard" },
		flying = { "flutter" },
		boss = "kinggrumble",
		hpMult = 1,
	},
	{
		id = "desert",
		name = "Dusty Dunes",
		desc = "Scorching sand and skies full of flyers.",
		theme = {
			curb = Color3.fromRGB(140, 100, 60),
			grass2 = Color3.fromRGB(240, 212, 140),
			atmosphere = { density = 0.32, color = Color3.fromRGB(255, 225, 170), decay = Color3.fromRGB(220, 160, 90), haze = 2 },
			tint = Color3.fromRGB(255, 240, 215),
			saturation = 0.2,
			ground = Color3.fromRGB(232, 200, 120),
			groundMaterial = Enum.Material.Sand,
			path = Color3.fromRGB(180, 130, 80),
			pathMaterial = Enum.Material.Sandstone,
			decor = "cactus",
			clock = 12,
			ambient = Color3.fromRGB(150, 130, 100),
			fog = Color3.fromRGB(255, 225, 170),
		},
		waypoints = { { -115, 0 }, { -60, 0 }, { -60, -90 }, { 0, -90 }, { 0, 90 }, { 60, 90 }, { 60, 0 }, { 110, 0 } },
		ground = { "grumble", "sprinter", "splitter" },
		flying = { "flutter", "skyray" },
		boss = "sandwyvern",
		hpMult = 1.5,
	},
	{
		id = "frost",
		name = "Frosty Peaks",
		desc = "A long zig-zag through the snow.",
		theme = {
			curb = Color3.fromRGB(110, 150, 190),
			grass2 = Color3.fromRGB(220, 235, 250),
			atmosphere = { density = 0.38, color = Color3.fromRGB(225, 240, 255), decay = Color3.fromRGB(150, 180, 220), haze = 2.5 },
			tint = Color3.fromRGB(230, 242, 255),
			saturation = 0.1,
			ground = Color3.fromRGB(235, 245, 255),
			groundMaterial = Enum.Material.Snow,
			path = Color3.fromRGB(150, 200, 235),
			pathMaterial = Enum.Material.Ice,
			decor = "pine",
			clock = 9,
			ambient = Color3.fromRGB(140, 150, 180),
			fog = Color3.fromRGB(220, 235, 255),
		},
		waypoints = { { -115, -90 }, { 90, -90 }, { 90, -30 }, { -90, -30 }, { -90, 30 }, { 90, 30 }, { 90, 90 }, { -110, 90 } },
		ground = { "grumble", "shellguard", "splitter" },
		flying = { "phantom", "flutter" },
		boss = "frostgolem",
		hpMult = 2.1,
	},
	{
		id = "magma",
		name = "Magma Fortress",
		desc = "A spiral of stone over boiling lava.",
		theme = {
			curb = Color3.fromRGB(60, 40, 35),
			grass2 = Color3.fromRGB(85, 60, 55),
			atmosphere = { density = 0.42, color = Color3.fromRGB(255, 130, 70), decay = Color3.fromRGB(120, 30, 10), haze = 2.5 },
			tint = Color3.fromRGB(255, 225, 205),
			saturation = 0.3,
			ground = Color3.fromRGB(70, 55, 55),
			groundMaterial = Enum.Material.Basalt,
			path = Color3.fromRGB(120, 90, 80),
			pathMaterial = Enum.Material.Cobblestone,
			decor = "lavarock",
			clock = 20,
			ambient = Color3.fromRGB(150, 80, 60),
			fog = Color3.fromRGB(120, 40, 20),
		},
		waypoints = {
			{ -115, -100 },
			{ 100, -100 },
			{ 100, 100 },
			{ -90, 100 },
			{ -90, -60 },
			{ 60, -60 },
			{ 60, 60 },
			{ -50, 60 },
			{ -50, -20 },
			{ 20, -20 },
			{ 20, 20 },
		},
		ground = { "sprinter", "shellguard", "splitter" },
		flying = { "skyray", "phantom" },
		boss = "lavatitan",
		hpMult = 2.8,
	},
	{
		id = "starcastle",
		name = "Star Castle",
		desc = "The Shadow Monarch's throne. The final battle.",
		theme = {
			curb = Color3.fromRGB(200, 160, 60),
			grass2 = Color3.fromRGB(110, 85, 165),
			atmosphere = { density = 0.3, color = Color3.fromRGB(140, 110, 220), decay = Color3.fromRGB(60, 30, 120), haze = 1.5 },
			tint = Color3.fromRGB(240, 230, 255),
			saturation = 0.3,
			ground = Color3.fromRGB(90, 70, 140),
			groundMaterial = Enum.Material.Marble,
			path = Color3.fromRGB(240, 220, 120),
			pathMaterial = Enum.Material.SmoothPlastic,
			decor = "pillar",
			clock = 0,
			ambient = Color3.fromRGB(110, 90, 160),
			fog = Color3.fromRGB(40, 30, 80),
		},
		waypoints = { { 0, -115 }, { 0, -70 }, { -90, -70 }, { -90, 0 }, { 90, 0 }, { 90, 70 }, { 0, 70 }, { 0, 110 } },
		ground = { "grumble", "splitter", "shellguard" },
		flying = { "phantom", "skyray" },
		boss = "shadowmonarch",
		hpMult = 3.6,
	},
}

-- the paths above were drawn for a 240-stud field; the field is now smaller and tighter
local PATH_SCALE = 0.62
for _, def in list do
	for _, wp in def.waypoints do
		wp[1] = math.floor(wp[1] * PATH_SCALE + 0.5)
		wp[2] = math.floor(wp[2] * PATH_SCALE + 0.5)
	end
end

Maps.List = list
Maps.ById = {} :: { [string]: MapDef }
Maps.Index = {} :: { [string]: number }
for i, def in list do
	Maps.ById[def.id] = def
	Maps.Index[def.id] = i
end

Maps.Stages = 5
Maps.FieldHalf = 76
Maps.PathWidth = 8
Maps.StartCash = 800
Maps.StartCashPerMap = 250
Maps.BaseHealth = 100

export type Group = { enemy: string, count: number, interval: number, delay: number }
export type Wave = { groups: { Group }, hpMult: number, bossMult: number }

local function add(groups: { Group }, enemy: string, count: number, interval: number)
	if count > 0 then
		table.insert(groups, { enemy = enemy, count = count, interval = interval, delay = #groups * 2.5 })
	end
end

-- The waves of one campaign stage (or challenge, through modifiers).
function Maps.buildWaves(def: MapDef, stage: number, modifiers: { [string]: any }?): { Wave }
	local mods = modifiers or {}
	local waves: { Wave } = {}
	local base = def.hpMult * (1 + 0.10 * (stage - 1))

	if mods.bossRush then
		-- every map's boss, one per wave, each with escorts, scaled to this map
		for i, m in list do
			local groups = {}
			add(groups, m.ground[1], 4 + i, 0.8)
			add(groups, m.flying[1], 2 + i, 1)
			add(groups, m.boss, 1, 1)
			table.insert(waves, { groups = groups, hpMult = base * (0.55 + 0.15 * i), bossMult = base * (0.55 + 0.15 * i) })
		end
		return waves
	end

	local count = 6 + 2 * stage
	for w = 1, count do
		local groups = {}
		local extra = stage - 1
		add(groups, def.ground[1], 3 + w * 2 + extra, math.max(0.45, 1.1 - w * 0.04))
		if w >= 3 then
			add(groups, def.ground[2], math.floor(w / 2) + extra, 0.7)
		end
		if w >= 4 then
			local flyer = def.flying[(w % #def.flying) + 1]
			add(groups, flyer, math.floor(w / 2) + (mods.extraFlying and w or 0), 0.9)
		elseif mods.extraFlying then
			add(groups, def.flying[1], w + 1, 0.9)
		end
		if w >= 5 then
			add(groups, def.ground[3], math.floor((w - 3) / 2) + math.floor(extra / 2), 1.2)
		end
		if w == count and stage == Maps.Stages then
			add(groups, def.boss, 1, 1)
		elseif w == count and stage >= 3 then
			-- a mini-boss wave: a big push of the toughest regular enemy
			add(groups, def.ground[3], 4 + stage, 0.8)
		end
		-- every stage starts near base health and ramps to the map's full multiplier by its last wave
		local ramp = w / count
		table.insert(waves, { groups = groups, hpMult = (1 + 0.10 * (w - 1)) * (1 + (base - 1) * ramp), bossMult = base })
	end
	return waves
end

return Maps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[-- Builds every unit and enemy model out of plain parts, so the game needs no uploaded meshes.
-- Models face -Z (Roblox's forward). Each model's PrimaryPart "Root" is an invisible part at its feet; the other
-- parts are welded to it, so moving Root moves the model.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Units = require(script.Parent.Units)

local ModelFactory = {}

local WHITE = Color3.fromRGB(250, 250, 250)
local BLACK = Color3.fromRGB(25, 25, 30)
local SKIN = Color3.fromRGB(255, 205, 160)
local GOLD = Color3.fromRGB(255, 205, 40)

type Spec = { any }

-- spec: { shape, size, pos, color, extras? } ; extras: { r = rotation degrees, m = material, t = transparency }
local function P(shape: string, size: Vector3, pos: Vector3, color: Color3, extras: { [string]: any }?): Spec
	return { shape, size, pos, color, extras or {} }
end

local function eyes(y: number, z: number, spacing: number, size: number, color: Color3?): { Spec }
	return {
		P("Ball", Vector3.new(size, size * 1.4, size * 0.6), Vector3.new(-spacing, y, z), WHITE),
		P("Ball", Vector3.new(size, size * 1.4, size * 0.6), Vector3.new(spacing, y, z), WHITE),
		P("Ball", Vector3.new(size * 0.5, size * 0.8, size * 0.4), Vector3.new(-spacing, y, z - size * 0.22), color or BLACK),
		P("Ball", Vector3.new(size * 0.5, size * 0.8, size * 0.4), Vector3.new(spacing, y, z - size * 0.22), color or BLACK),
	}
end

local function angryBrows(y: number, z: number, spacing: number, w: number): { Spec }
	return {
		P("Block", Vector3.new(w, w * 0.25, 0.2), Vector3.new(-spacing, y, z), BLACK, { r = Vector3.new(0, 0, -20) }),
		P("Block", Vector3.new(w, w * 0.25, 0.2), Vector3.new(spacing, y, z), BLACK, { r = Vector3.new(0, 0, 20) }),
	}
end

local function feet(color: Color3, spacing: number, size: number): { Spec }
	return {
		P("Ball", Vector3.new(size, size * 0.6, size * 1.3), Vector3.new(-spacing, size * 0.3, -size * 0.2), color),
		P("Ball", Vector3.new(size, size * 0.6, size * 1.3), Vector3.new(spacing, size * 0.3, -size * 0.2), color),
	}
end

local function concat(...: { Spec }): { Spec }
	local out = {}
	for _, list in { ... } do
		for _, s in list do
			table.insert(out, s)
		end
	end
	return out
end

local function mushroom(capColor: Color3, spotColor: Color3, stemColor: Color3, footColor: Color3, angry: boolean): { Spec }
	local specs = {
		P("Ball", Vector3.new(2.2, 2.0, 2.2), Vector3.new(0, 1.3, 0), stemColor),
		P("Ball", Vector3.new(3.6, 2.1, 3.6), Vector3.new(0, 2.7, 0), capColor),
		P("Ball", Vector3.new(0.9, 0.5, 0.9), Vector3.new(0, 3.65, 0), spotColor),
		P("Ball", Vector3.new(0.8, 0.6, 0.5), Vector3.new(-1.2, 2.9, -1.2), spotColor),
		P("Ball", Vector3.new(0.8, 0.6, 0.5), Vector3.new(1.2, 2.9, -1.2), spotColor),
		P("Ball", Vector3.new(0.8, 0.6, 0.5), Vector3.new(0, 2.8, 1.65), spotColor),
	}
	specs = concat(specs, eyes(1.5, -1.0, 0.4, 0.45), feet(footColor, 0.6, 1.0))
	if angry then
		specs = concat(specs, angryBrows(2.0, -1.12, 0.42, 0.6))
	end
	return specs
end

local function ghost(color: Color3, transparency: number, angry: boolean): { Spec }
	local specs = {
		P("Ball", Vector3.new(3.2, 3.2, 3.2), Vector3.new(0, 2.6, 0), color, { t = transparency }),
		P("Ball", Vector3.new(1.2, 1.2, 1.4), Vector3.new(0, 1.3, 1.3), color, { t = transparency }),
		P("Ball", Vector3.new(0.9, 0.7, 0.7), Vector3.new(-1.7, 2.4, -0.3), color, { t = transparency }),
		P("Ball", Vector3.new(0.9, 0.7, 0.7), Vector3.new(1.7, 2.4, -0.3), color, { t = transparency }),
		P("Ball", Vector3.new(0.4, 0.8, 0.3), Vector3.new(-0.5, 3.0, -1.5), BLACK),
		P("Ball", Vector3.new(0.4, 0.8, 0.3), Vector3.new(0.5, 3.0, -1.5), BLACK),
		P("Ball", Vector3.new(1.0, 0.5, 0.3), Vector3.new(0, 2.2, -1.55), Color3.fromRGB(200, 40, 60)),
	}
	if angry then
		specs = concat(specs, angryBrows(3.55, -1.5, 0.5, 0.6))
	end
	return specs
end

local function bomb(body: Color3, footColor: Color3, angry: boolean): { Spec }
	local specs = {
		P("Ball", Vector3.new(3, 3, 3), Vector3.new(0, 2, 0), body),
		P("Cylinder", Vector3.new(0.6, 0.6, 0.6), Vector3.new(0, 3.55, 0), Color3.fromRGB(160, 160, 160), { r = Vector3.new(0, 0, 90) }),
		P("Cylinder", Vector3.new(0.8, 0.15, 0.15), Vector3.new(0, 4.0, 0), Color3.fromRGB(230, 220, 190), { r = Vector3.new(0, 0, 90) }),
		P("Ball", Vector3.new(0.4, 0.4, 0.4), Vector3.new(0, 4.45, 0), Color3.fromRGB(255, 170, 40), { m = Enum.Material.Neon }),
		P("Block", Vector3.new(0.3, 1.2, 0.3), Vector3.new(0, 2.1, 1.6), GOLD),
		P("Block", Vector3.new(1.4, 0.7, 0.2), Vector3.new(0, 2.5, 1.8), GOLD),
	}
	return concat(specs, eyes(2.3, -1.3, 0.45, 0.5), feet(footColor, 0.7, 1.0), angry and angryBrows(2.9, -1.35, 0.45, 0.6) or {})
end

local function turtle(shell: Color3, skin: Color3, spikes: boolean): { Spec }
	local specs = {
		P("Ball", Vector3.new(3.2, 2.6, 3.4), Vector3.new(0, 2.0, 0.3), shell),
		P("Cylinder", Vector3.new(0.5, 3.4, 3.6), Vector3.new(0, 1.0, 0.3), WHITE, { r = Vector3.new(0, 0, 90) }),
		P("Ball", Vector3.new(1.7, 1.8, 1.7), Vector3.new(0, 3.1, -1.6), skin),
	}
	if spikes then
		for i = -1, 1 do
			table.insert(specs, P("Ball", Vector3.new(0.6, 0.9, 0.6), Vector3.new(i * 0.9, 3.25, 0.4), WHITE))
		end
	end
	return concat(specs, eyes(3.35, -2.35, 0.32, 0.45), feet(skin, 0.8, 0.9))
end

local designs: { [string]: () -> { Spec } } = {}

