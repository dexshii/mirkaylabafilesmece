designs.lavatitan = function()
	local rock = Color3.fromRGB(60, 45, 45)
	local lava = Color3.fromRGB(255, 90, 20)
	return {
		P("Ball", Vector3.new(3.4, 3.0, 2.8), Vector3.new(0, 2.8, 0), rock, { m = Enum.Material.Basalt }),
		P("Ball", Vector3.new(1.8, 1.7, 1.7), Vector3.new(0, 4.7, -0.3), rock, { m = Enum.Material.Basalt }),
		P("Ball", Vector3.new(1.2, 2.6, 1.2), Vector3.new(-2.1, 2.6, 0), rock, { m = Enum.Material.Basalt }),
		P("Ball", Vector3.new(1.2, 2.6, 1.2), Vector3.new(2.1, 2.6, 0), rock, { m = Enum.Material.Basalt }),
		P("Ball", Vector3.new(1.2, 1.6, 1.3), Vector3.new(-0.8, 0.8, 0), rock, { m = Enum.Material.Basalt }),
		P("Ball", Vector3.new(1.2, 1.6, 1.3), Vector3.new(0.8, 0.8, 0), rock, { m = Enum.Material.Basalt }),
		P("Block", Vector3.new(2.2, 0.25, 0.3), Vector3.new(0, 3.0, -1.35), lava, { m = Enum.Material.Neon, r = Vector3.new(0, 0, 25) }),
		P("Block", Vector3.new(1.6, 0.25, 0.3), Vector3.new(0.3, 2.2, -1.3), lava, { m = Enum.Material.Neon, r = Vector3.new(0, 0, -30) }),
		P("Ball", Vector3.new(0.45, 0.35, 0.2), Vector3.new(-0.4, 4.9, -1.1), lava, { m = Enum.Material.Neon }),
		P("Ball", Vector3.new(0.45, 0.35, 0.2), Vector3.new(0.4, 4.9, -1.1), lava, { m = Enum.Material.Neon }),
	}
end
designs.shadowmonarch = function()
	local armor = Color3.fromRGB(50, 30, 80)
	local glow = Color3.fromRGB(190, 80, 255)
	return {
		P("Block", Vector3.new(3.2, 0.4, 0.2), Vector3.new(0, 2.6, 1.1), Color3.fromRGB(120, 20, 40), { r = Vector3.new(-10, 0, 0) }),
		P("Block", Vector3.new(3.0, 3.6, 0.2), Vector3.new(0, 2.6, 1.15), Color3.fromRGB(120, 20, 40), { r = Vector3.new(-10, 0, 0) }),
		P("Block", Vector3.new(2.4, 2.6, 1.6), Vector3.new(0, 2.8, 0), armor, { m = Enum.Material.Metal }),
		P("Block", Vector3.new(0.8, 1.8, 0.9), Vector3.new(-0.6, 0.9, 0), armor, { m = Enum.Material.Metal }),
		P("Block", Vector3.new(0.8, 1.8, 0.9), Vector3.new(0.6, 0.9, 0), armor, { m = Enum.Material.Metal }),
		P("Ball", Vector3.new(1.2, 1.2, 1.2), Vector3.new(-1.6, 3.8, 0), armor, { m = Enum.Material.Metal }),
		P("Ball", Vector3.new(1.2, 1.2, 1.2), Vector3.new(1.6, 3.8, 0), armor, { m = Enum.Material.Metal }),
		P("Ball", Vector3.new(1.6, 1.7, 1.6), Vector3.new(0, 4.8, 0), armor, { m = Enum.Material.Metal }),
		P("Cylinder", Vector3.new(0.7, 1.7, 1.7), Vector3.new(0, 5.8, 0), Color3.fromRGB(140, 60, 220), { r = Vector3.new(0, 0, 90), m = Enum.Material.Metal }),
		P("Ball", Vector3.new(0.4, 0.25, 0.2), Vector3.new(-0.35, 4.9, -0.78), glow, { m = Enum.Material.Neon }),
		P("Ball", Vector3.new(0.4, 0.25, 0.2), Vector3.new(0.35, 4.9, -0.78), glow, { m = Enum.Material.Neon }),
		P("Block", Vector3.new(0.6, 0.6, 0.2), Vector3.new(0, 3.1, -0.85), glow, { m = Enum.Material.Neon, r = Vector3.new(0, 0, 45) }),
	}
end

function ModelFactory.has(key: string): boolean
	return designs[key] ~= nil
end

-- ============================================================ custom models
-- A Model in ReplicatedStorage.CustomModels named after a unit or enemy id (e.g. "captaincomet", "grumble")
-- replaces the built-in model: it is scaled to the unit's height, stood on its feet and welded to a Root. Models are
-- expected to face -Z (Roblox's front; a "FaceYaw" attribute in degrees turns one that doesn't). A "DisplayName"
-- attribute on it renames the unit or enemy in the UI. tools/sm64_import makes these from your own SM64 ROM.

local function customModel(key: string): Model?
	local folder = ReplicatedStorage:FindFirstChild("CustomModels")
	local m = folder and folder:FindFirstChild(key)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

-- the height a model is built at (scale 1)
function ModelFactory.height(key: string): number
	local unit = Units.ById[key]
	if unit then
		return unit.height
	end
	return 4.5
end

function ModelFactory.displayName(key: string, fallback: string): string
	local m = customModel(key)
	local name = m and m:GetAttribute("DisplayName")
	return type(name) == "string" and name ~= "" and name or fallback
end

local function buildCustom(source: Model, key: string, scale: number, anchored: boolean?): Model
	local model = source:Clone()
	model.Name = key
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid") or d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
	local _, size = model:GetBoundingBox()
	local target = ModelFactory.height(key) * scale
	if size.Y > 0 then
		model:ScaleTo(model:GetScale() * target / size.Y)
	end
	local cf, newSize = model:GetBoundingBox()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1) * scale
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(cf.Position.X, cf.Position.Y - newSize.Y / 2, cf.Position.Z)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.Massless = true
			if anchored then
				d.Anchored = true
			else
				d.Anchored = false
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	root.Parent = model
	model.PrimaryPart = root
	-- the model's origin is its feet, at the world origin like the built-in models. A "FaceYaw" attribute (degrees)
	-- turns a model that was imported facing the wrong way.
	local yaw = source:GetAttribute("FaceYaw")
	model:PivotTo(CFrame.Angles(0, math.rad(type(yaw) == "number" and yaw or 0), 0))
	return model
end

-- ============================================================ build

-- anchored = true anchors every part (viewports, previews); otherwise only Root is anchored and the rest is welded.
function ModelFactory.build(key: string, scale: number?, anchored: boolean?): Model
	local custom = customModel(key)
	if custom then
		return buildCustom(custom, key, scale or 1, anchored)
	end
	local design = designs[key] or designs.grumble
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = key

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1) * s
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	for i, spec in design() do
		local shape, size, pos, color, extras = spec[1], spec[2], spec[3], spec[4], spec[5]
		local part: BasePart
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			local p = Instance.new("Part")
			if shape == "Ball" then
				-- Ball parts are always perfect spheres; a sphere mesh stretches to the part's size (ellipsoids)
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = p
			elseif shape == "Cylinder" then
				p.Shape = Enum.PartType.Cylinder
			end
			part = p
		end
		part.Name = "P" .. i
		part.Size = size * s
		local rot = extras.r or Vector3.zero
		part.CFrame = CFrame.new(pos * s) * CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		part.Color = color
		part.Material = extras.m or Enum.Material.SmoothPlastic
		part.Transparency = extras.t or 0
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = s >= 1
		if anchored then
			part.Anchored = true
		else
			part.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
		part.Parent = model
	end
	return model
end

return ModelFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Remote names in one place. The server creates them (Net.setup); clients wait for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Functions = {
	"GetData",
	"Summon",
	"EquipUnit",
	"RollTrait",
	"ReleaseUnit",
	"StartBattle",
	"PlaceUnit",
	"UpgradeTower",
	"SellTower",
	"SetTargeting",
	"StartWave",
	"SetSpeed",
	"LeaveBattle",
}

Net.Events = {
	"DataChanged",
	"BattleState",
	"BattleEnded",
	"Fx",
	"Notify",
}

function Net.setup()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in Net.Functions do
		local f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	for _, name in Net.Events do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

function Net.fn(name: string): RemoteFunction
	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name) :: RemoteFunction
end

function Net.ev(name: string): RemoteEvent
	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[-- Per-unit progression that is kept on each owned unit:
--   level (1-50) from battle XP: +1.2% damage per level above 1
--   stat grades (C to SSS) for damage, attack speed (SPA) and range, rolled once when the unit is summoned
local Progression = {}

Progression.MaxLevel = 50

-- XP needed to go from `level` to `level + 1`
function Progression.xpToNext(level: number): number
	return 40 + level * 15
end

-- adds xp to a unit entry ({l, x}); returns how many levels it gained
function Progression.addXp(entry: { [string]: any }, xp: number): number
	local before = entry.l or 1
	entry.l = before
	entry.x = (entry.x or 0) + xp
	while entry.l < Progression.MaxLevel and entry.x >= Progression.xpToNext(entry.l) do
		entry.x -= Progression.xpToNext(entry.l)
		entry.l += 1
	end
	if entry.l >= Progression.MaxLevel then
		entry.x = 0
	end
	return entry.l - before
end

function Progression.levelDamage(level: number?): number
	return 1 + 0.012 * ((level or 1) - 1)
end

Progression.GradeOrder = { "C", "B", "A", "S", "SS", "SSS" }
-- chance weights when a unit is summoned
Progression.GradeWeights = { C = 22, B = 28, A = 24, S = 15, SS = 8, SSS = 3 }
-- multiplier on the stat (for SPA it divides the attack cooldown)
Progression.GradeMult = { C = 0.90, B = 0.95, A = 1.00, S = 1.05, SS = 1.10, SSS = 1.16 }
Progression.GradeColor = {
	C = Color3.fromRGB(170, 170, 170),
	B = Color3.fromRGB(90, 200, 90),
	A = Color3.fromRGB(80, 160, 255),
	S = Color3.fromRGB(190, 110, 255),
	SS = Color3.fromRGB(255, 120, 60),
	SSS = Color3.fromRGB(255, 210, 40),
}

function Progression.rollGrade(rng: Random): string
	local total = 0
	for _, g in Progression.GradeOrder do
		total += Progression.GradeWeights[g]
	end
	local roll = rng:NextNumber() * total
	for _, g in Progression.GradeOrder do
		roll -= Progression.GradeWeights[g]
		if roll < 0 then
			return g
		end
	end
	return "A"
end

function Progression.rollGrades(rng: Random): { d: string, s: string, r: string }
	return { d = Progression.rollGrade(rng), s = Progression.rollGrade(rng), r = Progression.rollGrade(rng) }
end

Progression.DefaultGrades = { d = "A", s = "A", r = "A" }

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarity tiers shared by summonable units and traits.
local Rarities = {}

Rarities.Order = { "Common", "Rare", "Legendary", "Mythic" }

Rarities.Info = {
	Common = { rank = 1, color = Color3.fromRGB(176, 186, 196), releaseGems = 5 },
	Rare = { rank = 2, color = Color3.fromRGB(70, 150, 255), releaseGems = 15 },
	Legendary = { rank = 3, color = Color3.fromRGB(255, 190, 40), releaseGems = 60 },
	Mythic = { rank = 4, color = Color3.fromRGB(255, 70, 150), releaseGems = 250 },
}

-- percent chances, must add up to 100
Rarities.SummonRates = { Common = 60, Rare = 30, Legendary = 8.5, Mythic = 1.5 }
Rarities.TraitRates = { Common = 55, Rare = 32, Legendary = 11, Mythic = 2 }

-- summons without a Legendary-or-better / Mythic before one is guaranteed
Rarities.LegendaryPity = 50
Rarities.MythicPity = 120

function Rarities.roll(rates: { [string]: number }, rng: Random): string
	local roll = rng:NextNumber() * 100
	local acc = 0
	for i = #Rarities.Order, 1, -1 do
		local name = Rarities.Order[i]
		acc += rates[name]
		if roll < acc then
			return name
		end
	end
	return "Common"
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[-- A placed unit's effective stats: its definition, upgrade level, trait and the auras around it.
local Units = require(script.Parent.Units)
local Traits = require(script.Parent.Traits)
local Progression = require(script.Parent.Progression)

local Stats = {}

export type Computed = {
	damage: number,
	range: number,
	cooldown: number,
	hitsGround: boolean,
	hitsAir: boolean,
	airMult: number,
	bossMult: number,
	cashMult: number,
	costMult: number,
	farm: number,
	slow: { pct: number, dur: number }?,
	burn: { dps: number, dur: number }?,
	stun: { chance: number, dur: number }?,
	chain: number,
}

-- level: the in-battle upgrade level (0-4)
-- buffs: { damage = fraction from auras, hitsAir = true when an aura grants it }
-- unit: the owned unit's progression { l = unit level, g = { d, s, r } stat grades }
function Stats.compute(unitId: string, level: number, traitId: string?, buffs: { [string]: any }?, unit: { [string]: any }?): Computed
	local def = Units.ById[unitId]
	local trait = traitId and Traits.ById[traitId]
	local t = trait and trait.fx or {}
	local b = buffs or {}
	local u = unit or {}
	local g = u.g or Progression.DefaultGrades
	local gm = Progression.GradeMult

	local damage = def.damage * (1 + 0.30 * level) * (1 + (t.damage or 0) + (b.damage or 0)) * Progression.levelDamage(u.l) * (gm[g.d] or 1)
	local range = def.range * (1 + 0.06 * level) * (1 + (t.range or 0)) * (gm[g.r] or 1)
	local cooldown = def.cooldown * (1 - 0.05 * level) / (1 + (t.speed or 0)) / (gm[g.s] or 1)

	local slow = def.attack.slow
	if t.slow and (not slow or t.slow.pct > slow.pct) then
		slow = t.slow
	end
	local burn = def.attack.burn
	if t.burn and (not burn or t.burn.dps > burn.dps) then
		burn = t.burn
	end
	local stun = def.attack.stun
	if t.stun and not stun then
		stun = t.stun
	end

	local attacks = def.attack.kind ~= "none"
	return {
		damage = damage,
		range = range,
		cooldown = cooldown,
		hitsGround = def.hitsGround,
		hitsAir = attacks and (def.hitsAir or t.hitsAir == true or b.hitsAir == true),
		airMult = def.attack.airMult or 1,
		bossMult = (def.attack.bossMult or 1) * (1 + (t.bossDamage or 0)),
		cashMult = 1 + (t.cash or 0),
		costMult = 1 - (t.cost or 0),
		farm = (def.farm or 0) * (1 + 0.5 * level) + (t.waveCash or 0),
		slow = slow,
		burn = burn,
		stun = stun,
		chain = (def.attack.chain or 0) + (t.chain or 0),
	}
end

function Stats.placeCost(unitId: string, traitId: string?): number
	local def = Units.ById[unitId]
	local trait = traitId and Traits.ById[traitId]
	local mult = 1 - (trait and trait.fx.cost or 0)
	return math.floor(def.cost * mult + 0.5)
end

function Stats.upgradeCost(unitId: string, level: number, traitId: string?): number
	local def = Units.ById[unitId]
	local trait = traitId and Traits.ById[traitId]
	local mult = 1 - (trait and trait.fx.cost or 0)
	return math.floor(Units.upgradeCost(def, level) * mult + 0.5)
end

-- distance from point (x, z) to the polyline of waypoints {{x, z}, ...}
function Stats.distanceToPath(waypoints: { { number } }, x: number, z: number): number
	local best = math.huge
	for i = 1, #waypoints - 1 do
		local ax, az = waypoints[i][1], waypoints[i][2]
		local bx, bz = waypoints[i + 1][1], waypoints[i + 1][2]
		local dx, dz = bx - ax, bz - az
		local len2 = dx * dx + dz * dz
		local t = 0
		if len2 > 0 then
			t = math.clamp(((x - ax) * dx + (z - az) * dz) / len2, 0, 1)
		end
		local px, pz = ax + dx * t - x, az + dz * t - z
		best = math.min(best, math.sqrt(px * px + pz * pz))
	end
	return best
end

-- the same placement rules the server enforces (positions local to the arena origin)
function Stats.placementProblem(
	waypoints: { { number } },
	half: number,
	pathWidth: number,
	x: number,
	z: number,
	others: { Vector3 }
): string?
	if math.abs(x) > half - 3 or math.abs(z) > half - 3 then
		return "Outside the map"
	end
	if Stats.distanceToPath(waypoints, x, z) < pathWidth / 2 + 2.5 then
		return "Too close to the path"
	end
	for _, p in others do
		local dx, dz = p.X - x, p.Z - z
		if dx * dx + dz * dz < 4.5 * 4.5 then
			return "Too close to another unit"
		end
	end
	return nil
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Traits</string>
          <string name="Source"><![CDATA[-- Traits are rolled onto a unit with Trait Crystals (earned from challenges). A unit holds one trait; rolling again
-- replaces it. Effect fields (all optional):
--   damage / speed / range: +fraction (speed = attack speed, so cooldown is divided by 1 + speed)
--   cost: fraction off placement and upgrade cost        cash: +fraction cash from this unit's kills
--   bossDamage: +fraction vs bosses                      hitsAir: can target flying enemies
--   slow = {pct, dur}   burn = {dps (fraction of hit damage per second), dur}   stun = {chance, dur}
--   chain: extra enemies each attack jumps to (at 60% damage)   waveCash: cash paid at the end of each wave
local Traits = {}

export type TraitDef = {
	id: string,
	name: string,
	rarity: string,
	desc: string,
	fx: { [string]: any },
}

local list: { TraitDef } = {
	-- Common
	{ id = "strong1", name = "Strong I", rarity = "Common", desc = "+8% damage", fx = { damage = 0.08 } },
	{ id = "quick1", name = "Quick I", rarity = "Common", desc = "+8% attack speed", fx = { speed = 0.08 } },
	{ id = "keen1", name = "Keen I", rarity = "Common", desc = "+8% range", fx = { range = 0.08 } },
	{ id = "thrifty", name = "Thrifty", rarity = "Common", desc = "-10% placement and upgrade cost", fx = { cost = 0.10 } },

	-- Rare
	{ id = "strong2", name = "Strong II", rarity = "Rare", desc = "+18% damage", fx = { damage = 0.18 } },
	{ id = "quick2", name = "Quick II", rarity = "Rare", desc = "+18% attack speed", fx = { speed = 0.18 } },
	{ id = "hawkeye", name = "Hawkeye", rarity = "Rare", desc = "+20% range and can hit flying enemies", fx = { range = 0.20, hitsAir = true } },
	{ id = "prospector", name = "Prospector", rarity = "Rare", desc = "+25% cash from this unit's kills", fx = { cash = 0.25 } },

	-- Legendary
	{ id = "titanslayer", name = "Titan Slayer", rarity = "Legendary", desc = "+60% damage to bosses", fx = { bossDamage = 0.60 } },
	{ id = "frostbite", name = "Frostbite", rarity = "Legendary", desc = "Attacks slow enemies by 25% for 1.5s", fx = { slow = { pct = 0.25, dur = 1.5 } } },
	{ id = "blazing", name = "Blazing", rarity = "Legendary", desc = "Attacks burn for 3s (30% of hit damage per second)", fx = { burn = { dps = 0.30, dur = 3 } } },
	{ id = "overclock", name = "Overclock", rarity = "Legendary", desc = "+30% attack speed and +10% damage", fx = { speed = 0.30, damage = 0.10 } },

	-- Mythic
	{
		id = "superstar",
		name = "Superstar",
		rarity = "Mythic",
		desc = "+50% damage, +25% attack speed, +15% range",
		fx = { damage = 0.50, speed = 0.25, range = 0.15 },
	},
	{ id = "chainreaction", name = "Chain Reaction", rarity = "Mythic", desc = "Every attack chains to 2 more enemies", fx = { chain = 2 } },
	{ id = "midas", name = "Midas Touch", rarity = "Mythic", desc = "+100% cash from kills and +100 cash every wave", fx = { cash = 1.0, waveCash = 100 } },
	{
		id = "timestop",
		name = "Time Stop",
		rarity = "Mythic",
		desc = "+20% damage, 12% chance per hit to stun for 1.5s",
		fx = { damage = 0.20, stun = { chance = 0.12, dur = 1.5 } },
	},
}

Traits.List = list
Traits.ById = {} :: { [string]: TraitDef }
Traits.ByRarity = {} :: { [string]: { TraitDef } }
for _, def in list do
	Traits.ById[def.id] = def
	Traits.ByRarity[def.rarity] = Traits.ByRarity[def.rarity] or {}
	table.insert(Traits.ByRarity[def.rarity], def)
end

Traits.RollCost = 1 -- trait crystals per roll

return Traits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Units</string>
          <string name="Source"><![CDATA[-- Summonable units. Every number here is the level-0 (just placed) value; upgrades scale it (see Stats).
--   attack.kind: "single" one target, "splash" hits around the target, "slam" hits everything around the unit,
--                "cone" a fire cone toward the target, "chain" jumps between enemies, "none" (farms/support)
--   hitsGround / hitsAir: which enemy layers it can target (bosses are on the layer of their kind)
local Units = {}

export type UnitDef = {
	id: string,
	name: string,
	rarity: string,
	role: string,
	desc: string,
	cost: number,
	limit: number,
	damage: number,
	range: number,
	cooldown: number,
	hitsGround: boolean,
	hitsAir: boolean,
	attack: { [string]: any },
	farm: number?,
	aura: { [string]: any }?,
	fx: { [string]: any },
	height: number,
}

local list: { UnitDef } = {
	-- ===== Common =====
	{
		id = "mushling",
		name = "Mushling",
		rarity = "Common",
		role = "Ground melee",
		desc = "A brave little mushroom that bonks anything walking by.",
		cost = 180,
		limit = 6,
		damage = 11,
		range = 11,
		cooldown = 0.9,
		hitsGround = true,
		hitsAir = false,
		attack = { kind = "single" },
		fx = { style = "bonk", color = Color3.fromRGB(150, 90, 50) },
		height = 3.4,
	},
	{
		id = "fusebuddy",
		name = "Fuse Buddy",
		rarity = "Common",
		role = "Ground splash",
		desc = "A walking bomb with a big heart. Explodes on groups (and comes right back).",
		cost = 320,
		limit = 5,
		damage = 24,
		range = 15,
		cooldown = 2.2,
		hitsGround = true,
		hitsAir = false,
		attack = { kind = "splash", radius = 6 },
		fx = { style = "lob", color = Color3.fromRGB(255, 140, 40) },
		height = 3.6,
	},
	{
		id = "shellback",
		name = "Shellback",
		rarity = "Common",
		role = "Ground + air shooter",
		desc = "A turtle that flings shells at anything, on the ground or in the sky.",
		cost = 280,
		limit = 6,
		damage = 10,
		range = 17,
		cooldown = 0.8,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "single" },
		fx = { style = "bolt", color = Color3.fromRGB(80, 200, 90) },
		height = 3.8,
	},
	{
		id = "buzzwing",
		name = "Buzzwing",
		rarity = "Common",
		role = "Anti-air",
		desc = "A propeller bug that hunts flyers. Double damage to flying enemies.",
		cost = 240,
		limit = 6,
		damage = 7,
		range = 19,
		cooldown = 0.7,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "single", airMult = 2 },
		fx = { style = "bolt", color = Color3.fromRGB(255, 230, 80) },
		height = 4.4,
	},

	-- ===== Rare =====
	{
		id = "spooky",
		name = "Spooky",
		rarity = "Rare",
		role = "Slow support",
		desc = "A shy ghost whose chill slows enemies by 35%.",
		cost = 420,
		limit = 4,
		damage = 20,
		range = 16,
		cooldown = 1.0,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "single", slow = { pct = 0.35, dur = 2 } },
		fx = { style = "bolt", color = Color3.fromRGB(200, 220, 255) },
		height = 4.2,
	},
	{
		id = "cloudrider",
		name = "Cloud Rider",
		rarity = "Rare",
		role = "Air + ground splash",
		desc = "Rides a cloud and drops spiky eggs on everything below.",
		cost = 520,
		limit = 4,
		damage = 34,
		range = 18,
		cooldown = 1.6,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "splash", radius = 5 },
		fx = { style = "lob", color = Color3.fromRGB(230, 60, 60) },
		height = 6,
	},
	{
		id = "shroombanker",
		name = "Shroom Banker",
		rarity = "Rare",
		role = "Farm",
		desc = "Does not fight. Pays out cash at the end of every wave.",
		cost = 600,
		limit = 3,
		damage = 0,
		range = 0,
		cooldown = 1,
		hitsGround = false,
		hitsAir = false,
		attack = { kind = "none" },
		farm = 120,
		fx = { style = "none", color = Color3.fromRGB(255, 215, 0) },
		height = 3.8,
	},
	{
		id = "flamebloom",
		name = "Flame Bloom",
		rarity = "Rare",
		role = "Burn",
		desc = "A hungry fire plant. Its fireballs keep burning for 3 seconds.",
		cost = 480,
		limit = 4,
		damage = 22,
		range = 15,
		cooldown = 1.1,
		hitsGround = true,
		hitsAir = false,
		attack = { kind = "single", burn = { dps = 0.45, dur = 3 } },
		fx = { style = "bolt", color = Color3.fromRGB(255, 100, 20) },
		height = 4.6,
	},

	-- ===== Legendary =====
	{
		id = "stoneslammer",
		name = "Stone Slammer",
		rarity = "Legendary",
		role = "Ground AoE stun",
		desc = "A living stone wall. Slams the ground, hitting and stunning everything around it.",
		cost = 900,
		limit = 3,
		damage = 80,
		range = 12,
		cooldown = 2.2,
		hitsGround = true,
		hitsAir = false,
		attack = { kind = "slam", stun = { chance = 1, dur = 0.6 } },
		fx = { style = "slam", color = Color3.fromRGB(170, 170, 180) },
		height = 7,
	},
	{
		id = "chainchomper",
		name = "Chain Chomper",
		rarity = "Legendary",
		role = "Boss hunter",
		desc = "An iron ball with teeth. Huge single-target bites, triple damage to bosses.",
		cost = 950,
		limit = 3,
		damage = 110,
		range = 13,
		cooldown = 1.4,
		hitsGround = true,
		hitsAir = false,
		attack = { kind = "single", bossMult = 3 },
		fx = { style = "bonk", color = Color3.fromRGB(40, 40, 50) },
		height = 5.2,
	},
	{
		id = "starsage",
		name = "Star Sage",
		rarity = "Legendary",
		role = "Support aura",
		desc = "A wise owl. Units near it deal +25% damage and can see flying enemies.",
		cost = 800,
		limit = 2,
		damage = 30,
		range = 20,
		cooldown = 1.0,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "single" },
		aura = { range = 18, damage = 0.25, grantsAir = true },
		fx = { style = "bolt", color = Color3.fromRGB(140, 120, 255) },
		height = 5,
	},

	-- ===== Mythic =====
	{
		id = "captaincomet",
		name = "Captain Comet",
		rarity = "Mythic",
		role = "Chain lightning hero",
		desc = "The kingdom's star hero. Lightning jumps between up to 4 enemies, ground or air.",
		cost = 1400,
		limit = 2,
		damage = 55,
		range = 22,
		cooldown = 0.9,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "chain", chain = 3, falloff = 0.75 },
		fx = { style = "zap", color = Color3.fromRGB(120, 220, 255) },
		height = 5.4,
	},
	{
		id = "infernodrake",
		name = "Inferno Drake",
		rarity = "Mythic",
		role = "Fire breath",
		desc = "The fire-breathing turtle-dragon king, now on your side. Burns everything in a wide cone.",
		cost = 1600,
		limit = 1,
		damage = 42,
		range = 18,
		cooldown = 0.8,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "cone", angle = 40, burn = { dps = 0.5, dur = 3 } },
		fx = { style = "cone", color = Color3.fromRGB(255, 80, 10) },
		height = 8,
	},
	{
		id = "starprincess",
		name = "Starlight Princess",
		rarity = "Mythic",
		role = "Global support",
		desc = "Every unit on the map deals +15% damage. Pays cash each wave and fires star beams.",
		cost = 1300,
		limit = 1,
		damage = 36,
		range = 20,
		cooldown = 0.8,
		hitsGround = true,
		hitsAir = true,
		attack = { kind = "single" },
		farm = 150,
		aura = { range = 9999, damage = 0.15 },
		fx = { style = "zap", color = Color3.fromRGB(255, 160, 220) },
		height = 6,
	},
}

Units.List = list
Units.ById = {} :: { [string]: UnitDef }
Units.ByRarity = {} :: { [string]: { UnitDef } }
for _, def in list do
	Units.ById[def.id] = def
	Units.ByRarity[def.rarity] = Units.ByRarity[def.rarity] or {}
	table.insert(Units.ByRarity[def.rarity], def)
end

Units.MaxLevel = 4
Units.TeamSize = 6
Units.InventoryLimit = 150

-- cost of upgrading from `level` to `level + 1`
function Units.upgradeCost(def: UnitDef, level: number): number
	return math.floor(def.cost * (0.55 + 0.35 * (level + 1)) / 5 + 0.5) * 5
end

return Units
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Battle</string>
          <string name="Source"><![CDATA[-- One player's battle: the map, the waves, the enemies walking the path, and the units the player placed.
-- The simulation runs on the server (scaled by the 1x/2x/3x speed); the client only draws the attack effects it is
-- sent and the UI.
local RunService = game:GetService("RunService")

local Shared = game.ReplicatedStorage.Shared
local Maps = require(Shared.Maps)
local Units = require(Shared.Units)
local Enemies = require(Shared.Enemies)
local Stats = require(Shared.Stats)
local Rarities = require(Shared.Rarities)
local ModelFactory = require(Shared.ModelFactory)
local Net = require(Shared.Net)
local MapBuilder = require(script.Parent.MapBuilder)

local Battle = {}
Battle.__index = Battle

local PREP_SECONDS = 20
-- the next wave arrives after this many seconds even if enemies are still alive (plus the wave's spawn time)
local WAVE_SECONDS = 22
local BOSS_EXTRA_SECONDS = 25
-- once the field is clear the next wave comes after at most this long
local CLEAR_SECONDS = 3
local STATE_INTERVAL = 0.2
local CHAIN_JUMP = 14
local TARGETING = { "First", "Last", "Strongest", "Closest" }

local fxEvent: RemoteEvent
local stateEvent: RemoteEvent

function Battle.init()
	fxEvent = Net.ev("Fx")
	stateEvent = Net.ev("BattleState")
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- opts: { mapId, stage, challenge = ChallengeDef?, team = { {uid, unitId, trait} } , slot, onEnd(battle, won) }
function Battle.new(player: Player, opts: { [string]: any })
	local self = setmetatable({}, Battle)
	self.player = player
	self.mapDef = Maps.ById[opts.mapId]
	self.stage = opts.stage
	self.challenge = opts.challenge
	self.mods = opts.challenge and opts.challenge.modifiers or {}
	self.team = opts.team
	self.onEnd = opts.onEnd
	self.slot = opts.slot
	-- arenas are far apart: each map has scenery reaching 550 studs out
	self.origin = Vector3.new(1200 * opts.slot, 0, 1200)

	self.arena, self.points = MapBuilder.build(self.mapDef, self.origin, opts.slot * 7919 + Maps.Index[opts.mapId])
	self.segLen = {}
	self.totalLen = 0
	for i = 1, #self.points - 1 do
		local len = (self.points[i + 1] - self.points[i]).Magnitude
		self.segLen[i] = len
		self.totalLen += len
	end

	self.enemyFolder = Instance.new("Folder")
	self.enemyFolder.Name = "Enemies"
	self.enemyFolder.Parent = self.arena
	self.towerFolder = Instance.new("Folder")
	self.towerFolder.Name = "Units"
	self.towerFolder.Parent = self.arena

	self.waves = Maps.buildWaves(self.mapDef, self.stage, self.mods)
	self.waveIndex = 0
	self.state = "prep"
	self.timer = PREP_SECONDS
	self.time = 0
	self.speed = 1
	-- later maps open harder, so they start with more cash
	self.cash = math.floor((Maps.StartCash + Maps.StartCashPerMap * (Maps.Index[opts.mapId] - 1)) * (self.mods.startCash or 1))
	self.baseHp = Maps.BaseHealth
	self.enemies = {}
	self.spawners = {}
	self.towers = {}
	self.nextId = 1
	self.stateClock = 0
	self.kills = 0

	self.conn = RunService.Heartbeat:Connect(function(dt)
		self:step(math.min(dt, 0.1) * self.speed)
		self.stateClock += dt
		if self.stateClock >= STATE_INTERVAL then
			self.stateClock = 0
			self:sendState()
		end
	end)
	self:sendState()
	return self
end

-- ============================================================ path

function Battle:posAt(dist: number): (Vector3, Vector3)
	local d = math.clamp(dist, 0, self.totalLen)
	for i = 1, #self.segLen do
		local len = self.segLen[i]
		if d <= len or i == #self.segLen then
			local a, b = self.points[i], self.points[i + 1]
			local dir = (b - a).Unit
			return a + dir * math.min(d, len), dir
		end
		d -= len
	end
	return self.points[#self.points], Vector3.new(0, 0, -1)
end

-- ============================================================ enemies

local function healthBar(model: Model, height: number, boss: boolean, name: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Health"
	gui.Size = boss and UDim2.fromOffset(160, 26) or UDim2.fromOffset(60, 8)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 1, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 220
	gui.Adornee = model.PrimaryPart
	local back = Instance.new("Frame")
	back.Size = boss and UDim2.new(1, 0, 0, 10) or UDim2.fromScale(1, 1)
	back.Position = boss and UDim2.new(0, 0, 1, -10) or UDim2.new()
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = boss and Color3.fromRGB(200, 60, 255) or Color3.fromRGB(80, 220, 80)
	fill.BorderSizePixel = 0
	fill.Parent = back
	if boss then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 16)
		label.BackgroundTransparency = 1
		label.Text = name
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.TextScaled = true
		label.Parent = gui
	end
	gui.Parent = model
	return fill
end

function Battle:spawnEnemy(enemyId: string, hpMult: number, bossMult: number, dist: number)
	local def = Enemies.ById[enemyId]
	local scale = def.scale or 1
	local mult = def.boss and bossMult or hpMult
	local hp = def.hp * mult * (self.mods.enemyHp or 1)
	local model = ModelFactory.build(enemyId, scale)
	local fill = healthBar(model, 4.5 * scale, def.boss == true, def.name)
	local pos, dir = self:posAt(dist)
	model:PivotTo(CFrame.lookAt(pos, pos + dir))
	model.Parent = self.enemyFolder
	local enemy = {
		id = self.nextId,
		def = def,
		hp = hp,
		maxHp = hp,
		dist = dist,
		pos = pos,
		model = model,
		root = model.PrimaryPart,
		fill = fill,
		lastFrac = 1,
		flying = def.kind == "flying",
		alive = true,
		slowPct = 0,
		slowUntil = 0,
		stunUntil = 0,
		burnDps = 0,
		burnUntil = 0,
		burnSource = nil,
		immuneUntil = 0,
		dashUntil = 0,
		abilityTimer = def.ability and def.ability.every or 0,
		phase = math.random() * 6,
		-- tougher enemies on later maps and waves pay more, so the economy keeps up
		cashMult = math.sqrt(mult),
	}
	self.nextId += 1
	table.insert(self.enemies, enemy)
	return enemy
end

function Battle:removeEnemy(enemy)
	enemy.alive = false
	if enemy.model then
		enemy.model:Destroy()
		enemy.model = nil
	end
end

function Battle:kill(enemy, tower)
	if not enemy.alive then
		return
	end
	self.kills += 1
	local mult = (self.mods.killCash or 1) * (tower and tower.stats.cashMult or 1)
	self.cash += math.floor(enemy.def.cash * enemy.cashMult * mult + 0.5)
	if enemy.def.splitInto then
		local wave = self.waves[math.max(self.waveIndex, 1)]
		for i = 1, 2 do
			local child = self:spawnEnemy(enemy.def.splitInto, wave.hpMult, wave.bossMult, math.max(0, enemy.dist - i * 2))
			child.pos = enemy.pos
		end
	end
	self:fx({ style = "pop", to = enemy.pos + Vector3.new(0, enemy.flying and Enemies.FlyHeight or 2, 0), color = Color3.fromRGB(255, 220, 80), boss = enemy.def.boss })
	self:removeEnemy(enemy)
end

function Battle:damage(enemy, amount: number, tower, applyEffects: boolean): number
	if not enemy.alive then
		return 0
	end
	if self.time < enemy.immuneUntil then
		return 0
	end
	local s = tower and tower.stats
	local d = amount
	if s then
		if enemy.flying then
			d *= s.airMult
		end
		if enemy.def.boss then
			d *= s.bossMult
		end
	end
	d *= 1 - (enemy.def.armor or 0)
	enemy.hp -= d
	enemy.lastHitBy = tower

	if applyEffects and s then
		if s.slow then
			local pct = enemy.def.boss and s.slow.pct * 0.5 or s.slow.pct
			if pct >= enemy.slowPct or self.time >= enemy.slowUntil then
				enemy.slowPct = pct
			end
			enemy.slowUntil = math.max(enemy.slowUntil, self.time + s.slow.dur)
		end
		if s.burn then
			enemy.burnDps = math.max(self.time < enemy.burnUntil and enemy.burnDps or 0, amount * s.burn.dps)
			enemy.burnUntil = self.time + s.burn.dur
			enemy.burnSource = tower
		end
		if s.stun and not enemy.def.boss and math.random() < s.stun.chance then
			enemy.stunUntil = math.max(enemy.stunUntil, self.time + s.stun.dur)
		end
	end

	if enemy.hp <= 0 then
		self:kill(enemy, tower)
	end
	return d
end

function Battle:useAbility(enemy)
	local ab = enemy.def.ability
	local at = enemy.pos + Vector3.new(0, 2, 0)
	if ab.type == "summon" or ab.type == "monarch" then
		local wave = self.waves[math.max(self.waveIndex, 1)]
		for i = 1, ab.count do
			self:spawnEnemy(ab.enemy, wave.hpMult, wave.bossMult, math.max(0, enemy.dist - 2 - i * 2))
		end
		self:fx({ style = "summon", to = at, color = Color3.fromRGB(170, 80, 255), radius = 8 })
	end
	if ab.type == "stun" or ab.type == "monarch" then
		for _, tower in self.towers do
			if flatDist(tower.pos, enemy.pos) <= ab.radius then
				tower.stunUntil = math.max(tower.stunUntil, self.time + ab.dur)
			end
		end
		self:fx({ style = "shock", to = at, color = Color3.fromRGB(140, 220, 255), radius = ab.radius })
	end
	if ab.type == "dash" then
		enemy.dashUntil = self.time + ab.dur
		self:fx({ style = "summon", to = at, color = Color3.fromRGB(255, 200, 80), radius = 6 })
	end
	if ab.type == "shield" then
		enemy.immuneUntil = self.time + ab.dur
		enemy.hp = math.min(enemy.maxHp, enemy.hp + enemy.maxHp * ab.heal)
		self:fx({ style = "shield", to = at, color = Color3.fromRGB(255, 120, 30), radius = 7 * (enemy.def.scale or 1) / 2, dur = ab.dur / self.speed })
	end
end

function Battle:moveEnemies(dt: number)
	local parts, cframes = {}, {}
	local speedMod = self.mods.enemySpeed or 1
	for _, e in self.enemies do
		if not e.alive then
			continue
		end
		if e.def.ability then
			e.abilityTimer -= dt
			if e.abilityTimer <= 0 then
				e.abilityTimer = e.def.ability.every
				self:useAbility(e)
			end
		end
		if self.time < e.burnUntil then
			self:damage(e, e.burnDps * dt, e.burnSource, false)
			if not e.alive then
				continue
			end
		end
		local speed = e.def.speed * speedMod
		if self.time < e.slowUntil then
			speed *= 1 - e.slowPct
		end
		if self.time < e.dashUntil then
			speed *= e.def.ability.mult
		end
		if self.time < e.stunUntil then
			speed = 0
		end
		e.dist += speed * dt
		if e.dist >= self.totalLen then
			self.baseHp -= e.def.leak
			self:fx({ style = "leak", to = self.points[#self.points] + Vector3.new(0, 4, 0), color = Color3.fromRGB(255, 60, 60) })
			self:removeEnemy(e)
			continue
		end
		local pos, dir = self:posAt(e.dist)
		e.pos = pos
		local bob = math.abs(math.sin(self.time * 8 + e.phase)) * 0.4
		local height = e.flying and (Enemies.FlyHeight + math.sin(self.time * 2 + e.phase)) or bob
		local cf = CFrame.lookAt(pos, pos + dir) + Vector3.new(0, height, 0)
		table.insert(parts, e.root)
		table.insert(cframes, cf)

		local frac = math.clamp(e.hp / e.maxHp, 0, 1)
		if math.abs(frac - e.lastFrac) > 0.01 then
			e.lastFrac = frac
			e.fill.Size = UDim2.fromScale(frac, 1)
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- drop removed enemies
	local alive = {}
	for _, e in self.enemies do
		if e.alive then
			table.insert(alive, e)
		end
	end
	self.enemies = alive

	if self.baseHp <= 0 then
		self.baseHp = 0
		self:finish(false)
	end
end

-- ============================================================ towers

function Battle:canHit(tower, enemy): boolean
	if enemy.flying then
		return tower.stats.hitsAir
	end
	return tower.stats.hitsGround
end

function Battle:pickTarget(tower)
	local best, bestScore = nil, -math.huge
	local range = tower.stats.range
	for _, e in self.enemies do
		if e.alive and self:canHit(tower, e) then
			local d = flatDist(tower.pos, e.pos)
			if d <= range then
				local score
				if tower.targeting == "Last" then
					score = -e.dist
				elseif tower.targeting == "Strongest" then
					score = e.hp
				elseif tower.targeting == "Closest" then
					score = -d
				else
					score = e.dist
				end
				if score > bestScore then
					best, bestScore = e, score
				end
			end
		end
	end
	return best
end

local function aimPoint(enemy): Vector3
	local h = enemy.flying and Enemies.FlyHeight + 1 or 2 * (enemy.def.scale or 1)
	return enemy.pos + Vector3.new(0, h, 0)
end

function Battle:chainFrom(tower, first, count: number, damage: number, falloff: number, hit: { [any]: boolean }, points: { Vector3 })
	local current = first
	local dmg = damage
	for _ = 1, count do
		local nextE, nextD = nil, CHAIN_JUMP
		for _, e in self.enemies do
			if e.alive and not hit[e] and self:canHit(tower, e) then
				local d = flatDist(current.pos, e.pos)
				if d <= nextD then
					nextE, nextD = e, d
				end
			end
		end
		if not nextE then
			break
		end
		dmg *= falloff
		hit[nextE] = true
		table.insert(points, aimPoint(nextE))
		self:damage(nextE, dmg, tower, true)
		current = nextE
	end
end

function Battle:attack(tower, target)
	local s = tower.stats
	local def = tower.def
	local kind = def.attack.kind
	local top = tower.pos + Vector3.new(0, def.height * 0.7, 0)
	local targetPoint = aimPoint(target)
	local hit = {}
	local chainPoints = { targetPoint }
	local radius

	-- turn to face the target
	tower.model:PivotTo(CFrame.lookAt(tower.pos, Vector3.new(target.pos.X, tower.pos.Y, target.pos.Z)))

	local dealt = 0
	if kind == "single" then
		hit[target] = true
		dealt = self:damage(target, s.damage, tower, true)
	elseif kind == "splash" then
		radius = def.attack.radius
		local center = target.pos
		for _, e in self.enemies do
			if e.alive and self:canHit(tower, e) and flatDist(e.pos, center) <= radius then
				hit[e] = true
				local d = self:damage(e, s.damage, tower, true)
				if e == target then
					dealt = d
				end
			end
		end
	elseif kind == "slam" then
		radius = s.range
		for _, e in self.enemies do
			if e.alive and self:canHit(tower, e) and flatDist(e.pos, tower.pos) <= s.range then
				hit[e] = true
				local d = self:damage(e, s.damage, tower, true)
				if e == target then
					dealt = d
				end
			end
		end
	elseif kind == "cone" then
		radius = s.range
		local aim = Vector3.new(target.pos.X - tower.pos.X, 0, target.pos.Z - tower.pos.Z).Unit
		local cosLimit = math.cos(math.rad(def.attack.angle))
		for _, e in self.enemies do
			if e.alive and self:canHit(tower, e) then
				local off = Vector3.new(e.pos.X - tower.pos.X, 0, e.pos.Z - tower.pos.Z)
				local d = off.Magnitude
				if d <= s.range and (d < 1 or off.Unit:Dot(aim) >= cosLimit) then
					hit[e] = true
					local dd = self:damage(e, s.damage, tower, true)
					if e == target then
						dealt = dd
					end
				end
			end
		end
	elseif kind == "chain" then
		hit[target] = true
		dealt = self:damage(target, s.damage, tower, true)
		self:chainFrom(tower, target, s.chain, s.damage, def.attack.falloff or 0.75, hit, chainPoints)
	end

	-- the Chain Reaction trait on units that do not already chain
	if kind ~= "chain" and s.chain > 0 then
		self:chainFrom(tower, target, s.chain, s.damage, 0.6, hit, chainPoints)
	end

	self:fx({
		style = def.fx.style,
		color = def.fx.color,
		from = top,
		to = targetPoint,
		radius = radius,
		ground = tower.pos,
		chain = #chainPoints > 1 and chainPoints or nil,
		tower = tower.id,
		dmg = dealt > 0 and math.floor(dealt + 0.5) or nil,
	})
end

function Battle:updateTowers(dt: number)
	for _, tower in self.towers do
		if self.time < tower.stunUntil then
			continue
		end
		if tower.def.attack.kind == "none" then
			continue
		end
		tower.cooldownLeft -= dt
		if tower.cooldownLeft <= 0 then
			local target = self:pickTarget(tower)
			if target then
				self:attack(tower, target)
				tower.cooldownLeft += tower.stats.cooldown
				if tower.cooldownLeft < 0 then
					tower.cooldownLeft = 0
				end
			else
				tower.cooldownLeft = 0
			end
		end
	end
end

-- auras: Star Sage (+damage, sees flyers) and Starlight Princess (+damage to every unit)
function Battle:recalcTowers()
	for _, tower in self.towers do
		local buffs = { damage = 0, hitsAir = false }
		for _, other in self.towers do
			local aura = other.def.aura
			if other ~= tower and aura and flatDist(other.pos, tower.pos) <= aura.range then
				buffs.damage += aura.damage
				if aura.grantsAir then
					buffs.hitsAir = true
				end
			end
		end
		tower.stats = Stats.compute(tower.unitId, tower.level, tower.trait, buffs, tower.unit)
		tower.model:SetAttribute("Level", tower.level)
		tower.model:SetAttribute("Targeting", tower.targeting)
		tower.model:SetAttribute("Spent", tower.spent)
		tower.model:SetAttribute("DamageBuff", buffs.damage)
		tower.model:SetAttribute("AirBuff", buffs.hitsAir)
		if tower.badge then
			tower.badge.Text = string.rep("★", tower.level)
		end
	end
end

-- ============================================================ player actions

local function rarityOk(self, unitId: string): boolean
	local only = self.mods.onlyRarity
	return not only or Units.ById[unitId].rarity == only
end

function Battle:towerCount(unitId: string?): number
	local n = 0
	for _, t in self.towers do
		if not unitId or t.unitId == unitId then
			n += 1
		end
	end
	return n
end

function Battle:place(slot: number, position: Vector3): (boolean, string?)
	if self.state == "won" or self.state == "lost" then
		return false, "The battle is over"
	end
	local member = self.team[slot]
	if not member then
		return false, "No unit in that slot"
	end
	local def = Units.ById[member.unitId]
	if not rarityOk(self, member.unitId) then
		return false, "Only " .. self.mods.onlyRarity .. " units are allowed in this challenge"
	end
	if def.limit and self:towerCount(member.unitId) >= def.limit then
		return false, def.name .. " limit reached (" .. def.limit .. ")"
	end
	if self.mods.maxUnits and self:towerCount() >= self.mods.maxUnits then
		return false, "Unit limit reached (" .. self.mods.maxUnits .. ")"
	end
	local cost = Stats.placeCost(member.unitId, member.trait)
	if self.cash < cost then
		return false, "Not enough cash"
	end
	local x, z = position.X - self.origin.X, position.Z - self.origin.Z
	local others = {}
	for _, t in self.towers do
		table.insert(others, t.pos - self.origin)
	end
	local problem = Stats.placementProblem(self.mapDef.waypoints, Maps.FieldHalf, Maps.PathWidth, x, z, others)
	if problem then
		return false, problem
	end

	self.cash -= cost
	local pos = self.origin + Vector3.new(x, 0, z)
	local model = ModelFactory.build(member.unitId)
	-- face the nearest point of the path
	local closest, closestD = pos + Vector3.new(0, 0, -1), math.huge
	for _, p in self.points do
		local d = flatDist(p, pos)
		if d < closestD then
			closest, closestD = p, d
		end
	end
	model:PivotTo(CFrame.lookAt(pos, Vector3.new(closest.X, pos.Y, closest.Z)))
	local id = self.nextId
	self.nextId += 1
	model.Name = "Unit_" .. id
	model:SetAttribute("TowerId", id)
	model:SetAttribute("UnitId", member.unitId)
	model:SetAttribute("Trait", member.trait or "")
	model:SetAttribute("UnitLevel", member.level or 1)
	model:SetAttribute("Grades", (member.grades.d or "A") .. "," .. (member.grades.s or "A") .. "," .. (member.grades.r or "A"))
	model:SetAttribute("Owner", self.player.UserId)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Badge"
	gui.Size = UDim2.fromOffset(80, 22)
	gui.StudsOffsetWorldSpace = Vector3.new(0, def.height + 1.2, 0)
	gui.MaxDistance = 120
	gui.Adornee = model.PrimaryPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Rarities.Info[def.rarity].color
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = gui
	gui.Parent = model

	-- a rarity-coloured ring under the unit
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 4.5, 4.5)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = Rarities.Info[def.rarity].color
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.4
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Parent = model

	-- a cartoon outline, coloured for Legendary and Mythic units, and a sparkle aura on those
	local rank = Rarities.Info[def.rarity].rank
	local outline = Instance.new("Highlight")
	outline.FillTransparency = 1
	outline.OutlineTransparency = 0
	outline.OutlineColor = rank >= 3 and Rarities.Info[def.rarity].color or Color3.fromRGB(20, 15, 30)
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Parent = model
	if rank >= 3 then
		local aura = Instance.new("ParticleEmitter")
		aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		aura.Color = ColorSequence.new(Rarities.Info[def.rarity].color)
		aura.LightEmission = 1
		aura.Rate = rank >= 4 and 14 or 7
		aura.Lifetime = NumberRange.new(0.8, 1.4)
		aura.Speed = NumberRange.new(1.5, 3)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Size = NumberSequence.new(0.6, 0)
		aura.Parent = model.PrimaryPart
		local glow = Instance.new("PointLight")
		glow.Color = Rarities.Info[def.rarity].color
		glow.Range = 10
		glow.Brightness = 1.2
		glow.Parent = model.PrimaryPart
	end

	model.Parent = self.towerFolder

	local tower = {
		id = id,
		uid = member.uid,
		unitId = member.unitId,
		def = def,
		trait = member.trait,
		unit = { l = member.level, g = member.grades },
		level = 0,
		pos = pos,
		model = model,
		badge = label,
		cooldownLeft = 0,
		targeting = "First",
		spent = cost,
		stunUntil = 0,
		stats = nil,
	}
	self.towers[id] = tower
	self:recalcTowers()
	self:fx({ style = "placed", to = pos + Vector3.new(0, 1, 0), color = Rarities.Info[def.rarity].color, radius = 3 })
	self:sendState()
	return true, nil
end

function Battle:upgrade(id: number): (boolean, string?)
	local tower = self.towers[id]
	if not tower then
		return false, "Unit not found"
	end
	if tower.level >= Units.MaxLevel then
		return false, "Already max level"
	end
	local cost = Stats.upgradeCost(tower.unitId, tower.level, tower.trait)
	if self.cash < cost then
		return false, "Not enough cash"
	end
	self.cash -= cost
	tower.level += 1
	tower.spent += cost
	self:recalcTowers()
	self:fx({ style = "placed", to = tower.pos + Vector3.new(0, 1, 0), color = Color3.fromRGB(255, 230, 80), radius = 4 })
	self:sendState()
	return true, nil
end

function Battle:sell(id: number): (boolean, string?)
	local tower = self.towers[id]
	if not tower then
		return false, "Unit not found"
	end
	self.cash += math.floor(tower.spent * 0.6)
	tower.model:Destroy()
	self.towers[id] = nil
	for _, e in self.enemies do
		if e.burnSource == tower then
			e.burnSource = nil
		end
	end
	self:recalcTowers()
	self:sendState()
	return true, nil
end

function Battle:setTargeting(id: number, mode: string): (boolean, string?)
	local tower = self.towers[id]
	if not tower or not table.find(TARGETING, mode) then
		return false, "Invalid"
	end
	tower.targeting = mode
	tower.model:SetAttribute("Targeting", mode)
	return true, nil
end

function Battle:setSpeed(speed: number)
	if speed == 1 or speed == 2 or speed == 3 then
		self.speed = speed
		self:sendState()
	end
end

-- ============================================================ waves

local function waveDuration(wave): number
	local spawnTime = 0
	local boss = false
	for _, g in wave.groups do
		spawnTime = math.max(spawnTime, g.delay + g.interval * (g.count - 1))
		if Enemies.ById[g.enemy].boss then
			boss = true
		end
	end
	return spawnTime + WAVE_SECONDS + (boss and BOSS_EXTRA_SECONDS or 0)
end

-- the wave bonus is paid when the next wave starts, together with every farm's payout
function Battle:payWave()
	local bonus = 100 + 20 * self.waveIndex
	for _, tower in self.towers do
		if tower.stats.farm > 0 then
			bonus += math.floor(tower.stats.farm)
			self:fx({ style = "cash", to = tower.pos + Vector3.new(0, tower.def.height + 1, 0), color = Color3.fromRGB(255, 215, 0), amount = math.floor(tower.stats.farm) })
		end
	end
	self.cash += bonus
end

function Battle:canSkip(): boolean
	return self.state == "wave" and #self.spawners == 0 and self.waveIndex < #self.waves
end

-- starts the next wave: from prep, when its timer runs out, or early (skip) once this wave has finished spawning
function Battle:startNextWave(): boolean
	if self.state == "prep" then
		self.state = "wave"
	elseif not self:canSkip() and not (self.state == "wave" and self.timer <= 0 and self.waveIndex < #self.waves) then
		return false
	end
	if self.waveIndex > 0 then
		self:payWave()
	end
	self.waveIndex += 1
	local wave = self.waves[self.waveIndex]
	for _, g in wave.groups do
		table.insert(self.spawners, { group = g, left = g.count, timer = g.delay, hpMult = wave.hpMult, bossMult = wave.bossMult })
	end
	self.timer = waveDuration(wave)
	self:sendState()
	return true
end

function Battle:runSpawners(dt: number)
	local active = {}
	for _, sp in self.spawners do
		sp.timer -= dt
		while sp.left > 0 and sp.timer <= 0 do
			self:spawnEnemy(sp.group.enemy, sp.hpMult, sp.bossMult, 0)
			sp.left -= 1
			sp.timer += sp.group.interval
		end
		if sp.left > 0 then
			table.insert(active, sp)
		end
	end
	self.spawners = active
end

function Battle:step(dt: number)
	if self.state == "won" or self.state == "lost" then
		return
	end
	self.time += dt
	if self.state == "prep" then
		self.timer -= dt
		if self.timer <= 0 then
			self:startNextWave()
		end
	end
	self:runSpawners(dt)
	self:moveEnemies(dt)
	if self.state == "won" or self.state == "lost" then
		return
	end
	self:updateTowers(dt)
	if self.state == "wave" then
		local clear = #self.spawners == 0 and #self.enemies == 0
		if self.waveIndex >= #self.waves then
			if clear then
				self:payWave()
				self:finish(true)
			end
		else
			self.timer -= dt
			if clear and self.timer > CLEAR_SECONDS then
				self.timer = CLEAR_SECONDS
			end
			if self.timer <= 0 then
				self:startNextWave()
			end
		end
	end
end

function Battle:finish(won: boolean)
	if self.state == "won" or self.state == "lost" then
		return
	end
	self.state = won and "won" or "lost"
	for _, e in self.enemies do
		if e.model then
			e.model:Destroy()
		end
	end
	self.enemies = {}
	self.spawners = {}
	self:sendState()
	if self.onEnd then
		task.spawn(self.onEnd, self, won)
	end
end

-- ============================================================ client sync

function Battle:fx(payload: { [string]: any })
	if self.player.Parent then
		fxEvent:FireClient(self.player, payload)
	end
end

function Battle:snapshot()
	local boss = nil
	for _, e in self.enemies do
		if e.alive and e.def.boss then
			boss = { id = e.def.id, name = e.def.name, hp = math.max(0, math.floor(e.hp)), maxHp = math.floor(e.maxHp), immune = self.time < e.immuneUntil }
			break
		end
	end
	local team = {}
	for i = 1, Units.TeamSize do
		local m = self.team[i]
		if m then
			team[i] = {
				uid = m.uid,
				unitId = m.unitId,
				trait = m.trait,
				level = m.level,
				grades = m.grades,
				placed = self:towerCount(m.unitId),
				cost = Stats.placeCost(m.unitId, m.trait),
				allowed = rarityOk(self, m.unitId),
			}
		else
			team[i] = false
		end
	end
	return {
		active = true,
		mapId = self.mapDef.id,
		stage = self.stage,
		challenge = self.challenge and self.challenge.id or nil,
		origin = self.origin,
		wave = self.waveIndex,
		waves = #self.waves,
		state = self.state,
		timer = math.max(0, math.ceil(self.timer)),
		cash = self.cash,
		baseHp = self.baseHp,
		maxBaseHp = Maps.BaseHealth,
		speed = self.speed,
		enemies = #self.enemies,
		units = self:towerCount(),
		maxUnits = self.mods.maxUnits,
		team = team,
		canSkip = self:canSkip(),
		lastWave = self.waveIndex >= #self.waves,
		boss = boss,
	}
end

function Battle:sendState()
	if self.player.Parent then
		stateEvent:FireClient(self.player, self:snapshot())
	end
end

function Battle:destroy()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	if self.arena then
		self.arena:Destroy()
		self.arena = nil
	end
	if self.player.Parent then
		stateEvent:FireClient(self.player, { active = false })
	end
end

function Battle:spawnPoint(): CFrame
	return CFrame.new(self.origin + Vector3.new(0, 4, 0))
end

Battle.Targeting = TARGETING
return Battle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Player save data in a DataStore. In Studio without "Enable Studio Access to API Services" (or in an unpublished
-- place) the DataStore calls fail; the game then runs on fresh, unsaved data and says so once.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Units = require(game.ReplicatedStorage.Shared.Units)
local Progression = require(game.ReplicatedStorage.Shared.Progression)

local DataService = {}

local STORE_NAME = "StarKingdomDefense_v1"
local AUTOSAVE_SECONDS = 120

-- u: unit id, t: trait id, l: level, x: xp toward the next level, g: stat grades { d, s, r }
export type UnitEntry = { u: string, t: string?, l: number?, x: number?, g: { [string]: string }? }
export type Data = {
	gems: number,
	crystals: number,
	units: { [string]: UnitEntry },
	nextUid: number,
	team: { string },
	progress: { [string]: number },
	challenges: { [string]: number },
	pity: { legendary: number, mythic: number },
	stats: { [string]: number },
}

local store: DataStore? = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local profiles: { [Player]: Data } = {}
local canSave: { [Player]: boolean } = {} -- only after a successful load, so a failed load never overwrites a save
local saving: { [Player]: boolean } = {}
local changedCallback: ((Player, Data) -> ())? = nil

local function defaultData(): Data
	return {
		gems = 500, -- enough for one 10x summon
		crystals = 3,
		units = {
			["1"] = { u = "mushling", l = 1, x = 0, g = { d = "A", s = "A", r = "A" } },
			["2"] = { u = "shellback", l = 1, x = 0, g = { d = "A", s = "A", r = "A" } },
		},
		nextUid = 3,
		team = { "1", "2", "", "", "", "" },
		progress = {},
		challenges = {},
		pity = { legendary = 0, mythic = 0 },
		stats = { summons = 0, wins = 0, rolls = 0 },
	}
end

-- fill fields added after a save was written, drop units that no longer exist
local function reconcile(data: any): Data
	local fresh = defaultData()
	if type(data) ~= "table" then
		return fresh
	end
	for k, v in fresh :: any do
		if data[k] == nil then
			data[k] = v
		end
	end
	for uid, entry in data.units do
		if type(entry) ~= "table" or not Units.ById[entry.u] then
			data.units[uid] = nil
		else
			entry.l = entry.l or 1
			entry.x = entry.x or 0
			entry.g = entry.g or table.clone(Progression.DefaultGrades)
		end
	end
	for i = 1, Units.TeamSize do
		local uid = data.team[i]
		if type(uid) ~= "string" or (uid ~= "" and not data.units[uid]) then
			data.team[i] = ""
		end
	end
	return data
end

local warned = false
local function warnOnce(msg: string)
	if not warned then
		warned = true
		warn("[StarKingdomDefense] " .. msg)
	end
end

local function load(player: Player): (Data, boolean)
	if not storeOk or not store then
		warnOnce("DataStores are unavailable: progress will not be saved (publish the place and enable API access).")
		return defaultData(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return reconcile(result), true
		end
		warnOnce("DataStore load failed (" .. tostring(result) .. "); progress will not be saved this session.")
		if attempt < 3 then
			task.wait(1)
		end
	end
	return defaultData(), false
end

function DataService.save(player: Player)
	local data = profiles[player]
	if not data or not store or not canSave[player] or saving[player] then
		return
	end
	saving[player] = true
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync("p_" .. player.UserId, data)
	end)
	saving[player] = nil
	if not ok then
		warnOnce("DataStore save failed: " .. tostring(err))
	end
end

function DataService.get(player: Player): Data?
	return profiles[player]
end

-- call after changing a player's data: sends it to their client
function DataService.changed(player: Player)
	local data = profiles[player]
	if data and changedCallback then
		changedCallback(player, data)
	end
end

function DataService.onChanged(callback: (Player, Data) -> ())
	changedCallback = callback
end

function DataService.addUnit(data: Data, unitId: string): string
	local uid = tostring(data.nextUid)
	data.nextUid += 1
	data.units[uid] = { u = unitId, l = 1, x = 0, g = table.clone(Progression.DefaultGrades) }
	return uid
end

function DataService.unitCount(data: Data): number
	local n = 0
	for _ in data.units do
		n += 1
	end
	return n
end

function DataService.start()
	local function onJoin(player: Player)
		local data, ok = load(player)
		if player.Parent then
			profiles[player] = data
			canSave[player] = ok
			DataService.changed(player)
		end
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		profiles[player] = nil
		canSave[player] = nil
	end)
	game:BindToClose(function()
		for _, p in Players:GetPlayers() do
			task.spawn(DataService.save, p)
		end
		task.wait(2)
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, p in Players:GetPlayers() do
				task.spawn(DataService.save, p)
			end
		end
	end)
end

-- the client may call GetData before the profile has loaded
function DataService.waitFor(player: Player, timeout: number): Data?
	local t = 0
	while not profiles[player] and t < timeout and player.Parent do
		t += task.wait(0.1)
	end
	return profiles[player]
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[-- Builds the lobby around the spawn (the floor and spawn pad are in the place file): the castle with the battle gate,
-- the Summon Hall with its pedestal (summoned units appear there), statues of every unit and some decoration.
-- Walking up to the gate or the pedestal shows a prompt that opens the matching window.
local Shared = game.ReplicatedStorage.Shared
local ModelFactory = require(Shared.ModelFactory)
local Units = require(Shared.Units)
local Rarities = require(Shared.Rarities)

local Lobby = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

function Lobby.spawnCFrame(): CFrame
	return CFrame.new(0, 5, 0)
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

-- a vertical cylinder standing on `base`
local function pillar(parent: Instance, height: number, diameter: number, base: Vector3, color: Color3, material: Enum.Material?): BasePart
	return part(parent, Vector3.new(height, diameter, diameter), CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material, "Cylinder")
end

local function light(parent: Instance, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
end

local function sparkles(parent: Instance, color: Color3, rate: number)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Rate = rate
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(1, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(1, 0)
	e.Parent = parent
end

local function sign(p: BasePart, face: Enum.NormalId, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
end

local function prompt(parent: BasePart, action: string, window: string)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = ""
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.HoldDuration = 0
	p.MaxActivationDistance = 16
	p.RequiresLineOfSight = false
	p:SetAttribute("OpensWindow", window)
	p.Parent = parent
end

local function buildCastle(lobby: Instance)
	local wall = Color3.fromRGB(245, 238, 225)
	local roof = Color3.fromRGB(220, 50, 55)
	local gold = Color3.fromRGB(255, 205, 50)
	part(lobby, Vector3.new(64, 28, 22), CFrame.new(0, 14, 70), wall, Enum.Material.Brick)
	for x = -28, 28, 6 do
		part(lobby, Vector3.new(3, 3, 22), CFrame.new(x, 29.5, 70), wall, Enum.Material.Brick)
	end
	for _, x in { -36, 36 } do
		pillar(lobby, 40, 16, Vector3.new(x, 0, 70), wall, Enum.Material.Brick)
		for i = 0, 4 do
			local w = 18 - i * 3.6
			part(lobby, Vector3.new(w, 3, w), CFrame.new(x, 41.5 + i * 2.9, 70) * CFrame.Angles(0, math.rad(45), 0), roof)
		end
	end
	-- the keep and its star
	part(lobby, Vector3.new(26, 18, 18), CFrame.new(0, 37, 74), wall, Enum.Material.Brick)
	for i = 0, 5 do
		local w = 28 - i * 4.6
		part(lobby, Vector3.new(w, 3.4, w), CFrame.new(0, 47.7 + i * 3.2, 74) * CFrame.Angles(0, math.rad(45), 0), roof)
	end
	local star = part(lobby, Vector3.new(8, 8, 1.5), CFrame.new(0, 70, 74) * CFrame.Angles(0, 0, math.rad(45)), gold, Enum.Material.Neon)
	light(star, gold, 50, 3)
	sparkles(star, gold, 10)
	-- stained-glass windows
	for _, x in { -18, -9, 9, 18 } do
		part(lobby, Vector3.new(4, 7, 0.6), CFrame.new(x, 17, 58.8), Color3.fromRGB(90, 170, 255), Enum.Material.Neon)
	end
	-- the battle gate: a glowing portal in the castle door
	part(lobby, Vector3.new(18, 20, 1), CFrame.new(0, 10, 58.6), Color3.fromRGB(110, 65, 35), Enum.Material.Wood)
	local gate = part(lobby, Vector3.new(14, 17, 0.6), CFrame.new(0, 8.5, 58), Color3.fromRGB(150, 70, 255), Enum.Material.Neon)
	gate.Transparency = 0.15
	gate.Name = "BattleGate"
	light(gate, Color3.fromRGB(170, 100, 255), 30, 3)
	sparkles(gate, Color3.fromRGB(220, 170, 255), 20)
	prompt(gate, "Battle", "Play")
	local banner = part(lobby, Vector3.new(30, 6, 1), CFrame.new(0, 23, 58.4), Color3.fromRGB(60, 40, 120))
	sign(banner, Enum.NormalId.Front, "⚔ BATTLE ⚔", Color3.fromRGB(255, 225, 90))
	local title = part(lobby, Vector3.new(44, 9, 1), CFrame.new(0, 34, 58.2), Color3.fromRGB(60, 40, 120))
	sign(title, Enum.NormalId.Front, "STAR KINGDOM DEFENSE", Color3.fromRGB(255, 225, 90))
end

local function buildSummonHall(lobby: Instance)
	local hall = Instance.new("Model")
	hall.Name = "SummonHall"
	hall.Parent = lobby
	local center = Vector3.new(0, 0, -62)
	local marble = Color3.fromRGB(240, 236, 250)
	local gold = Color3.fromRGB(255, 205, 50)
	local pink = Color3.fromRGB(255, 90, 180)
	pillar(hall, 1.4, 54, center, Color3.fromRGB(200, 190, 230), Enum.Material.Marble)
	pillar(hall, 1.6, 46, center, marble, Enum.Material.Marble)
	local ring = pillar(hall, 1.7, 30, center, pink, Enum.Material.Neon)
	ring.Transparency = 0.3
	pillar(hall, 1.8, 26, center, marble, Enum.Material.Marble)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local base = center + Vector3.new(math.cos(a) * 21, 1.6, math.sin(a) * 21)
		pillar(hall, 1.4, 4.4, base, gold, Enum.Material.Metal)
		pillar(hall, 22, 3, base + Vector3.new(0, 1.4, 0), marble, Enum.Material.Marble)
		pillar(hall, 1.4, 4.4, base + Vector3.new(0, 23.4, 0), gold, Enum.Material.Metal)
		local orb = part(hall, Vector3.new(2.6, 2.6, 2.6), CFrame.new(base + Vector3.new(0, 26.4, 0)), pink, Enum.Material.Neon, "Sphere")
		light(orb, pink, 18, 1.5)
	end
	-- a floating ring above the pedestal
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		part(hall, Vector3.new(3.4, 1, 1.4), CFrame.new(center + Vector3.new(math.cos(a) * 12, 30, math.sin(a) * 12)) * CFrame.Angles(0, math.pi / 2 - a, 0), gold, Enum.Material.Metal)
	end
	local pedestal = pillar(hall, 4, 9, center + Vector3.new(0, 1.8, 0), gold, Enum.Material.Metal)
	pedestal.Name = "Pedestal"
	local top = pillar(hall, 0.6, 7.6, center + Vector3.new(0, 5.8, 0), pink, Enum.Material.Neon)
	light(top, pink, 24, 2.5)
	sparkles(top, Color3.fromRGB(255, 200, 240), 14)
	prompt(pedestal, "Summon", "Summon")
	local sign1 = part(hall, Vector3.new(26, 6, 1), CFrame.new(center + Vector3.new(0, 34, 0)) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(80, 30, 120))
	sign(sign1, Enum.NormalId.Front, "✨ SUMMON ✨", Color3.fromRGB(255, 225, 90))
	sign(sign1, Enum.NormalId.Back, "✨ SUMMON ✨", Color3.fromRGB(255, 225, 90))

	-- the Mythic units on display around the pedestal
	local mythics = Units.ByRarity.Mythic
	for i, def in mythics do
		local a = math.pi / 2 + (i - (#mythics + 1) / 2) * 0.55
		local pos = center + Vector3.new(math.cos(a) * 15, 1.8, math.sin(a) * 15)
		pillar(hall, 1.2, 6, pos, Rarities.Info.Mythic.color, Enum.Material.Neon)
		local model = ModelFactory.build(def.id, 1.1, true)
		model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 1.2, 0), Vector3.new(0, pos.Y + 1.2, 0)))
		model.Parent = hall
	end
end

local function buildStatues(lobby: Instance)
	-- every unit on a plinth along the two sides of the plaza, best rarity nearest the castle
	local list = table.clone(Units.List)
	table.sort(list, function(a, b)
		return Rarities.Info[a.rarity].rank > Rarities.Info[b.rarity].rank
	end)
	for i, def in list do
		local side = (i % 2 == 0) and 1 or -1
		local row = math.ceil(i / 2)
		local pos = Vector3.new(side * 44, 0, 48 - row * 13)
		local color = Rarities.Info[def.rarity].color
		part(lobby, Vector3.new(7, 2.4, 7), CFrame.new(pos + Vector3.new(0, 1.2, 0)), Color3.fromRGB(225, 220, 235), Enum.Material.Marble)
		local trim = part(lobby, Vector3.new(7.4, 0.5, 7.4), CFrame.new(pos + Vector3.new(0, 2.5, 0)), color, Enum.Material.Neon)
		trim.Transparency = 0.2
		local model = ModelFactory.build(def.id, 1.25, true)
		model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 2.7, 0), Vector3.new(0, 2.7, pos.Z)))
		model.Parent = lobby
	end
end

local function buildDecor(lobby: Instance)
	-- a stone plaza and paths
	part(lobby, Vector3.new(60, 0.3, 60), CFrame.new(0, 0.15, 0), Color3.fromRGB(215, 205, 185), Enum.Material.Cobblestone)
	part(lobby, Vector3.new(14, 0.3, 40), CFrame.new(0, 0.15, 40), Color3.fromRGB(215, 205, 185), Enum.Material.Cobblestone)
	part(lobby, Vector3.new(14, 0.3, 20), CFrame.new(0, 0.15, -32), Color3.fromRGB(215, 205, 185), Enum.Material.Cobblestone)
	-- trees and giant mushrooms around the edge
	local rng = Random.new(7)
	for i = 1, 26 do
		local a = i / 26 * math.pi * 2
		local r = rng:NextNumber(86, 102)
		local p = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if i % 3 == 0 then
			pillar(lobby, 8, 4, p, Color3.fromRGB(250, 238, 210))
			part(lobby, Vector3.new(16, 8, 16), CFrame.new(p + Vector3.new(0, 9, 0)), ({ Color3.fromRGB(230, 50, 50), Color3.fromRGB(60, 130, 235), Color3.fromRGB(250, 170, 40) })[i % 3 + 1], nil, "Sphere")
		else
			pillar(lobby, 9, 2.4, p, Color3.fromRGB(125, 85, 50), Enum.Material.Wood)
			part(lobby, Vector3.new(12, 10, 12), CFrame.new(p + Vector3.new(0, 12, 0)), Color3.fromRGB(60, 170, 70), Enum.Material.Grass, "Sphere")
		end
	end
	-- floating ? blocks
	for _, p in { Vector3.new(-24, 14, 20), Vector3.new(24, 14, 20), Vector3.new(-30, 16, -24), Vector3.new(30, 16, -24) } do
		local b = part(lobby, Vector3.new(5, 5, 5), CFrame.new(p), Color3.fromRGB(255, 200, 40))
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
			sign(b, face, "?", Color3.new(1, 1, 1))
		end
		light(b, Color3.fromRGB(255, 220, 120), 12, 1)
	end
end

function Lobby.build()
	local lobby = workspace:FindFirstChild("Lobby") or Instance.new("Model")
	lobby.Name = "Lobby"
	lobby.Parent = workspace
	buildDecor(lobby)
	buildCastle(lobby)
	buildSummonHall(lobby)
	buildStatues(lobby)
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: remotes, summons, traits, team, starting and ending battles.
local Players = game:GetService("Players")

local Shared = game.ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Units = require(Shared.Units)
local Traits = require(Shared.Traits)
local Rarities = require(Shared.Rarities)
local Maps = require(Shared.Maps)
local Challenges = require(Shared.Challenges)
local Progression = require(Shared.Progression)

local DataService = require(script.Parent.DataService)
local Battle = require(script.Parent.Battle)
local Lobby = require(script.Parent.Lobby)

Net.setup()
Battle.init()
Lobby.build()

local SUMMON_COST = { [1] = 50, [10] = 450 }

local rng = Random.new()
local battles: { [Player]: any } = {}
local slotsInUse: { [number]: boolean } = {}

local dataChanged = Net.ev("DataChanged")
local battleEnded = Net.ev("BattleEnded")

DataService.onChanged(function(player, data)
	dataChanged:FireClient(player, data)
end)
DataService.start()

local function handle(name: string, fn: (Player, ...any) -> ...any)
	Net.fn(name).OnServerInvoke = function(player, ...)
		local ok, a, b, c = pcall(fn, player, ...)
		if not ok then
			warn("[StarKingdomDefense] " .. name .. " failed: " .. tostring(a))
			return false, "Something went wrong"
		end
		return a, b, c
	end
end

local function mapUnlocked(data, mapId: string): boolean
	local index = Maps.Index[mapId]
	if not index then
		return false
	end
	if index == 1 then
		return true
	end
	return (data.progress[Maps.List[index - 1].id] or 0) >= Maps.Stages
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(cf)
	end
end

-- ============================================================ lobby actions

handle("GetData", function(player)
	return DataService.waitFor(player, 15)
end)

handle("Summon", function(player, count)
	local data = DataService.get(player)
	local cost = SUMMON_COST[count]
	if not data or not cost then
		return false, "Invalid summon"
	end
	if data.gems < cost then
		return false, "Not enough gems"
	end
	if DataService.unitCount(data) + count > Units.InventoryLimit then
		return false, "Your unit inventory is full (" .. Units.InventoryLimit .. "). Release some units first."
	end
	data.gems -= cost
	local results = {}
	for _ = 1, count do
		data.pity.legendary += 1
		data.pity.mythic += 1
		local rarity = Rarities.roll(Rarities.SummonRates, rng)
		if data.pity.mythic >= Rarities.MythicPity then
			rarity = "Mythic"
		elseif data.pity.legendary >= Rarities.LegendaryPity and Rarities.Info[rarity].rank < Rarities.Info.Legendary.rank then
			rarity = "Legendary"
		end
		if rarity == "Mythic" then
			data.pity.mythic = 0
			data.pity.legendary = 0
		elseif rarity == "Legendary" then
			data.pity.legendary = 0
		end
		local pool = Units.ByRarity[rarity]
		local def = pool[rng:NextInteger(1, #pool)]
		local uid = DataService.addUnit(data, def.id)
		data.units[uid].g = Progression.rollGrades(rng)
		-- fill an empty team slot with new units so a new player can play right away
		local empty = table.find(data.team, "")
		local alreadyOnTeam = false
		for _, other in data.team do
			if other ~= "" and data.units[other] and data.units[other].u == def.id then
				alreadyOnTeam = true
			end
		end
		if empty and not alreadyOnTeam then
			data.team[empty] = uid
		end
		table.insert(results, { uid = uid, unitId = def.id, rarity = rarity, grades = data.units[uid].g })
	end
	data.stats.summons = (data.stats.summons or 0) + count
	DataService.changed(player)
	return true, results
end)

handle("EquipUnit", function(player, slot, uid)
	local data = DataService.get(player)
	if not data or type(slot) ~= "number" or slot < 1 or slot > Units.TeamSize or slot % 1 ~= 0 then
		return false, "Invalid slot"
	end
	if type(uid) ~= "string" or (uid ~= "" and not data.units[uid]) then
		return false, "Invalid unit"
	end
	if uid ~= "" then
		local unitId = data.units[uid].u
		for i, other in data.team do
			if i ~= slot and other ~= "" then
				if other == uid then
					data.team[i] = ""
				elseif data.units[other] and data.units[other].u == unitId then
					return false, "That unit is already on your team (one copy per unit type)"
				end
			end
		end
	end
	data.team[slot] = uid
	DataService.changed(player)
	return true
end)

handle("RollTrait", function(player, uid)
	local data = DataService.get(player)
	if not data or type(uid) ~= "string" or not data.units[uid] then
		return false, "Invalid unit"
	end
	if data.crystals < Traits.RollCost then
		return false, "Not enough Trait Crystals. Clear challenges to earn more!"
	end
	data.crystals -= Traits.RollCost
	local rarity = Rarities.roll(Rarities.TraitRates, rng)
	local pool = Traits.ByRarity[rarity]
	local trait = pool[rng:NextInteger(1, #pool)]
	data.units[uid].t = trait.id
	data.stats.rolls = (data.stats.rolls or 0) + 1
	DataService.changed(player)
	return true, trait.id
end)

handle("ReleaseUnit", function(player, uid)
	local data = DataService.get(player)
	if not data or type(uid) ~= "string" or not data.units[uid] then
		return false, "Invalid unit"
	end
	if DataService.unitCount(data) <= 1 then
		return false, "You can't release your last unit"
	end
	local def = Units.ById[data.units[uid].u]
	local gems = Rarities.Info[def.rarity].releaseGems
	data.units[uid] = nil
	for i, other in data.team do
		if other == uid then
			data.team[i] = ""
		end
	end
	data.gems += gems
	DataService.changed(player)
	return true, gems
end)

-- ============================================================ battles

local function rewardsFor(data, battle, won: boolean)
	local result = { won = won, gems = 0, crystals = 0, wave = battle.waveIndex, waves = #battle.waves, firstClear = false }
	if battle.challenge then
		local ch = battle.challenge
		result.challenge = ch.name
		if won then
			if data.challenges[ch.id] ~= Challenges.today() then
				data.challenges[ch.id] = Challenges.today()
				result.gems = ch.gems
				result.crystals = ch.crystals
				result.firstClear = true
			else
				result.gems = ch.repeatGems
			end
		else
			result.gems = 2 * math.max(0, battle.waveIndex - 1)
		end
	else
		local mapIndex = Maps.Index[battle.mapDef.id]
		local factor = 1 + 0.25 * (mapIndex - 1)
		if won then
			local prev = data.progress[battle.mapDef.id] or 0
			if battle.stage > prev then
				result.firstClear = true
				data.progress[battle.mapDef.id] = battle.stage
				result.gems = math.floor((60 + 30 * battle.stage + (battle.stage == Maps.Stages and 150 or 0)) * factor)
				result.crystals = battle.stage == Maps.Stages and 3 or 1
				if battle.stage == Maps.Stages and Maps.List[mapIndex + 1] then
					result.unlocked = Maps.List[mapIndex + 1].name
				end
			else
				result.gems = math.floor((15 + 5 * battle.stage) * factor)
			end
		else
			result.gems = 2 * math.max(0, battle.waveIndex - 1)
		end
	end
	if won then
		data.stats.wins = (data.stats.wins or 0) + 1
	end
	data.gems += result.gems
	data.crystals += result.crystals

	-- every unit that went into battle earns XP: per wave survived, doubled on a win
	local xp = math.max(0, battle.waveIndex - (won and 0 or 1)) * 12 * (won and 2 or 1)
	result.xp = xp
	result.levelUps = {}
	for _, member in battle.team do
		local entry = data.units[member.uid]
		if entry and xp > 0 then
			local gained = Progression.addXp(entry, xp)
			if gained > 0 then
				table.insert(result.levelUps, { unitId = entry.u, level = entry.l })
			end
		end
	end
	return result
end

local function endBattle(player: Player)
	local battle = battles[player]
	if not battle then
		return
	end
	battles[player] = nil
	slotsInUse[battle.slot] = nil
	battle:destroy()
	teleport(player, Lobby.spawnCFrame())
end

handle("StartBattle", function(player, kind, id, stage)
	local data = DataService.get(player)
	if not data then
		return false, "Your data is still loading"
	end
	if battles[player] then
		return false, "You are already in a battle"
	end
	local mapId, challenge
	if kind == "challenge" then
		challenge = Challenges.ById[id]
		if not challenge then
			return false, "Unknown challenge"
		end
		mapId = challenge.map
		stage = challenge.stage
		if not mapUnlocked(data, mapId) or (data.progress[mapId] or 0) < 1 then
			return false, "Clear stage 1 of " .. Maps.ById[mapId].name .. " to unlock this challenge"
		end
	else
		mapId = id
		if not Maps.ById[mapId] or type(stage) ~= "number" or stage < 1 or stage > Maps.Stages or stage % 1 ~= 0 then
			return false, "Unknown stage"
		end
		if not mapUnlocked(data, mapId) then
			return false, "Map locked: beat stage " .. Maps.Stages .. " of the previous map"
		end
		if (data.progress[mapId] or 0) < stage - 1 then
			return false, "Beat stage " .. (stage - 1) .. " first"
		end
	end

	local team = {}
	local any = false
	for i = 1, Units.TeamSize do
		local uid = data.team[i]
		local entry = uid ~= "" and data.units[uid]
		if entry then
			team[i] = { uid = uid, unitId = entry.u, trait = entry.t, level = entry.l or 1, grades = entry.g or Progression.DefaultGrades }
			any = true
		end
	end
	if not any then
		return false, "Equip at least one unit on your team first"
	end

	local slot = 1
	while slotsInUse[slot] do
		slot += 1
	end
	slotsInUse[slot] = true

	local battle = Battle.new(player, {
		mapId = mapId,
		stage = stage,
		challenge = challenge,
		team = team,
		slot = slot,
		onEnd = function(b, won)
			local d = DataService.get(player)
			if not d then
				return
			end
			local result = rewardsFor(d, b, won)
			DataService.changed(player)
			battleEnded:FireClient(player, result)
			task.spawn(DataService.save, player)
		end,
	})
	battles[player] = battle
	teleport(player, battle:spawnPoint())
	return true
end)

local function withBattle(fn: (any, ...any) -> ...any)
	return function(player, ...)
		local battle = battles[player]
		if not battle then
			return false, "You are not in a battle"
		end
		return fn(battle, ...)
	end
end

handle(
	"PlaceUnit",
	withBattle(function(battle, slot, position)
		if type(slot) ~= "number" or typeof(position) ~= "Vector3" then
			return false, "Invalid placement"
		end
		return battle:place(slot, position)
	end)
)

handle(
	"UpgradeTower",
	withBattle(function(battle, id)
		if type(id) ~= "number" then
			return false, "Invalid"
		end
		return battle:upgrade(id)
	end)
)

handle(
	"SellTower",
	withBattle(function(battle, id)
		if type(id) ~= "number" then
			return false, "Invalid"
		end
		return battle:sell(id)
	end)
)

handle(
	"SetTargeting",
	withBattle(function(battle, id, mode)
		if type(id) ~= "number" or type(mode) ~= "string" then
			return false, "Invalid"
		end
		return battle:setTargeting(id, mode)
	end)
)

handle(
	"StartWave",
	withBattle(function(battle)
		return battle:startNextWave()
	end)
)

handle(
	"SetSpeed",
	withBattle(function(battle, speed)
		if type(speed) ~= "number" then
			return false
		end
		battle:setSpeed(speed)
		return true
	end)
)

handle("LeaveBattle", function(player)
	if battles[player] then
		local battle = battles[player]
		-- leaving mid-battle counts as a loss (no rewards beyond waves survived)
		if battle.state ~= "won" and battle.state ~= "lost" then
			battle:finish(false)
		end
		endBattle(player)
	end
	return true
end)

-- ============================================================ players

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		local battle = battles[player]
		if battle then
			teleport(player, battle:spawnPoint())
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	local battle = battles[player]
	if battle then
		battles[player] = nil
		slotsInUse[battle.slot] = nil
		battle:destroy()
	end
end)

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds a campaign map out of parts at an arena origin: the play field (tiled ground, a curbed path, themed
-- landmarks), the scenery around it, the enemy portal and your castle.
local Maps = require(game.ReplicatedStorage.Shared.Maps)

local MapBuilder = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

-- ============================================================ part helpers

type Opts = { [string]: any }

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	local o = opts or {}
	local p: BasePart
	if o.wedge then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if o.shape == "Ball" then
			-- a sphere mesh stretches to the part's size; Ball parts are always perfect spheres
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = q
		elseif o.shape == "Cylinder" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = o.material or Enum.Material.SmoothPlastic
	p.Transparency = o.transparency or 0
	p.CanCollide = o.collide == true
	p.CanQuery = o.query == true
	p.CanTouch = false
	p.CastShadow = o.shadow ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.name then
		p.Name = o.name
	end
	p.Parent = parent
	return p
end

local function ball(parent: Instance, size: Vector3, pos: Vector3, color: Color3, opts: Opts?): BasePart
	local o = opts or {}
	o.shape = "Ball"
	return part(parent, size, CFrame.new(pos), color, o)
end

-- a vertical cylinder standing on `base`
local function pillar(parent: Instance, height: number, diameter: number, base: Vector3, color: Color3, opts: Opts?): BasePart
	local o = opts or {}
	o.shape = "Cylinder"
	return part(parent, Vector3.new(height, diameter, diameter), CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, o)
end

local function emitter(parent: Instance, texture: string, color: Color3, props: Opts?)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.Rate = 6
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(1, 3)
	e.Size = NumberSequence.new(1.2, 0)
	e.Transparency = NumberSequence.new(0.2, 1)
	for k, v in (props or {}) :: Opts do
		(e :: any)[k] = v
	end
	e.Parent = parent
end

local function light(parent: Instance, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = parent
end

local function fire(parent: BasePart, color: Color3, size: number)
	local f = Instance.new("Fire")
	f.Color = color
	f.SecondaryColor = color:Lerp(Color3.new(1, 1, 0.4), 0.5)
	f.Size = size
	f.Heat = 6
	f.Parent = parent
end

local function signFace(p: BasePart, face: Enum.NormalId, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.PixelsPerStud = 20
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
end

local function shade(c: Color3, amount: number): Color3
	if amount >= 0 then
		return c:Lerp(Color3.new(1, 1, 1), amount)
	end
	return c:Lerp(Color3.new(0, 0, 0), -amount)
end

-- ============================================================ decorations

local WHITE = Color3.fromRGB(250, 250, 250)

local decor: { [string]: (Instance, Vector3, number, Random) -> () } = {}

decor.tree = function(f, p, s, rng)
	pillar(f, 6 * s, 1.6 * s, p, Color3.fromRGB(125, 85, 50), { material = Enum.Material.Wood, collide = true })
	local green = Color3.fromRGB(50, 165, 65):Lerp(Color3.fromRGB(90, 200, 70), rng:NextNumber())
	ball(f, Vector3.new(7, 6, 7) * s, p + Vector3.new(0, 7 * s, 0), green, { material = Enum.Material.Grass })
	ball(f, Vector3.new(5, 4.5, 5) * s, p + Vector3.new(0, 9.6 * s, 0), shade(green, 0.12), { material = Enum.Material.Grass })
end

decor.mushroom = function(f, p, s, rng)
	local caps = { Color3.fromRGB(230, 50, 50), Color3.fromRGB(60, 130, 235), Color3.fromRGB(250, 170, 40), Color3.fromRGB(60, 190, 80) }
	local cap = caps[rng:NextInteger(1, #caps)]
	pillar(f, 7 * s, 3 * s, p, Color3.fromRGB(250, 238, 210), { collide = true })
	ball(f, Vector3.new(11, 6, 11) * s, p + Vector3.new(0, 8 * s, 0), cap, { collide = true })
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		ball(f, Vector3.new(2.2, 1.4, 2.2) * s, p + Vector3.new(math.cos(a) * 3.6 * s, 9.4 * s, math.sin(a) * 3.6 * s), WHITE)
	end
	ball(f, Vector3.new(2.6, 1.2, 2.6) * s, p + Vector3.new(0, 11 * s, 0), WHITE)
end

decor.pipe = function(f, p, s, _rng)
	local green = Color3.fromRGB(40, 180, 60)
	pillar(f, 6 * s, 6 * s, p, green, { collide = true, material = Enum.Material.Plastic })
	pillar(f, 2 * s, 7.4 * s, p + Vector3.new(0, 6 * s, 0), shade(green, 0.1), { collide = true, material = Enum.Material.Plastic })
	pillar(f, 0.2, 5.6 * s, p + Vector3.new(0, 8 * s, 0), Color3.fromRGB(10, 40, 15))
end

decor.qblock = function(f, p, s, rng)
	local b = part(f, Vector3.new(5, 5, 5) * s, CFrame.new(p + Vector3.new(0, rng:NextNumber(11, 15), 0)), Color3.fromRGB(255, 200, 40), { material = Enum.Material.SmoothPlastic })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
		signFace(b, face, "?", Color3.new(1, 1, 1))
	end
	light(b, Color3.fromRGB(255, 220, 120), 10, 0.8)
end

decor.bush = function(f, p, s, rng)
	local green = Color3.fromRGB(60, 175, 70)
	for i = 1, 3 do
		ball(f, Vector3.new(4, 3.4, 4) * s * rng:NextNumber(0.8, 1.2), p + Vector3.new((i - 2) * 2.4 * s, 1.4 * s, rng:NextNumber(-1, 1)), shade(green, (i - 2) * 0.08), { material = Enum.Material.Grass })
	end
	ball(f, Vector3.new(0.9, 0.9, 0.9), p + Vector3.new(0, 3 * s, -1.6 * s), Color3.fromRGB(255, 90, 140))
end

decor.flowers = function(f, p, _s, rng)
	local colors = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 230, 70), Color3.fromRGB(150, 110, 255), WHITE }
	for _ = 1, 5 do
		local q = p + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		pillar(f, 1.2, 0.2, q, Color3.fromRGB(60, 150, 60), { shadow = false })
		ball(f, Vector3.new(0.8, 0.5, 0.8), q + Vector3.new(0, 1.3, 0), colors[rng:NextInteger(1, #colors)], { shadow = false })
	end
end

decor.coin = function(f, p, _s, rng)
	local c = part(f, Vector3.new(0.5, 3, 3), CFrame.new(p + Vector3.new(0, rng:NextNumber(4, 7), 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color3.fromRGB(255, 210, 40), { shape = "Cylinder", material = Enum.Material.Metal })
	light(c, Color3.fromRGB(255, 220, 80), 6, 0.6)
end

decor.palm = function(f, p, s, rng)
	local lean = rng:NextNumber(-0.25, 0.25)
	local top = p
	for i = 0, 5 do
		local seg = p + Vector3.new(lean * i * i * 0.4 * s, (i + 0.5) * 2 * s, 0)
		part(f, Vector3.new(1.3, 2.1, 1.3) * s, CFrame.new(seg) * CFrame.Angles(0, i, lean), Color3.fromRGB(150, 110, 70), { material = Enum.Material.Wood })
		top = seg
	end
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		part(f, Vector3.new(0.4, 1.2, 6) * s, CFrame.new(top + Vector3.new(0, 1 * s, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -3 * s) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(70, 160, 60), { wedge = true, material = Enum.Material.Grass })
	end
	ball(f, Vector3.new(1, 1, 1) * s, top + Vector3.new(0.6 * s, 0.2, 0), Color3.fromRGB(120, 80, 40))
end

decor.cactus = function(f, p, s, _rng)
	local green = Color3.fromRGB(70, 155, 75)
	pillar(f, 8 * s, 2 * s, p, green, { collide = true, material = Enum.Material.Grass })
	ball(f, Vector3.new(2, 2, 2) * s, p + Vector3.new(0, 8 * s, 0), green, { material = Enum.Material.Grass })
	pillar(f, 3 * s, 1.3 * s, p + Vector3.new(1.8 * s, 3.5 * s, 0), green, { material = Enum.Material.Grass })
	part(f, Vector3.new(1.8, 1.2, 1.2) * s, CFrame.new(p + Vector3.new(1.1 * s, 3.5 * s, 0)), green, { material = Enum.Material.Grass })
	ball(f, Vector3.new(1.3, 1.3, 1.3) * s, p + Vector3.new(1.8 * s, 6.5 * s, 0), green, { material = Enum.Material.Grass })
	ball(f, Vector3.new(0.9, 0.9, 0.9) * s, p + Vector3.new(0, 9 * s, 0), Color3.fromRGB(255, 120, 170))
end

decor.pyramid = function(f, p, s, _rng)
	local sand = Color3.fromRGB(220, 185, 110)
	for i = 0, 5 do
		local w = (24 - i * 4) * s
		part(f, Vector3.new(w, 3 * s, w), CFrame.new(p + Vector3.new(0, (1.5 + i * 3) * s, 0)), shade(sand, -i * 0.03), { material = Enum.Material.Sandstone, collide = true })
	end
	part(f, Vector3.new(3, 4, 0.4) * s, CFrame.new(p + Vector3.new(0, 2 * s, -12.1 * s)), Color3.fromRGB(40, 30, 20))
end

decor.rock = function(f, p, s, rng)
	local c = Color3.fromRGB(150, 140, 130)
	ball(f, Vector3.new(5, 3.5, 4.5) * s * rng:NextNumber(0.7, 1.3), p + Vector3.new(0, 1 * s, 0), c, { material = Enum.Material.Rock, collide = true })
	ball(f, Vector3.new(3, 2, 3) * s, p + Vector3.new(2.2 * s, 0.6 * s, 1 * s), shade(c, -0.1), { material = Enum.Material.Rock })
end

decor.oasis = function(f, p, s, rng)
	pillar(f, 0.3, 16 * s, p + Vector3.new(0, -0.05, 0), Color3.fromRGB(60, 160, 220), { material = Enum.Material.Glass, transparency = 0.25 })
	pillar(f, 0.2, 19 * s, p + Vector3.new(0, -0.1, 0), Color3.fromRGB(110, 170, 80), { material = Enum.Material.Grass })
	decor.palm(f, p + Vector3.new(7 * s, 0, 4 * s), s, rng)
end

decor.pine = function(f, p, s, _rng)
	pillar(f, 3 * s, 1.2 * s, p, Color3.fromRGB(100, 70, 45), { material = Enum.Material.Wood, collide = true })
	for i = 0, 2 do
		local w = (7 - i * 1.9) * s
		local y = (3.2 + i * 2.6) * s
		part(f, Vector3.new(w, 3 * s, w), CFrame.new(p + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.rad(45 * i), 0), Color3.fromRGB(35, 105, 70), { material = Enum.Material.Grass })
		part(f, Vector3.new(w * 0.95, 0.7 * s, w * 0.95), CFrame.new(p + Vector3.new(0, y + 1.6 * s, 0)) * CFrame.Angles(0, math.rad(45 * i), 0), WHITE, { material = Enum.Material.Snow })
	end
end

decor.snowman = function(f, p, s, _rng)
	ball(f, Vector3.new(5, 5, 5) * s, p + Vector3.new(0, 2.3 * s, 0), WHITE, { material = Enum.Material.Snow, collide = true })
	ball(f, Vector3.new(3.6, 3.6, 3.6) * s, p + Vector3.new(0, 6 * s, 0), WHITE, { material = Enum.Material.Snow })
	ball(f, Vector3.new(2.6, 2.6, 2.6) * s, p + Vector3.new(0, 8.6 * s, 0), WHITE, { material = Enum.Material.Snow })
	part(f, Vector3.new(0.5, 0.5, 1.6) * s, CFrame.new(p + Vector3.new(0, 8.6 * s, -1.6 * s)), Color3.fromRGB(255, 130, 30), { wedge = true })
	pillar(f, 1.6 * s, 2 * s, p + Vector3.new(0, 9.6 * s, 0), Color3.fromRGB(30, 30, 35))
	pillar(f, 0.3 * s, 3 * s, p + Vector3.new(0, 9.6 * s, 0), Color3.fromRGB(30, 30, 35))
	part(f, Vector3.new(4, 0.6, 0.8) * s, CFrame.new(p + Vector3.new(0, 7.4 * s, 0)), Color3.fromRGB(220, 40, 40))
end

decor.igloo = function(f, p, s, _rng)
	ball(f, Vector3.new(14, 14, 14) * s, p, Color3.fromRGB(235, 245, 255), { material = Enum.Material.Ice, collide = true })
	part(f, Vector3.new(4, 5, 3) * s, CFrame.new(p + Vector3.new(0, 2.5 * s, -6.5 * s)), Color3.fromRGB(225, 238, 255), { material = Enum.Material.Ice })
	part(f, Vector3.new(2.6, 3.6, 0.3) * s, CFrame.new(p + Vector3.new(0, 1.8 * s, -8.05 * s)), Color3.fromRGB(30, 40, 60))
end

decor.crystal = function(f, p, s, rng)
	for i = 1, 4 do
		local h = rng:NextNumber(4, 9) * s
		local c = part(f, Vector3.new(1.6 * s, h, 1.6 * s), CFrame.new(p + Vector3.new(rng:NextNumber(-2, 2) * s, h / 2, rng:NextNumber(-2, 2) * s)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 3), rng:NextNumber(-0.4, 0.4)), Color3.fromRGB(130, 210, 255), { material = Enum.Material.Glass, transparency = 0.25 })
		if i == 1 then
			light(c, Color3.fromRGB(120, 200, 255), 12, 1)
		end
	end
end

decor.basalt = function(f, p, s, rng)
	for i = 1, 5 do
		local h = rng:NextNumber(4, 12) * s
		pillar(f, h, 2.6 * s, p + Vector3.new(math.cos(i * 1.3) * 2.4 * s, 0, math.sin(i * 1.3) * 2.4 * s), Color3.fromRGB(45, 38, 40), { material = Enum.Material.Basalt, collide = true })
	end
end

decor.lavapool = function(f, p, s, _rng)
	pillar(f, 0.6, 18 * s, p + Vector3.new(0, -0.2, 0), Color3.fromRGB(40, 30, 30), { material = Enum.Material.Basalt })
	local lava = pillar(f, 0.4, 15 * s, p + Vector3.new(0, 0, 0), Color3.fromRGB(255, 110, 20), { material = Enum.Material.Neon })
	light(lava, Color3.fromRGB(255, 120, 40), 22, 2)
	emitter(lava, FIRE, Color3.fromRGB(255, 140, 40), { Rate = 4, Speed = NumberRange.new(2, 5), Size = NumberSequence.new(2, 0) })
end

decor.brazier = function(f, p, s, _rng)
	pillar(f, 5 * s, 1.2 * s, p, Color3.fromRGB(60, 50, 50), { material = Enum.Material.Metal, collide = true })
	local bowl = pillar(f, 1.2 * s, 3 * s, p + Vector3.new(0, 5 * s, 0), Color3.fromRGB(80, 70, 70), { material = Enum.Material.Metal })
	fire(bowl, Color3.fromRGB(255, 120, 30), 5 * s)
	light(bowl, Color3.fromRGB(255, 140, 60), 18, 2)
end

decor.ruin = function(f, p, s, rng)
	local brick = Color3.fromRGB(100, 80, 75)
	for i = 0, 3 do
		local h = rng:NextNumber(2, 8) * s
		part(f, Vector3.new(4 * s, h, 2 * s), CFrame.new(p + Vector3.new((i - 1.5) * 4 * s, h / 2, 0)), shade(brick, rng:NextNumber(-0.1, 0.1)), { material = Enum.Material.Brick, collide = true })
	end
end

decor.starpillar = function(f, p, s, _rng)
	pillar(f, 1 * s, 4.4 * s, p, Color3.fromRGB(240, 210, 110), { material = Enum.Material.Metal, collide = true })
	pillar(f, 13 * s, 3 * s, p + Vector3.new(0, 1 * s, 0), Color3.fromRGB(235, 230, 245), { material = Enum.Material.Marble, collide = true })
	pillar(f, 1 * s, 4.4 * s, p + Vector3.new(0, 14 * s, 0), Color3.fromRGB(240, 210, 110), { material = Enum.Material.Metal })
	local star = part(f, Vector3.new(2.4, 2.4, 0.6) * s, CFrame.new(p + Vector3.new(0, 17 * s, 0)) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(255, 220, 60), { material = Enum.Material.Neon })
	light(star, Color3.fromRGB(255, 220, 120), 14, 1.2)
end

decor.torch = function(f, p, s, _rng)
	pillar(f, 6 * s, 0.8 * s, p, Color3.fromRGB(70, 50, 90), { material = Enum.Material.Metal, collide = true })
	local top = ball(f, Vector3.new(1.4, 1.4, 1.4) * s, p + Vector3.new(0, 6.4 * s, 0), Color3.fromRGB(200, 120, 255), { material = Enum.Material.Neon })
	fire(top, Color3.fromRGB(170, 80, 255), 3 * s)
	light(top, Color3.fromRGB(180, 110, 255), 16, 1.8)
end

decor.banner = function(f, p, s, _rng)
	pillar(f, 12 * s, 0.6 * s, p, Color3.fromRGB(230, 200, 100), { material = Enum.Material.Metal, collide = true })
	local cloth = part(f, Vector3.new(4 * s, 6 * s, 0.2), CFrame.new(p + Vector3.new(2.2 * s, 9 * s, 0)), Color3.fromRGB(180, 30, 60), { material = Enum.Material.Fabric })
	signFace(cloth, Enum.NormalId.Front, "★", Color3.fromRGB(255, 220, 60))
	signFace(cloth, Enum.NormalId.Back, "★", Color3.fromRGB(255, 220, 60))
end

-- what each theme scatters on the field: { decoration, weight, scale range }
local fieldDecor = {
	meadow = { { "tree", 5, 0.9, 1.3 }, { "bush", 5, 0.8, 1.2 }, { "flowers", 6, 1, 1 }, { "mushroom", 3, 0.7, 1.1 }, { "pipe", 2, 0.8, 1.1 }, { "qblock", 2, 1, 1 }, { "coin", 3, 1, 1 } },
	desert = { { "cactus", 6, 0.8, 1.3 }, { "rock", 5, 0.7, 1.4 }, { "palm", 3, 0.9, 1.2 }, { "oasis", 1, 0.8, 1 }, { "ruin", 2, 0.8, 1.1 } },
	frost = { { "pine", 7, 0.8, 1.4 }, { "snowman", 2, 0.8, 1.1 }, { "crystal", 4, 0.8, 1.3 }, { "rock", 3, 0.8, 1.2 }, { "igloo", 1, 0.8, 1 } },
	magma = { { "basalt", 5, 0.7, 1.2 }, { "lavapool", 3, 0.7, 1 }, { "brazier", 3, 0.9, 1.1 }, { "ruin", 4, 0.8, 1.2 }, { "rock", 3, 0.8, 1.3 } },
	starcastle = { { "starpillar", 5, 0.8, 1.1 }, { "torch", 5, 0.9, 1.1 }, { "banner", 4, 0.9, 1.1 }, { "coin", 3, 1, 1 } },
}

-- big scenery around the field
local scenery = {
	meadow = function(f: Instance, p: Vector3, s: number, rng: Random)
		if rng:NextNumber() < 0.45 then
			ball(f, Vector3.new(60, 34, 60) * s, p + Vector3.new(0, 4 * s, 0), Color3.fromRGB(80, 180, 80):Lerp(Color3.fromRGB(110, 200, 90), rng:NextNumber()), { material = Enum.Material.Grass })
			ball(f, Vector3.new(4, 6, 2) * s, p + Vector3.new(-4 * s, 14 * s, -27 * s), Color3.fromRGB(20, 20, 20))
			ball(f, Vector3.new(4, 6, 2) * s, p + Vector3.new(4 * s, 14 * s, -27 * s), Color3.fromRGB(20, 20, 20))
		elseif rng:NextNumber() < 0.6 then
			decor.mushroom(f, p, s * 3, rng)
		else
			decor.tree(f, p, s * 3, rng)
		end
	end,
	desert = function(f, p, s, rng)
		if rng:NextNumber() < 0.35 then
			decor.pyramid(f, p, s * 2.5, rng)
		else
			ball(f, Vector3.new(80, 22, 50) * s, p, Color3.fromRGB(235, 200, 125), { material = Enum.Material.Sand })
		end
	end,
	frost = function(f, p, s, rng)
		local h = rng:NextNumber(40, 90) * s
		local w = h * 1.2
		for i = 0, 4 do
			local ww = w * (1 - i * 0.19)
			pillar(f, h / 5 + 0.5, ww, p + Vector3.new(0, i * h / 5, 0), i >= 3 and WHITE or Color3.fromRGB(125, 135, 155), { material = i >= 3 and Enum.Material.Snow or Enum.Material.Rock })
		end
		ball(f, Vector3.new(w * 0.24, h * 0.16, w * 0.24), p + Vector3.new(0, h, 0), WHITE, { material = Enum.Material.Snow })
	end,
	magma = function(f, p, s, rng)
		local h = rng:NextNumber(40, 80) * s
		local w = h * 1.3
		for i = 0, 4 do
			pillar(f, h / 5 + 0.5, w * (1 - i * 0.18), p + Vector3.new(0, i * h / 5, 0), Color3.fromRGB(58, 42, 42):Lerp(Color3.fromRGB(35, 28, 30), i / 4), { material = Enum.Material.Basalt })
		end
		if rng:NextNumber() < 0.5 then
			local crater = pillar(f, 1.5, w * 0.24, p + Vector3.new(0, h + 0.2, 0), Color3.fromRGB(255, 100, 20), { material = Enum.Material.Neon })
			emitter(crater, SMOKE, Color3.fromRGB(80, 70, 70), { Rate = 3, Lifetime = NumberRange.new(6, 9), Speed = NumberRange.new(6, 10), Size = NumberSequence.new(8, 20), Transparency = NumberSequence.new(0.3, 1), LightEmission = 0 })
			light(crater, Color3.fromRGB(255, 120, 40), 40, 3)
		end
	end,
	starcastle = function(f, p, s, rng)
		local wall = Color3.fromRGB(120, 100, 160)
		local h = rng:NextNumber(30, 50) * s
		part(f, Vector3.new(40 * s, h, 12 * s), CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), wall, { material = Enum.Material.Brick })
		pillar(f, h + 14 * s, 14 * s, p + Vector3.new(0, 0, 0), shade(wall, 0.1), { material = Enum.Material.Brick })
		local glass = ball(f, Vector3.new(6, 6, 6) * s, p + Vector3.new(0, h + 16 * s, 0), Color3.fromRGB(255, 210, 60), { material = Enum.Material.Neon })
		light(glass, Color3.fromRGB(255, 220, 120), 30, 1.5)
	end,
}

-- ============================================================ portal and castle

local function portal(parent: Instance, pos: Vector3, yaw: number)
	local m = Instance.new("Model")
	m.Name = "Portal"
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local stone = Color3.fromRGB(70, 45, 100)
	for i = -1, 1, 2 do
		part(m, Vector3.new(3, 18, 3), cf * CFrame.new(i * 8, 9, 0), stone, { material = Enum.Material.Slate, collide = true })
		local orb = ball(m, Vector3.new(2.4, 2.4, 2.4), (cf * CFrame.new(i * 8, 19, 0)).Position, Color3.fromRGB(190, 90, 255), { material = Enum.Material.Neon })
		light(orb, Color3.fromRGB(190, 100, 255), 16, 2)
	end
	part(m, Vector3.new(20, 3, 3), cf * CFrame.new(0, 18, 0), stone, { material = Enum.Material.Slate })
	local swirl = part(m, Vector3.new(13, 15, 0.6), cf * CFrame.new(0, 8.5, 0), Color3.fromRGB(140, 50, 240), { material = Enum.Material.Neon, transparency = 0.25 })
	emitter(swirl, SPARKLE, Color3.fromRGB(220, 160, 255), { Rate = 25, Speed = NumberRange.new(2, 6), SpreadAngle = Vector2.new(60, 60), Size = NumberSequence.new(1.5, 0) })
	light(swirl, Color3.fromRGB(160, 80, 255), 30, 3)
	m.Parent = parent
end

local function castle(parent: Instance, pos: Vector3, yaw: number)
	local m = Instance.new("Model")
	m.Name = "Castle"
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local wall = Color3.fromRGB(245, 238, 225)
	local roof = Color3.fromRGB(220, 50, 55)
	local gold = Color3.fromRGB(255, 205, 50)
	part(m, Vector3.new(24, 16, 16), cf * CFrame.new(0, 8, 8), wall, { material = Enum.Material.Brick, collide = true })
	for x = -10, 10, 4 do
		part(m, Vector3.new(2, 2.4, 16), cf * CFrame.new(x, 17.2, 8), wall, { material = Enum.Material.Brick })
	end
	for _, x in { -14, 14 } do
		pillar(m, 24, 8, (cf * CFrame.new(x, 0, 8)).Position, wall, { material = Enum.Material.Brick, collide = true })
		for i = 0, 3 do
			local w = 9 - i * 2.2
			part(m, Vector3.new(w, 2.2, w), cf * CFrame.new(x, 25 + i * 2.1, 8) * CFrame.Angles(0, math.rad(45), 0), roof)
		end
		local orb = ball(m, Vector3.new(1.4, 1.4, 1.4), (cf * CFrame.new(x, 34, 8)).Position, gold, { material = Enum.Material.Neon })
		light(orb, gold, 10, 1)
	end
	-- the keep
	part(m, Vector3.new(12, 10, 10), cf * CFrame.new(0, 21, 10), wall, { material = Enum.Material.Brick })
	for i = 0, 4 do
		local w = 13 - i * 2.6
		part(m, Vector3.new(w, 2.4, w), cf * CFrame.new(0, 27.2 + i * 2.3, 10) * CFrame.Angles(0, math.rad(45), 0), roof)
	end
	local star = part(m, Vector3.new(4, 4, 0.8), cf * CFrame.new(0, 42, 10) * CFrame.Angles(0, 0, math.rad(45)), gold, { material = Enum.Material.Neon })
	light(star, gold, 30, 2)
	emitter(star, SPARKLE, gold, { Rate = 8 })
	-- gate and windows
	part(m, Vector3.new(7, 10, 0.6), cf * CFrame.new(0, 5, -0.1), Color3.fromRGB(110, 65, 35), { material = Enum.Material.Wood })
	part(m, Vector3.new(8, 1, 0.8), cf * CFrame.new(0, 10.3, -0.15), gold, { material = Enum.Material.Metal })
	for _, x in { -7, 7 } do
		part(m, Vector3.new(2.4, 3.6, 0.4), cf * CFrame.new(x, 11, -0.1), Color3.fromRGB(80, 170, 255), { material = Enum.Material.Neon, transparency = 0.2 })
	end
	m.Parent = parent
end

-- ============================================================ build

local function nearPath(waypoints: { { number } }, x: number, z: number, margin: number): boolean
	for i = 1, #waypoints - 1 do
		local a, b = waypoints[i], waypoints[i + 1]
		local dx, dz = b[1] - a[1], b[2] - a[2]
		local len2 = dx * dx + dz * dz
		local t = math.clamp(((x - a[1]) * dx + (z - a[2]) * dz) / len2, 0, 1)
		local px, pz = a[1] + dx * t - x, a[2] + dz * t - z
		if px * px + pz * pz < margin * margin then
			return true
		end
	end
	return false
end

-- returns the arena model and the world-space path points
function MapBuilder.build(def: Maps.MapDef, origin: Vector3, seed: number): (Model, { Vector3 })
	local theme = def.theme
	local rng = Random.new(seed)
	local arena = Instance.new("Model")
	arena.Name = "Arena_" .. def.id
	local half = Maps.FieldHalf

	-- the play field: tiles (the ground units are placed on) with a little colour variation
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	ground.Parent = arena
	local tile = 30
	local n = math.floor(half * 2 / tile)
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			local x = -half + tile * (i + 0.5)
			local z = -half + tile * (j + 0.5)
			local c
			if def.id == "starcastle" then
				c = (i + j) % 2 == 0 and theme.ground or theme.grass2
			else
				c = theme.ground:Lerp(theme.grass2, ((i + j) % 2) * 0.5 + rng:NextNumber(0, 0.25))
			end
			part(ground, Vector3.new(tile, 4, tile), CFrame.new(origin + Vector3.new(x, -2, z)), c, { material = theme.groundMaterial, collide = true, query = true, shadow = false })
		end
	end
	-- the field's edge and the cliff under it
	for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local along = side[1] == 0
		local size = along and Vector3.new(half * 2 + 6, 1.2, 3) or Vector3.new(3, 1.2, half * 2 + 6)
		part(arena, size, CFrame.new(origin + Vector3.new(side[1] * (half + 1.5), 0.6, side[2] * (half + 1.5))), theme.curb, { material = Enum.Material.Cobblestone, collide = true })
	end
	part(arena, Vector3.new(half * 2 + 6, 14, half * 2 + 6), CFrame.new(origin + Vector3.new(0, -11, 0)), shade(theme.ground, -0.45), { material = Enum.Material.Rock, collide = true })

	-- the world around it
	local world = Instance.new("Folder")
	world.Name = "Scenery"
	world.Parent = arena
	part(world, Vector3.new(1100, 4, 1100), CFrame.new(origin + Vector3.new(0, -16, 0)), shade(theme.grass2, -0.15), { material = theme.groundMaterial, shadow = false, collide = true })
	local makeScenery = scenery[def.id]
	for i = 1, 26 do
		local a = i / 26 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local r = rng:NextNumber(200, 420)
		makeScenery(world, origin + Vector3.new(math.cos(a) * r, -14, math.sin(a) * r), rng:NextNumber(0.8, 1.4), rng)
	end
	if def.id == "meadow" or def.id == "desert" or def.id == "frost" then
		for _ = 1, 14 do
			local p = origin + Vector3.new(rng:NextNumber(-450, 450), rng:NextNumber(70, 110), rng:NextNumber(-450, 450))
			for k = 1, 3 do
				ball(world, Vector3.new(26, 14, 18) * rng:NextNumber(0.7, 1.2), p + Vector3.new(k * 12, rng:NextNumber(-2, 3), rng:NextNumber(-4, 4)), WHITE, { shadow = false, transparency = 0.05 })
			end
		end
	end

	-- the path: a road with curbs on both sides and round joints at the corners
	local points: { Vector3 } = {}
	for _, wp in def.waypoints do
		table.insert(points, origin + Vector3.new(wp[1], 0, wp[2]))
	end
	local pathFolder = Instance.new("Folder")
	pathFolder.Name = "Path"
	pathFolder.Parent = arena
	local w = Maps.PathWidth
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b)
		part(pathFolder, Vector3.new(w, 0.3, len), cf + Vector3.new(0, 0.12, 0), theme.path, { material = theme.pathMaterial, shadow = false })
		local startTrim = i > 1 and w / 2 or 0
		local endTrim = i < #points - 1 and w / 2 or 0
		local curbLen = math.max(1, len - startTrim - endTrim)
		local curbMid = (startTrim - endTrim) / 2 -- shift toward the untrimmed end (local -Z points at b)
		for _, sideX in { -1, 1 } do
			part(pathFolder, Vector3.new(1.2, 0.7, curbLen), cf * CFrame.new(sideX * (w / 2 + 0.6), 0.3, -curbMid), theme.curb, { material = Enum.Material.Cobblestone, collide = true })
		end
		-- stepping stones across the road
		for d = 3, len - 3, 7 do
			local stone = cf * CFrame.new(rng:NextNumber(-w / 4, w / 4), 0.3, -len / 2 + d)
			part(pathFolder, Vector3.new(rng:NextNumber(1.6, 2.6), 0.12, rng:NextNumber(1.6, 2.6)), stone * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), shade(theme.path, -0.12), { material = theme.pathMaterial, shadow = false })
		end
	end
	-- square road tiles fill the corners, with a curb post on the outside corner
	for i = 2, #points - 1 do
		local inDir = (points[i] - points[i - 1]).Unit
		local outDir = (points[i + 1] - points[i]).Unit
		part(pathFolder, Vector3.new(w + 0.2, 0.32, w + 0.2), CFrame.lookAt(points[i], points[i] + outDir) + Vector3.new(0, 0.13, 0), theme.path, { material = theme.pathMaterial, shadow = false })
		local corner = points[i] + (inDir - outDir) * (w / 2 + 0.6)
		part(pathFolder, Vector3.new(1.6, 1, 1.6), CFrame.new(corner + Vector3.new(0, 0.5, 0)), theme.curb, { material = Enum.Material.Cobblestone, collide = true })
	end

	-- decorations on the field, off the path, more of them toward the edges so the middle stays buildable
	local decoFolder = Instance.new("Folder")
	decoFolder.Name = "Decor"
	decoFolder.Parent = arena
	local choices = fieldDecor[def.id]
	local total = 0
	for _, c in choices do
		total += c[2]
	end
	local placed, tries = 0, 0
	while placed < 60 and tries < 900 do
		tries += 1
		local x = rng:NextNumber(-half + 5, half - 5)
		local z = rng:NextNumber(-half + 5, half - 5)
		local edge = math.max(math.abs(x), math.abs(z)) > half - 26
		if not nearPath(def.waypoints, x, z, edge and 12 or 22) and (edge or rng:NextNumber() < 0.25) then
			local roll = rng:NextNumber() * total
			for _, c in choices do
				roll -= c[2]
				if roll <= 0 then
					decor[c[1]](decoFolder, origin + Vector3.new(x, 0, z), rng:NextNumber(c[3], c[4]), rng)
					break
				end
			end
			placed += 1
		end
	end

	local first, second = points[1], points[2]
	local last, beforeLast = points[#points], points[#points - 1]
	local startDir = (second - first).Unit
	local endDir = (last - beforeLast).Unit
	portal(arena, first - startDir * 2, math.atan2(startDir.X, startDir.Z))
	castle(arena, last + endDir * 3, math.atan2(endDir.X, endDir.Z))

	arena.Parent = workspace
	return arena, points
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">BattleUI</string>
            <string name="Source"><![CDATA[-- The battle HUD: boss bar, wave counter and countdown ring, castle health, cash, the unit hotbar, placing units,
-- the selected-unit panel (Upgrade T, Sell X, Target R) and the victory/defeat screen.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Shared = game.ReplicatedStorage.Shared
local Units = require(Shared.Units)
local Traits = require(Shared.Traits)
local Rarities = require(Shared.Rarities)
local Maps = require(Shared.Maps)
local Stats = require(Shared.Stats)
local ModelFactory = require(Shared.ModelFactory)
local Net = require(Shared.Net)

local Ui = require(script.Parent.Ui)
local Store = require(script.Parent.Store)

local BattleUI = {}

local C = Ui.Colors
local player = Players.LocalPlayer
local gui: ScreenGui

local waveLabel: TextLabel
local timerLabel: TextLabel
local timerRing: Frame
local statusLabel: TextLabel
local cashLabel: TextLabel
local hpFill: Frame
local hpLabel: TextLabel
local bossFrame: Frame
local bossName: TextLabel
local bossFill: Frame
local bossHp: TextLabel
local speedButton: TextButton
local skipButton: TextButton
local hotbar: Frame
local infoPanel: Frame
local endPanel: Frame

local placingSlot: number? = nil
local ghost: Model? = nil
local ghostRange: Part? = nil
local selectedTower: Model? = nil
local selectedRange: Part? = nil
local leaving = false
local hotbarKey = ""
local lastCash = 0

local TARGET_MODES = { "First", "Last", "Strongest", "Closest" }

local defaultLighting = {
	ClockTime = Lighting.ClockTime,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	FogColor = Lighting.FogColor,
	FogEnd = Lighting.FogEnd,
}

local function arena(): Model?
	local state = Store.battle
	if not state.active then
		return nil
	end
	return workspace:FindFirstChild("Arena_" .. state.mapId) :: Model?
end

local function towerFolder(): Instance?
	local a = arena()
	return a and a:FindFirstChild("Units")
end

-- ============================================================ range circles

local function rangeDisc(radius: number, color: Color3): Part
	local disc = Instance.new("Part")
	disc.Name = "Range"
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Material = Enum.Material.ForceField
	disc.Color = color
	disc.Size = Vector3.new(0.4, radius * 2, radius * 2)
	disc.Parent = workspace
	return disc
end

local function placeDisc(disc: Part, pos: Vector3)
	disc.CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
end

-- ============================================================ placement

local function cancelPlacement()
	placingSlot = nil
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if ghostRange then
		ghostRange:Destroy()
		ghostRange = nil
	end
end

local function deselect()
	selectedTower = nil
	if selectedRange then
		selectedRange:Destroy()
		selectedRange = nil
	end
	infoPanel.Visible = false
end

local function memberUnit(m): { [string]: any }
	return { l = m.level, g = m.grades }
end

local function startPlacement(slot: number)
	local member = Store.battle.team and Store.battle.team[slot]
	if not member then
		return
	end
	if not member.allowed then
		Ui.toast("That unit is not allowed in this challenge", C.red)
		return
	end
	cancelPlacement()
	deselect()
	placingSlot = slot
	local model = ModelFactory.build(member.unitId, 1, true)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanCollide = false
			if d.Transparency < 1 then
				d.Transparency = 0.35
			end
		end
	end
	model.Parent = workspace
	ghost = model
	local s = Stats.compute(member.unitId, 0, member.trait, nil, memberUnit(member))
	ghostRange = rangeDisc(math.max(s.range, 2), C.green)
end

local function groundHit(): RaycastResult?
	local a = arena()
	local ground = a and a:FindFirstChild("Ground")
	if not ground then
		return nil
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ground }
	return workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
end

local function placementProblem(pos: Vector3): string?
	local state = Store.battle
	local map = Maps.ById[state.mapId]
	local others = {}
	local folder = towerFolder()
	if folder then
		for _, m in folder:GetChildren() do
			if m:IsA("Model") then
				table.insert(others, m:GetPivot().Position - state.origin)
			end
		end
	end
	local x, z = pos.X - state.origin.X, pos.Z - state.origin.Z
	return Stats.placementProblem(map.waypoints, Maps.FieldHalf, Maps.PathWidth, x, z, others)
end

local function updateGhost()
	if not ghost or not ghostRange then
		return
	end
	local hit = groundHit()
	if not hit then
		ghost:PivotTo(CFrame.new(0, -500, 0))
		placeDisc(ghostRange, Vector3.new(0, -500, 0))
		return
	end
	local pos = Vector3.new(hit.Position.X, Store.battle.origin.Y, hit.Position.Z)
	ghost:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.pi, 0))
	placeDisc(ghostRange, pos)
	ghostRange.Color = placementProblem(pos) and C.red or C.green
end

local function tryPlace()
	if not placingSlot then
		return
	end
	local hit = groundHit()
	if not hit then
		return
	end
	local pos = Vector3.new(hit.Position.X, Store.battle.origin.Y, hit.Position.Z)
	local problem = placementProblem(pos)
	if problem then
		Ui.toast(problem, C.red)
		return
	end
	local ok, err = Store.call("PlaceUnit", placingSlot, pos)
	if not ok then
		Ui.toast(err or "Can't place there", C.red)
		return
	end
	-- hold Shift to keep placing the same unit
	if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
		cancelPlacement()
	end
end

-- ============================================================ selected unit panel

local refreshInfo: () -> ()

local function towerUnit(model: Model): { [string]: any }
	local raw = model:GetAttribute("Grades")
	local grades = string.split(type(raw) == "string" and raw or "A,A,A", ",")
	return { l = model:GetAttribute("UnitLevel") or 1, g = { d = grades[1], s = grades[2], r = grades[3] } }
end

local function upgradeSelected()
	if not selectedTower then
		return
	end
	local ok, err = Store.call("UpgradeTower", selectedTower:GetAttribute("TowerId"))
	if not ok then
		Ui.toast(err or "Can't upgrade", C.red)
	end
	task.wait(0.1)
	refreshInfo()
end

local function sellSelected()
	if not selectedTower then
		return
	end
	Store.call("SellTower", selectedTower:GetAttribute("TowerId"))
	deselect()
end

local function cycleTarget()
	if not selectedTower then
		return
	end
	local current = selectedTower:GetAttribute("Targeting") or "First"
	local nextMode = TARGET_MODES[(table.find(TARGET_MODES, current) or 0) % #TARGET_MODES + 1]
	Store.call("SetTargeting", selectedTower:GetAttribute("TowerId"), nextMode)
	task.wait(0.1)
	refreshInfo()
end

function refreshInfo()
	local model = selectedTower
	if not model or not model.Parent then
		deselect()
		return
	end
	local unitId = model:GetAttribute("UnitId")
	local def = Units.ById[unitId]
	local level = model:GetAttribute("Level") or 0
	local traitId = model:GetAttribute("Trait")
	if traitId == "" then
		traitId = nil
	end
	local unit = towerUnit(model)
	local buffs = { damage = model:GetAttribute("DamageBuff") or 0, hitsAir = model:GetAttribute("AirBuff") == true }
	local s = Stats.compute(unitId, level, traitId, buffs, unit)
	local spent = model:GetAttribute("Spent") or 0
	local targeting = model:GetAttribute("Targeting") or "First"
	infoPanel:SetAttribute("Level", level)

	Ui.clear(infoPanel)
	infoPanel.Visible = true
	local color = Rarities.Info[def.rarity].color
	-- header: portrait, name, rarity / trait chips
	local portrait = Ui.new("Frame", {
		Size = UDim2.fromOffset(96, 96),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = infoPanel,
	}, { Ui.corner(12), Ui.stroke(C.ink, 3), Ui.gradient(Ui.RarityGradient[def.rarity][1], Ui.RarityGradient[def.rarity][2]) })
	Ui.viewport(unitId, { Size = UDim2.fromScale(1, 1) }).Parent = portrait
	Ui.text({ Text = "Lvl " .. unit.l, Size = UDim2.fromOffset(60, 18), Position = UDim2.fromOffset(4, 3), MaxText = 15, ZIndex = 3, Parent = portrait })
	Ui.title({ Text = Ui.unitName(unitId), Size = UDim2.new(1, -106, 0, 30), Position = UDim2.fromOffset(106, 0), MaxText = 26, Parent = infoPanel })
	Ui.chip(def.rarity, color, { Size = UDim2.fromOffset(100, 22), Position = UDim2.fromOffset(106, 34), Parent = infoPanel })
	local trait = traitId and Traits.ById[traitId]
	Ui.chip(trait and trait.name or "No trait", trait and Rarities.Info[trait.rarity].color or C.panel, { Size = UDim2.fromOffset(118, 22), Position = UDim2.fromOffset(212, 34), Parent = infoPanel })
	Ui.text({
		Text = string.rep("★", level) .. string.rep("☆", Units.MaxLevel - level),
		Size = UDim2.new(1, -106, 0, 26),
		Position = UDim2.fromOffset(106, 62),
		TextColor3 = C.gold,
		MaxText = 24,
		Parent = infoPanel,
	})

	-- stats
	local rows = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 104), BackgroundTransparency = 1, Parent = infoPanel }, { Ui.list(Enum.FillDirection.Vertical, 6) })
	if def.attack.kind ~= "none" then
		local top = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = rows }, { Ui.list(Enum.FillDirection.Horizontal, 6) })
		Ui.statChip("DMG", Ui.short(s.damage), unit.g.d, C.red, { Size = UDim2.fromOffset(106, 46), Parent = top })
		Ui.statChip("SPA", string.format("%.2fs", s.cooldown), unit.g.s, C.blue, { Size = UDim2.fromOffset(106, 46), Parent = top })
		Ui.statChip("RNG", string.format("%.1f", s.range), unit.g.r, C.gold, { Size = UDim2.fromOffset(106, 46), Parent = top })
		local extra = {}
		table.insert(extra, (s.hitsGround and "Ground" or "") .. (s.hitsGround and s.hitsAir and " + " or "") .. (s.hitsAir and "Air" or ""))
		if buffs.damage > 0 then
			table.insert(extra, string.format("+%d%% aura", buffs.damage * 100))
		end
		if s.farm > 0 then
			table.insert(extra, string.format("$%d/wave", s.farm))
		end
		Ui.text({ Text = table.concat(extra, "  •  "), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.muted, MaxText = 15, Parent = rows })
	else
		Ui.statChip("FARM", "$" .. math.floor(s.farm) .. " per wave", nil, C.gold, { Size = UDim2.new(1, 0, 0, 46), Parent = rows })
	end

	-- actions
	if level < Units.MaxLevel then
		local cost = Stats.upgradeCost(unitId, level, traitId)
		local up = Ui.button(string.format("[T] Upgrade %d/%d   $%s", level, Units.MaxLevel, Ui.formatNumber(cost)), Store.battle.cash >= cost and C.green or C.panel, upgradeSelected, {
			Size = UDim2.new(1, 0, 0, 46),
			Position = UDim2.fromOffset(0, 212),
			MaxText = 20,
			Parent = infoPanel,
		})
		up.Name = "Upgrade"
		up:SetAttribute("Cost", cost)
	else
		Ui.button("Upgrade MAXED", C.panel, function() end, { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 212), Parent = infoPanel })
	end
	if def.attack.kind ~= "none" then
		Ui.button("[R] Target: " .. targeting, C.blue, cycleTarget, { Size = UDim2.new(0.5, -4, 0, 42), Position = UDim2.fromOffset(0, 264), MaxText = 18, Parent = infoPanel })
	end
	Ui.button("[X] Sell $" .. Ui.formatNumber(math.floor(spent * 0.6)), C.red, sellSelected, {
		Size = UDim2.new(def.attack.kind ~= "none" and 0.5 or 1, def.attack.kind ~= "none" and -4 or 0, 0, 42),
		Position = def.attack.kind ~= "none" and UDim2.new(0.5, 4, 0, 264) or UDim2.fromOffset(0, 264),
		MaxText = 18,
		Parent = infoPanel,
	})

	if selectedRange then
		selectedRange:Destroy()
	end
	local disc = rangeDisc(math.max(s.range, 2), color)
	placeDisc(disc, model:GetPivot().Position)
	selectedRange = disc
end

local function trySelect()
	local folder = towerFolder()
	if not folder then
		return
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	local model = hit and hit.Instance:FindFirstAncestorWhichIsA("Model")
	while model and model.Parent ~= folder do
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	if model then
		selectedTower = model
		refreshInfo()
	end
end

-- ============================================================ HUD

local function refreshHotbar(state)
	-- rebuild only when the team or what is allowed changes; prices and counts update in place
	local key = ""
	for i = 1, Units.TeamSize do
		local m = state.team[i]
		key ..= (m and (m.unitId .. tostring(m.allowed)) or "-") .. ","
	end
	if key ~= hotbarKey then
		hotbarKey = key
		Ui.clear(hotbar)
		for i = 1, Units.TeamSize do
			local m = state.team[i]
			local holder = Ui.new("Frame", { Name = "Slot" .. i, Size = UDim2.fromOffset(98, 130), BackgroundTransparency = 1, LayoutOrder = i, Parent = hotbar })
			if m then
				local card = Ui.unitCard(holder, { unitId = m.unitId, level = m.level, trait = m.trait, price = m.cost, dim = not m.allowed }, UDim2.fromOffset(98, 112), function()
					if placingSlot == i then
						cancelPlacement()
					else
						startPlacement(i)
					end
				end)
				card.Name = "Card"
				Ui.chip(tostring(i), C.panel, { Size = UDim2.fromOffset(24, 22), Position = UDim2.new(1, -18, 1, -16), ZIndex = 8, Parent = card })
				Ui.text({ Name = "Count", Text = "", Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.muted, MaxText = 14, Parent = holder })
			else
				Ui.new("Frame", { Size = UDim2.fromOffset(98, 112), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.4, Parent = holder }, { Ui.corner(12), Ui.stroke(Color3.fromRGB(90, 76, 160), 2) })
			end
		end
	end
	for i = 1, Units.TeamSize do
		local m = state.team[i]
		local holder = hotbar:FindFirstChild("Slot" .. i)
		if m and holder and holder:FindFirstChild("Count") then
			local def = Units.ById[m.unitId]
			holder.Count.Text = m.allowed and (m.placed .. "/" .. def.limit .. (state.cash < m.cost and "  need $" .. Ui.formatNumber(m.cost - state.cash) or "")) or "not allowed"
			holder.Count.TextColor3 = state.cash >= m.cost and C.muted or Color3.fromRGB(255, 120, 120)
			local stroke = holder.Card:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = placingSlot == i and Color3.new(1, 1, 1) or C.ink
				stroke.Thickness = placingSlot == i and 4 or 3
			end
		end
	end
end

local function applyLighting(mapId: string?)
	for _, name in { "SkMapAtmosphere", "SkMapColor", "SkMapBloom", "SkMapSunRays" } do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	if not mapId then
		for k, v in defaultLighting do
			(Lighting :: any)[k] = v
		end
		return
	end
	local theme = Maps.ById[mapId].theme
	Lighting.ClockTime = theme.clock
	Lighting.Ambient = theme.ambient
	Lighting.OutdoorAmbient = theme.ambient
	Lighting.FogColor = theme.fog
	Lighting.FogEnd = 100000
	local atmo = Instance.new("Atmosphere")
	atmo.Name = "SkMapAtmosphere"
	atmo.Density = theme.atmosphere.density
	atmo.Color = theme.atmosphere.color
	atmo.Decay = theme.atmosphere.decay
	atmo.Haze = theme.atmosphere.haze
	atmo.Glare = 0.2
	atmo.Offset = 0.1
	atmo.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SkMapColor"
	cc.Saturation = theme.saturation
	cc.Contrast = 0.08
	cc.TintColor = theme.tint
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "SkMapBloom"
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "SkMapSunRays"
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

local function bumpCash(cash: number)
	if cash > lastCash then
		local box = cashLabel.Parent :: Instance
		local s = box:FindFirstChild("Bump") or Ui.new("UIScale", { Name = "Bump", Parent = box })
		s.Scale = 1.12
		TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	lastCash = cash
end

local wasActive = false
local function onState(state)
	if not state.active then
		if wasActive then
			wasActive = false
			cancelPlacement()
			deselect()
			applyLighting(nil)
			endPanel.Visible = false
			hotbarKey = ""
		end
		gui.Enabled = false
		return
	end
	if not wasActive then
		wasActive = true
		leaving = false
		endPanel.Visible = false
		lastCash = state.cash
		applyLighting(state.mapId)
	end
	gui.Enabled = true
	waveLabel.Text = string.format("WAVE %d/%d", state.wave, state.waves)
	local showTimer = state.state == "prep" or (state.state == "wave" and not state.lastWave)
	timerRing.Visible = showTimer
	timerLabel.Text = tostring(state.timer) .. "s"
	if state.state == "prep" then
		statusLabel.Text = "Place your units!"
	elseif state.state == "wave" then
		statusLabel.Text = state.enemies .. " enemies" .. (state.lastWave and "  •  FINAL WAVE" or "")
	elseif state.state == "won" then
		statusLabel.Text = "Victory!"
	else
		statusLabel.Text = "Defeat"
	end
	if state.maxUnits then
		statusLabel.Text ..= string.format("  •  units %d/%d", state.units, state.maxUnits)
	end
	cashLabel.Text = "$" .. Ui.formatNumber(state.cash)
	bumpCash(state.cash)
	local hpFrac = math.clamp(state.baseHp / state.maxBaseHp, 0, 1)
	hpFill.Size = UDim2.fromScale(hpFrac, 1)
	hpLabel.Text = "🏰 " .. state.baseHp .. " / " .. state.maxBaseHp
	speedButton.Text = "⏩ " .. state.speed .. "x"
	skipButton.Visible = state.state == "prep" or state.canSkip
	skipButton.Text = state.state == "prep" and "START" or "SKIP WAVE"

	if state.boss then
		bossFrame.Visible = true
		bossName.Text = ModelFactory.displayName(state.boss.id, state.boss.name) .. (state.boss.immune and "  🛡" or "")
		bossFill.Size = UDim2.fromScale(math.clamp(state.boss.hp / state.boss.maxHp, 0, 1), 1)
		bossHp.Text = string.format("%s / %s (%d%%)", Ui.short(state.boss.hp), Ui.short(state.boss.maxHp), math.floor(state.boss.hp / state.boss.maxHp * 100 + 0.5))
	else
		bossFrame.Visible = false
	end

	refreshHotbar(state)
	if selectedTower and infoPanel.Visible then
		local level = selectedTower:GetAttribute("Level")
		local up = infoPanel:FindFirstChild("Upgrade")
		if level ~= infoPanel:GetAttribute("Level") then
			refreshInfo()
		elseif up then
			Ui.setButtonColor(up, state.cash >= (up:GetAttribute("Cost") or 0) and C.green or C.panel)
		end
	end
end

local function showEnd(result)
	if leaving then
		return
	end
	cancelPlacement()
	deselect()
	Ui.clear(endPanel)
	endPanel.Visible = true
	Ui.pop(endPanel)
	local won = result.won
	local banner = Ui.title({
		Text = won and "VICTORY!" or "DEFEAT",
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.fromOffset(0, -6),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = won and C.gold or C.red,
		MaxText = 64,
		Outline = 3,
		Parent = endPanel,
	})
	if won then
		Ui.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 170)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 190, 40)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 250, 170)),
			}),
			Rotation = 90,
			Parent = banner,
		})
	end
	Ui.text({
		Text = string.format("Waves cleared: %d / %d%s", won and result.waves or math.max(0, result.wave - 1), result.waves, result.challenge and ("  •  " .. result.challenge) or ""),
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 70),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.muted,
		MaxText = 20,
		Parent = endPanel,
	})
	local rewards = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 106), BackgroundTransparency = 1, Parent = endPanel }, { Ui.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	Ui.chip("💎 +" .. result.gems, C.blue, { Size = UDim2.fromOffset(130, 36), Parent = rewards })
	if result.crystals > 0 then
		Ui.chip("🔮 +" .. result.crystals, C.crystal, { Size = UDim2.fromOffset(120, 36), Parent = rewards })
	end
	if (result.xp or 0) > 0 then
		Ui.chip("⭐ +" .. result.xp .. " XP", C.gold, { Size = UDim2.fromOffset(140, 36), Parent = rewards })
	end
	local lines = {}
	if result.firstClear then
		table.insert(lines, "First clear bonus!")
	end
	if result.unlocked then
		table.insert(lines, "New map unlocked: " .. result.unlocked)
	end
	for _, lu in result.levelUps or {} do
		table.insert(lines, Ui.unitName(lu.unitId) .. " reached Lvl " .. lu.level .. "!")
	end
	Ui.text({
		Text = table.concat(lines, "\n"),
		Size = UDim2.new(1, -20, 0, 100),
		Position = UDim2.fromOffset(10, 156),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.gold,
		MaxText = 20,
		Parent = endPanel,
	})
	local back = Ui.button("BACK TO LOBBY", C.green, function()
		leaving = true
		Store.call("LeaveBattle")
	end, { Size = UDim2.fromOffset(260, 60), Position = UDim2.new(0.5, 0, 1, -68), AnchorPoint = Vector2.new(0.5, 0), MaxText = 28, Parent = endPanel })
	back.Font = Ui.TitleFont
end

local function buildHud()
	gui = Ui.new("ScreenGui", {
		Name = "Battle",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Ui.new("UIScale", { Name = "Scale", Parent = gui })

	-- top centre: boss bar (only while a boss is alive) above the wave bar
	local top = Ui.new("Frame", { Size = UDim2.fromOffset(720, 150), Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui })
	bossFrame = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Visible = false, Parent = top })
	local skull = Ui.new("Frame", { Size = UDim2.fromOffset(52, 52), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3, Parent = bossFrame }, { Ui.round(), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(255, 90, 90), Color3.fromRGB(140, 10, 30)) })
	Ui.text({ Text = "👑", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 30, Outline = 0, ZIndex = 4, Parent = skull })
	bossName = Ui.title({ Text = "", Size = UDim2.new(0.5, 0, 0, 24), Position = UDim2.fromOffset(60, 0), MaxText = 22, Parent = bossFrame })
	bossHp = Ui.text({ Text = "", Size = UDim2.new(0.5, -60, 0, 22), Position = UDim2.new(0.5, 0, 0, 1), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(255, 210, 120), MaxText = 18, Parent = bossFrame })
	local _, fill = Ui.bar(bossFrame, { Size = UDim2.new(1, -60, 0, 20), Position = UDim2.fromOffset(56, 28) }, Color3.fromRGB(255, 140, 30), 1)
	bossFill = fill

	local waveBar = Ui.new("Frame", {
		Size = UDim2.fromOffset(520, 76),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = top,
	}, { Ui.corner(16), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(60, 48, 112), Color3.fromRGB(26, 20, 52)) })
	waveLabel = Ui.title({ Text = "", Size = UDim2.fromOffset(200, 34), Position = UDim2.fromOffset(14, 6), MaxText = 30, Parent = waveBar })
	statusLabel = Ui.text({ Text = "", Size = UDim2.new(1, -110, 0, 20), Position = UDim2.fromOffset(16, 42), TextColor3 = C.muted, MaxText = 16, Parent = waveBar })
	local hpBack = Ui.new("Frame", { Size = UDim2.fromOffset(200, 26), Position = UDim2.fromOffset(222, 10), BackgroundColor3 = Color3.fromRGB(60, 20, 30), Parent = waveBar }, { Ui.round(), Ui.stroke(C.ink, 2) })
	hpFill = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = hpBack }, { Ui.round(), Ui.gradient(Color3.fromRGB(120, 240, 120), Color3.fromRGB(30, 160, 60)) })
	hpLabel = Ui.text({ Text = "", Size = UDim2.new(1, 0, 1, -4), Position = UDim2.fromOffset(0, 2), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 16, ZIndex = 2, Parent = hpBack })
	-- the countdown ring to the next wave
	timerRing = Ui.new("Frame", {
		Size = UDim2.fromOffset(64, 64),
		Position = UDim2.new(1, -72, 0, 6),
		BackgroundColor3 = Color3.fromRGB(30, 24, 60),
		Parent = waveBar,
	}, { Ui.round() })
	local ringStroke = Ui.new("UIStroke", { Thickness = 5, Color = Color3.new(1, 1, 1), Parent = timerRing })
	Ui.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(120, 230, 255), Color3.fromRGB(40, 120, 255)), Parent = ringStroke })
	timerLabel = Ui.title({ Text = "", Size = UDim2.new(1, -10, 1, -16), Position = UDim2.fromOffset(5, 8), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 26, Parent = timerRing })

	-- right: skip / speed / leave
	local controls = Ui.new("Frame", {
		Size = UDim2.fromOffset(170, 170),
		Position = UDim2.new(1, -14, 0, 14),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right) })
	skipButton = Ui.button("SKIP WAVE", C.green, function()
		Store.call("StartWave")
	end, { Size = UDim2.fromOffset(170, 48), LayoutOrder = 1, MaxText = 22, Parent = controls })
	skipButton.Font = Ui.TitleFont
	speedButton = Ui.button("⏩ 1x", C.blue, function()
		Store.call("SetSpeed", (Store.battle.speed % 3) + 1)
	end, { Size = UDim2.fromOffset(170, 44), LayoutOrder = 2, Parent = controls })
	local leaveConfirm = false
	local leaveButton
	leaveButton = Ui.button("Leave", C.red, function()
		if Store.battle.state ~= "won" and Store.battle.state ~= "lost" and not leaveConfirm then
			leaveConfirm = true
			leaveButton.Text = "Leave? (= loss)"
			task.delay(3, function()
				leaveConfirm = false
				leaveButton.Text = "Leave"
			end)
			return
		end
		leaving = true
		Store.call("LeaveBattle")
	end, { Size = UDim2.fromOffset(170, 40), LayoutOrder = 3, Parent = controls })

	-- bottom: cash above the hotbar
	local cashBox = Ui.new("Frame", { Size = UDim2.fromOffset(300, 54), Position = UDim2.new(0.5, 0, 1, -158), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui })
	local coin = Ui.new("Frame", { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(28, 5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = cashBox }, { Ui.round(), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(255, 240, 120), Color3.fromRGB(230, 150, 20)) })
	Ui.title({ Text = "$", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 30, Parent = coin })
	cashLabel = Ui.title({ Text = "", Size = UDim2.fromOffset(220, 50), Position = UDim2.fromOffset(80, 2), TextColor3 = Color3.fromRGB(255, 225, 90), MaxText = 44, Outline = 3, Parent = cashBox })

	hotbar = Ui.new("Frame", {
		Size = UDim2.fromOffset(6 * 104, 130),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom) })
	Ui.text({
		Text = "Click a unit or press 1-6, then click the ground  •  Shift keeps placing  •  Q cancels  •  click a placed unit to upgrade",
		Size = UDim2.fromOffset(820, 18),
		Position = UDim2.new(0.5, 0, 1, -210),
		AnchorPoint = Vector2.new(0.5, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		MaxText = 14,
		Parent = gui,
	})

	infoPanel = Ui.new("Frame", {
		Size = UDim2.fromOffset(356, 320),
		Position = UDim2.new(0, 14, 0.5, 10),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = gui,
	}, { Ui.corner(16), Ui.stroke(C.ink, 3), Ui.padding(12), Ui.gradient(C.bgTop, C.bgBottom) })

	endPanel = Ui.new("Frame", {
		Size = UDim2.fromOffset(520, 360),
		Position = UDim2.fromScale(0.5, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	}, { Ui.corner(20), Ui.padding(16), Ui.gradient(C.bgTop, C.bgBottom) })
	local border = Ui.new("UIStroke", { Thickness = 5, Color = Color3.new(1, 1, 1), Parent = endPanel })
	Ui.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 230, 110), Color3.fromRGB(240, 150, 30)), Rotation = 45, Parent = border })
end

function BattleUI.start()
	buildHud()
	Store.BattleChanged:Connect(onState)
	Net.ev("BattleEnded").OnClientEvent:Connect(showEnd)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not Store.battle.active then
			return
		end
		if input.KeyCode == Enum.KeyCode.Q or input.UserInputType == Enum.UserInputType.MouseButton2 then
			cancelPlacement()
			return
		end
		if processed then
			return
		end
		if selectedTower and infoPanel.Visible then
			if input.KeyCode == Enum.KeyCode.T then
				task.spawn(upgradeSelected)
				return
			elseif input.KeyCode == Enum.KeyCode.X then
				task.spawn(sellSelected)
				return
			elseif input.KeyCode == Enum.KeyCode.R then
				task.spawn(cycleTarget)
				return
			end
		end
		local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six }
		local slot = table.find(keys, input.KeyCode)
		if slot then
			if placingSlot == slot then
				cancelPlacement()
			else
				startPlacement(slot)
			end
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if placingSlot then
				tryPlace()
			else
				trySelect()
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if placingSlot then
			updateGhost()
		end
	end)
	return gui
end

return BattleUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- Attack and ability effects, drawn only on this client from the server's Fx events.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Net = require(game.ReplicatedStorage.Shared.Net)

local Fx = {}

local folder: Folder

local function neon(size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	return p
end

local function fade(part: BasePart, time: number, grow: Vector3?)
	local goal: { [string]: any } = { Transparency = 1 }
	if grow then
		goal.Size = grow
	end
	TweenService:Create(part, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(part, time + 0.05)
end

-- a flat disc that expands to `radius` and fades
local function ring(pos: Vector3, radius: number, color: Color3, time: number?)
	local disc = neon(Vector3.new(0.3, 1, 1), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.PartType.Cylinder)
	disc.Transparency = 0.35
	fade(disc, time or 0.35, Vector3.new(0.3, radius * 2, radius * 2))
end

local function burst(pos: Vector3, size: number, color: Color3)
	local ball = neon(Vector3.one * size * 0.4, CFrame.new(pos), color, Enum.PartType.Ball)
	ball.Transparency = 0.2
	fade(ball, 0.25, Vector3.one * size)
end

-- a projectile flying from `from` to `to`, with an optional arc, calling done on arrival
local function projectile(from: Vector3, to: Vector3, color: Color3, size: number, time: number, arc: number, done: (() -> ())?)
	local ball = neon(Vector3.one * size, CFrame.new(from), color, Enum.PartType.Ball)
	local t = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		t += dt / time
		if t >= 1 then
			conn:Disconnect()
			ball:Destroy()
			if done then
				done()
			end
			return
		end
		local p = from:Lerp(to, t) + Vector3.new(0, math.sin(t * math.pi) * arc, 0)
		ball.CFrame = CFrame.new(p)
	end)
end

local function beam(a: Vector3, b: Vector3, color: Color3, width: number, time: number)
	local len = (b - a).Magnitude
	if len < 0.1 then
		return
	end
	local part = neon(Vector3.new(width, width, len), CFrame.lookAt((a + b) / 2, b), color)
	part.Transparency = 0.1
	fade(part, time)
end

local function floatingText(pos: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(pos)
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 34)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(1.2), { CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.3)
end

-- a quick damage number that hops up from the target
local damageCount = 0
local function damageNumber(pos: Vector3, amount: number, color: Color3)
	if damageCount > 40 then
		return -- plenty on screen already
	end
	damageCount += 1
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	local start = pos + Vector3.new(math.random() * 2 - 1, 1, math.random() * 2 - 1)
	anchor.CFrame = CFrame.new(start)
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(70, 26)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.5)
	label.TextStrokeTransparency = 0
	label.Text = amount >= 1000 and string.format("%.1fk", amount / 1000) or tostring(amount)
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(start + Vector3.new(0, 3, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.75, function()
		anchor:Destroy()
		damageCount -= 1
	end)
end

local handlers: { [string]: (any) -> () } = {
	bolt = function(p)
		projectile(p.from, p.to, p.color, 0.6, 0.15, 0, function()
			burst(p.to, 1.5, p.color)
		end)
	end,
	bonk = function(p)
		burst(p.to, 2.5, p.color:Lerp(Color3.new(1, 1, 1), 0.4))
		ring(p.to - Vector3.new(0, 1.5, 0), 2, Color3.new(1, 1, 1), 0.2)
	end,
	lob = function(p)
		projectile(p.from, p.to, p.color, 1.1, 0.4, 5, function()
			burst(p.to, (p.radius or 4) * 1.2, Color3.fromRGB(255, 160, 40))
			ring(p.to - Vector3.new(0, 1.5, 0), p.radius or 4, p.color, 0.3)
		end)
	end,
	slam = function(p)
		ring(p.ground + Vector3.new(0, 0.3, 0), p.radius or 10, p.color, 0.45)
		ring(p.ground + Vector3.new(0, 0.4, 0), (p.radius or 10) * 0.6, Color3.new(1, 1, 1), 0.3)
	end,
	cone = function(p)
		local dir = (p.to - p.from)
		for i = 1, 7 do
			local spread = Vector3.new(math.random() - 0.5, (math.random() - 0.5) * 0.4, math.random() - 0.5) * dir.Magnitude * 0.5
			projectile(p.from, p.to + spread, i % 2 == 0 and Color3.fromRGB(255, 200, 40) or p.color, 1.4, 0.25 + i * 0.02, 0, nil)
		end
	end,
	zap = function(p)
		local points = { p.from }
		for _, c in p.chain or { p.to } do
			table.insert(points, c)
		end
		for i = 1, #points - 1 do
			beam(points[i], points[i + 1], p.color, 0.35, 0.18)
			burst(points[i + 1], 2, p.color)
		end
	end,
	pop = function(p)
		burst(p.to, p.boss and 12 or 3, p.color)
	end,
	summon = function(p)
		ring(p.to, p.radius or 8, p.color, 0.6)
	end,
	shock = function(p)
		ring(p.to, p.radius or 18, p.color, 0.7)
		ring(p.to + Vector3.new(0, 0.2, 0), (p.radius or 18) * 0.5, Color3.new(1, 1, 1), 0.5)
	end,
	shield = function(p)
		local bubble = neon(Vector3.one * (p.radius or 6) * 2, CFrame.new(p.to + Vector3.new(0, 3, 0)), p.color, Enum.PartType.Ball)
		bubble.Material = Enum.Material.ForceField
		fade(bubble, p.dur or 2)
	end,
	placed = function(p)
		ring(p.to, p.radius or 3, p.color, 0.4)
	end,
	leak = function(p)
		burst(p.to, 6, p.color)
		floatingText(p.to + Vector3.new(0, 4, 0), "OUCH!", p.color)
	end,
	cash = function(p)
		floatingText(p.to, "+$" .. tostring(p.amount or 0), p.color)
	end,
}

-- extra chain-lightning arcs from the Chain Reaction trait, on any attack style
local function chainArcs(p)
	if p.style ~= "zap" and p.chain then
		for i = 1, #p.chain - 1 do
			beam(p.chain[i], p.chain[i + 1], Color3.fromRGB(120, 220, 255), 0.25, 0.18)
		end
	end
end

function Fx.start()
	folder = Instance.new("Folder")
	folder.Name = "ClientFx"
	folder.Parent = workspace
	Net.ev("Fx").OnClientEvent:Connect(function(p)
		local handler = handlers[p.style]
		if handler then
			handler(p)
		end
		chainArcs(p)
		if p.dmg and p.to then
			damageNumber(p.to, p.dmg, p.color or Color3.new(1, 1, 1))
		end
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">LobbyUI</string>
            <string name="Source"><![CDATA[-- Lobby screens: menu tiles, currencies, the team tray and the Play / Summon / Units / Traits / Challenges windows,
-- plus the summon cinematic at the Summon Hall pedestal.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game.ReplicatedStorage.Shared
local Units = require(Shared.Units)
local Traits = require(Shared.Traits)
local Rarities = require(Shared.Rarities)
local Maps = require(Shared.Maps)
local Enemies = require(Shared.Enemies)
local Challenges = require(Shared.Challenges)
local Stats = require(Shared.Stats)
local Progression = require(Shared.Progression)
local ModelFactory = require(Shared.ModelFactory)

local Ui = require(script.Parent.Ui)
local Store = require(script.Parent.Store)

local LobbyUI = {}

local C = Ui.Colors
local gui: ScreenGui
local windows: { [string]: Frame } = {}
local refreshers: { [string]: () -> () } = {}
local openName: string? = nil

local selectedMap = "meadow"
local selectedStage = 1
local selectedUnit: string? = nil -- uid in the Units window
local traitUnit: string? = nil -- uid in the Traits window
local equipMode = false
local rolling = false -- the trait roll animation is playing: hold Traits window refreshes

local function rarityColor(rarity: string): Color3
	return Rarities.Info[rarity].color
end

type Entry = { uid: string, u: string, t: string?, l: number, x: number, g: { [string]: string } }

local function entries(data): { Entry }
	local list = {}
	for uid, e in data.units do
		table.insert(list, { uid = uid, u = e.u, t = e.t, l = e.l or 1, x = e.x or 0, g = e.g or Progression.DefaultGrades })
	end
	table.sort(list, function(a, b)
		local ra = Rarities.Info[Units.ById[a.u].rarity].rank
		local rb = Rarities.Info[Units.ById[b.u].rarity].rank
		if ra ~= rb then
			return ra > rb
		end
		if a.l ~= b.l then
			return a.l > b.l
		end
		if a.u ~= b.u then
			return Units.ById[a.u].name < Units.ById[b.u].name
		end
		return tonumber(a.uid) < tonumber(b.uid)
	end)
	return list
end

local function entryOf(data, uid: string): Entry?
	local e = data.units[uid]
	if not e then
		return nil
	end
	return { uid = uid, u = e.u, t = e.t, l = e.l or 1, x = e.x or 0, g = e.g or Progression.DefaultGrades }
end

local function onTeam(data, uid: string): number?
	return table.find(data.team, uid)
end

local function mapUnlocked(data, index: number): boolean
	return index == 1 or (data.progress[Maps.List[index - 1].id] or 0) >= Maps.Stages
end

local function open(name: string?)
	for n, w in windows do
		if n == name then
			if not w.Visible then
				Ui.openWindow(w)
			end
		else
			w.Visible = false
		end
	end
	openName = name
	if name and refreshers[name] then
		refreshers[name]()
	end
end
LobbyUI.open = open

local function closeButton()
	open(nil)
end

-- ============================================================ HUD: menu tiles, currencies, team tray

local gemsLabel: TextLabel
local crystalsLabel: TextLabel
local unitsLabel: TextLabel
local teamTray: Frame

local function tile(parent: Instance, emoji: string, label: string, color: Color3, order: number, onClick: () -> ())
	local t = Ui.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(112, 92),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	}, { Ui.corner(16), Ui.stroke(C.ink, 3), Ui.gradient(Ui.lighten(color, 0.25), Ui.darken(color, 0.3)) })
	Ui.new("Frame", { Size = UDim2.new(1, -8, 0.4, 0), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, Parent = t }, { Ui.corner(12) })
	Ui.text({ Text = emoji, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 4), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 44, Outline = 0, Parent = t })
	Ui.title({ Text = label, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.new(0, 4, 1, -30), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 22, Parent = t })
	local scale = Ui.new("UIScale", { Parent = t })
	t.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1.08 }):Play()
	end)
	t.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	t.Activated:Connect(onClick)
end

local function buildMenu()
	local menu = Ui.new("Frame", {
		Size = UDim2.fromOffset(112, 520),
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local items = {
		{ "⚔️", "PLAY", C.green, "Play" },
		{ "✨", "SUMMON", C.pink, "Summon" },
		{ "🎒", "UNITS", C.blue, "Units" },
		{ "🔮", "TRAITS", C.purple, "Traits" },
		{ "🏆", "CHALLENGE", C.orange, "Challenges" },
	}
	for i, it in items do
		tile(menu, it[1], it[2], it[3], i, function()
			open(openName ~= it[4] and it[4] or nil)
		end)
	end
end

local function pill(parent: Instance, emoji: string, color: Color3, width: number, order: number): TextLabel
	local p = Ui.new("Frame", {
		Size = UDim2.fromOffset(width, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	}, { Ui.round(), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(60, 48, 110), Color3.fromRGB(28, 22, 54)) })
	local icon = Ui.new("Frame", {
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = p,
	}, { Ui.round(), Ui.stroke(C.ink, 3), Ui.gradient(Ui.lighten(color, 0.3), Ui.darken(color, 0.25)) })
	Ui.text({ Text = emoji, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 26, Outline = 0, Parent = icon })
	return Ui.title({ Text = "0", Size = UDim2.new(1, -60, 0, 30), Position = UDim2.fromOffset(52, 7), MaxText = 26, Parent = p })
end

local function buildTopBar()
	local bar = Ui.new("Frame", {
		Size = UDim2.fromOffset(640, 44),
		Position = UDim2.new(0.5, 0, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center) })
	gemsLabel = pill(bar, "💎", C.gem, 190, 1)
	crystalsLabel = pill(bar, "🔮", C.crystal, 170, 2)
	unitsLabel = pill(bar, "🎒", C.blue, 170, 3)
end

local function refreshTeamTray()
	local data = Store.data
	Ui.clear(teamTray)
	for i = 1, Units.TeamSize do
		local uid = data.team[i]
		local e = uid ~= "" and entryOf(data, uid)
		if e then
			Ui.unitCard(teamTray, { unitId = e.u, level = e.l, trait = e.t, price = Stats.placeCost(e.u, e.t) }, UDim2.fromOffset(92, 108), function()
				selectedUnit = e.uid
				open("Units")
			end).LayoutOrder = i
		else
			local slot = Ui.new("TextButton", {
				Text = "+",
				Font = Ui.TitleFont,
				TextScaled = true,
				TextColor3 = C.muted,
				Size = UDim2.fromOffset(92, 108),
				BackgroundColor3 = C.panelDark,
				BackgroundTransparency = 0.25,
				LayoutOrder = i,
				Parent = teamTray,
			}, { Ui.corner(12), Ui.stroke(Color3.fromRGB(90, 76, 160), 3), Ui.padding(28) })
			slot.Activated:Connect(function()
				open("Units")
			end)
		end
	end
end

local function buildTeamTray()
	local tray = Ui.new("Frame", {
		Size = UDim2.fromOffset(6 * 98 + 24, 132),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = gui,
	}, { Ui.corner(18), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(56, 44, 104), Color3.fromRGB(26, 20, 50)) })
	Ui.chip("YOUR TEAM", C.gold, { Size = UDim2.fromOffset(120, 24), Position = UDim2.new(0.5, -60, 0, -13), ZIndex = 3, Parent = tray })
	teamTray = Ui.new("Frame", {
		Size = UDim2.new(1, -16, 1, -18),
		Position = UDim2.fromOffset(8, 13),
		BackgroundTransparency = 1,
		Parent = tray,
	}, { Ui.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
end

-- ============================================================ Play

local function stars(n: number, total: number): string
	return string.rep("★", n) .. string.rep("☆", total - n)
end

local function buildPlay()
	local window, content = Ui.window(gui, "Campaign", "⚔️", UDim2.fromOffset(980, 560), closeButton)
	windows.Play = window
	local mapList = Ui.new("ScrollingFrame", {
		Size = UDim2.new(0, 270, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, { Ui.list(Enum.FillDirection.Vertical, 10), Ui.padding(6) })
	local detail = Ui.inset(content, { Size = UDim2.new(1, -286, 1, 0), Position = UDim2.fromOffset(286, 0) })
	Ui.padding(16).Parent = detail

	refreshers.Play = function()
		local data = Store.data
		Ui.clear(mapList)
		for i, def in Maps.List do
			local unlocked = mapUnlocked(data, i)
			local cleared = data.progress[def.id] or 0
			local t = Ui.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, -4, 0, 78),
				BackgroundColor3 = Color3.new(1, 1, 1),
				LayoutOrder = i,
				Parent = mapList,
			}, {
				Ui.corner(14),
				Ui.stroke(def.id == selectedMap and Color3.new(1, 1, 1) or C.ink, def.id == selectedMap and 4 or 3),
				Ui.gradient(Ui.lighten(def.theme.ground, 0.15), Ui.darken(def.theme.ground, 0.45), 0),
			})
			Ui.title({ Text = def.name, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(12, 8), MaxText = 24, Parent = t })
			Ui.text({ Text = stars(cleared, Maps.Stages), Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(12, 42), TextColor3 = C.gold, MaxText = 24, Parent = t })
			if not unlocked then
				Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, ZIndex = 3, Parent = t }, { Ui.corner(14) })
				Ui.text({ Text = "🔒", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -50, 0.5, -20), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 32, Outline = 0, ZIndex = 4, Parent = t })
			end
			t.Activated:Connect(function()
				selectedMap = def.id
				selectedStage = math.min((data.progress[def.id] or 0) + 1, Maps.Stages)
				refreshers.Play()
			end)
		end

		Ui.clear(detail)
		local def = Maps.ById[selectedMap]
		local unlocked = mapUnlocked(data, Maps.Index[selectedMap])
		local cleared = data.progress[def.id] or 0
		Ui.title({ Text = def.name, Size = UDim2.new(1, -140, 0, 40), MaxText = 36, Parent = detail })
		Ui.text({ Text = def.desc, Size = UDim2.new(1, -140, 0, 24), Position = UDim2.fromOffset(0, 44), TextColor3 = C.muted, MaxText = 18, Parent = detail })
		local boss = Enemies.ById[def.boss]
		local bossCard = Ui.new("Frame", {
			Size = UDim2.fromOffset(124, 132),
			Position = UDim2.new(1, -124, 0, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = detail,
		}, { Ui.corner(12), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(150, 40, 70), Color3.fromRGB(50, 10, 30)) })
		Ui.viewport(def.boss, { Size = UDim2.new(1, 0, 1, -26) }, true).Parent = bossCard
		Ui.chip("BOSS", C.red, { Size = UDim2.fromOffset(60, 20), Position = UDim2.new(0.5, -30, 0, -10), ZIndex = 3, Parent = bossCard })
		Ui.text({ Text = ModelFactory.displayName(boss.id, boss.name), Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0, 4, 1, -24), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 15, Parent = bossCard })
		Ui.text({
			Text = boss.desc,
			Size = UDim2.new(1, -140, 0, 40),
			Position = UDim2.fromOffset(0, 74),
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(255, 170, 210),
			MaxText = 16,
			Parent = detail,
		})

		Ui.title({ Text = "ENEMIES", Size = UDim2.fromOffset(200, 24), Position = UDim2.fromOffset(0, 140), MaxText = 20, Parent = detail })
		local row = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 92), Position = UDim2.fromOffset(0, 168), BackgroundTransparency = 1, Parent = detail }, { Ui.list(Enum.FillDirection.Horizontal, 8) })
		local shown = {}
		for _, id in def.ground do
			table.insert(shown, id)
		end
		for _, id in def.flying do
			table.insert(shown, id)
		end
		for _, id in shown do
			local e = Enemies.ById[id]
			local holder = Ui.new("Frame", {
				Size = UDim2.fromOffset(86, 92),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Parent = row,
			}, { Ui.corner(10), Ui.stroke(C.ink, 2), Ui.gradient(Color3.fromRGB(80, 66, 140), Color3.fromRGB(40, 30, 80)) })
			Ui.viewport(id, { Size = UDim2.new(1, 0, 1, -22) }).Parent = holder
			Ui.text({ Text = ModelFactory.displayName(id, e.name), Size = UDim2.new(1, -6, 0, 18), Position = UDim2.new(0, 3, 1, -20), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 13, Parent = holder })
			if e.kind == "flying" then
				Ui.chip("AIR", C.blue, { Size = UDim2.fromOffset(40, 18), Position = UDim2.fromOffset(4, 4), ZIndex = 3, Parent = holder })
			end
		end

		Ui.title({ Text = "STAGE", Size = UDim2.fromOffset(200, 24), Position = UDim2.fromOffset(0, 274), MaxText = 20, Parent = detail })
		local stageRow = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 302), BackgroundTransparency = 1, Parent = detail }, { Ui.list(Enum.FillDirection.Horizontal, 10) })
		for s = 1, Maps.Stages do
			local available = unlocked and cleared >= s - 1
			local color = s == selectedStage and C.gold or (cleared >= s and C.green or (available and C.blue or C.panel))
			local b = Ui.button(tostring(s) .. (s == Maps.Stages and "\nBOSS" or (cleared >= s and "\n✓" or "")), color, function()
				if available then
					selectedStage = s
					refreshers.Play()
				end
			end, { Size = UDim2.fromOffset(84, 64), MaxText = 24, Parent = stageRow })
			b.Font = Ui.TitleFont
			if not available then
				b.TextColor3 = C.muted
			end
		end

		local waves = 6 + 2 * selectedStage
		local first = selectedStage > cleared
		Ui.text({
			Text = string.format("%d waves  •  %s", waves, first and ("First clear: 💎 gems + 🔮 " .. (selectedStage == Maps.Stages and "3 crystals" or "1 crystal")) or "Replay: 💎 gems"),
			Size = UDim2.new(1, -230, 0, 30),
			Position = UDim2.new(0, 0, 1, -50),
			TextColor3 = C.muted,
			MaxText = 18,
			Parent = detail,
		})
		local canStart = unlocked and cleared >= selectedStage - 1
		local start = Ui.button(canStart and "START" or "LOCKED", canStart and C.green or C.panel, function()
			if not canStart then
				return
			end
			local ok, err = Store.call("StartBattle", "campaign", selectedMap, selectedStage)
			if ok then
				open(nil)
			else
				Ui.toast(err or "Could not start", C.red)
			end
		end, { Size = UDim2.fromOffset(210, 62), Position = UDim2.new(1, -210, 1, -62), MaxText = 34, Parent = detail })
		start.Font = Ui.TitleFont
	end
end

-- ============================================================ Summon

local resultOverlay: Frame

local function hallPedestal(): BasePart?
	local lobby = workspace:FindFirstChild("Lobby")
	local hall = lobby and lobby:FindFirstChild("SummonHall")
	return hall and hall:FindFirstChild("Pedestal") :: BasePart?
end

-- the best pulled unit appears on the Summon Hall pedestal in a beam of its rarity colour
local function cinematic(unitId: string, rarity: string): () -> ()
	local pedestal = hallPedestal()
	local camera = workspace.CurrentCamera
	if not pedestal then
		return function() end
	end
	local oldType = camera.CameraType
	local oldCf = camera.CFrame
	camera.CameraType = Enum.CameraType.Scriptable
	-- the pedestal is an upright cylinder: its height is Size.X
	local top = pedestal.Position + Vector3.new(0, pedestal.Size.X / 2 + 0.6, 0)
	local look = CFrame.lookAt(top + Vector3.new(0, 7, -20), top + Vector3.new(0, 3.5, 0))
	TweenService:Create(camera, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { CFrame = look }):Play()
	local color = rarityColor(rarity)
	local folder = Instance.new("Folder")
	folder.Name = "SummonFx"
	folder.Parent = workspace
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Shape = Enum.PartType.Cylinder
	beam.Size = Vector3.new(60, 0.5, 0.5)
	beam.CFrame = CFrame.new(top + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Transparency = 0.2
	beam.Parent = folder
	TweenService:Create(beam, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Size = Vector3.new(60, 9, 9) }):Play()
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 30
	glow.Brightness = 4
	glow.Parent = beam
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Rate = 60
	sparks.Speed = NumberRange.new(6, 14)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Lifetime = NumberRange.new(0.6, 1.2)
	sparks.Size = NumberSequence.new(1, 0)
	sparks.Parent = beam
	task.delay(0.9, function()
		if not folder.Parent then
			return
		end
		TweenService:Create(beam, TweenInfo.new(0.4), { Size = Vector3.new(60, 0.2, 0.2), Transparency = 1 }):Play()
		local model = ModelFactory.build(unitId, 1.4, true)
		model:PivotTo(CFrame.new(top) * CFrame.Angles(0, math.pi, 0))
		model.Parent = folder
		sparks.Rate = 15
	end)
	return function()
		folder:Destroy()
		camera.CameraType = oldType
		camera.CFrame = oldCf
	end
end

local function showSummonResults(results)
	local best = results[1]
	for _, r in results do
		if Rarities.Info[r.rarity].rank > Rarities.Info[best.rarity].rank then
			best = r
		end
	end
	local finish = cinematic(best.unitId, best.rarity)
	open(nil)
	task.wait(hallPedestal() and 2.2 or 0)

	Ui.clear(resultOverlay)
	resultOverlay.Visible = true
	local bestRank = Rarities.Info[best.rarity].rank
	local banner = ({ "NICE PULL!", "RARE PULL!", "LEGENDARY!", "MYTHIC!!!" })[bestRank]
	local title = Ui.title({
		Text = banner,
		Size = UDim2.fromOffset(700, 70),
		Position = UDim2.new(0.5, 0, 0.5, -250),
		AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = rarityColor(best.rarity),
		MaxText = 64,
		Outline = 3,
		Parent = resultOverlay,
	})
	Ui.pop(title)
	local grid = Ui.new("Frame", {
		Size = UDim2.fromOffset(5 * 146, (#results > 5 and 2 or 1) * 190),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = resultOverlay,
	})
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(134, 178),
		CellPadding = UDim2.fromOffset(12, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for i, r in results do
		local holder = Ui.new("Frame", { LayoutOrder = i, BackgroundTransparency = 1, Parent = grid })
		local card = Ui.unitCard(holder, { unitId = r.unitId, level = 1 }, UDim2.new(1, 0, 1, -30))
		card.Visible = false
		Ui.chip(r.rarity, rarityColor(r.rarity), { Size = UDim2.fromOffset(100, 22), Position = UDim2.new(0.5, -50, 0, -11), ZIndex = 6, Parent = card })
		local g = r.grades or Progression.DefaultGrades
		local gradeRow = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -24), BackgroundTransparency = 1, Visible = false, Parent = holder }, { Ui.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center) })
		for _, k in { "d", "s", "r" } do
			Ui.gradeBadge(g[k], { Size = UDim2.fromOffset(40, 22), MaxText = 18, Parent = gradeRow })
		end
		task.delay(0.1 * i, function()
			card.Visible = true
			gradeRow.Visible = true
			Ui.pop(card)
		end)
	end
	local ok
	ok = Ui.button("AWESOME!", C.green, function()
		resultOverlay.Visible = false
		finish()
		open("Summon")
	end, { Size = UDim2.fromOffset(240, 58), Position = UDim2.new(0.5, 0, 0.5, 220), AnchorPoint = Vector2.new(0.5, 0), MaxText = 30, Parent = resultOverlay })
	ok.Font = Ui.TitleFont
end

local function buildSummon()
	local window, content = Ui.window(gui, "Summon", "✨", UDim2.fromOffset(980, 560), closeButton)
	windows.Summon = window
	resultOverlay = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 6, 24),
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})

	refreshers.Summon = function()
		local data = Store.data
		Ui.clear(content)
		local banner = Ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 300),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = content,
		}, { Ui.corner(16), Ui.stroke(C.ink, 3) })
		local bg = Ui.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 40, 200)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(230, 70, 160)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 40, 180)),
			}),
			Parent = banner,
		})
		Ui.spin(bg, 12)
		Ui.title({ Text = "★ STAR BANNER ★", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 8), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 40, Parent = banner })
		local row = Ui.new("Frame", { Size = UDim2.new(1, -20, 0, 220), Position = UDim2.fromOffset(10, 60), BackgroundTransparency = 1, Parent = banner }, { Ui.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
		local featured = {}
		for _, r in { "Mythic", "Legendary" } do
			for _, def in Units.ByRarity[r] do
				table.insert(featured, def)
			end
		end
		for _, def in featured do
			local holder = Ui.new("Frame", { Size = UDim2.fromOffset(146, 220), BackgroundTransparency = 1, Parent = row })
			Ui.new("Frame", {
				Size = UDim2.fromOffset(120, 26),
				Position = UDim2.new(0.5, -60, 1, -56),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Parent = holder,
			}, { Ui.round(), Ui.stroke(C.ink, 2), Ui.gradient(Ui.lighten(rarityColor(def.rarity), 0.4), Ui.darken(rarityColor(def.rarity), 0.3)) })
			Ui.viewport(def.id, { Size = UDim2.new(1, 0, 1, -50) }, true).Parent = holder
			Ui.text({ Text = Ui.unitName(def.id), Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -28), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 17, Parent = holder })
			Ui.text({ Text = def.rarity, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -10), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rarityColor(def.rarity), MaxText = 14, Parent = holder })
		end

		local rates = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 312), BackgroundTransparency = 1, Parent = content }, { Ui.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
		for _, r in Rarities.Order do
			Ui.chip(r .. " " .. Rarities.SummonRates[r] .. "%", rarityColor(r), { Size = UDim2.fromOffset(170, 28), Parent = rates })
		end

		local legLeft = Rarities.LegendaryPity - data.pity.legendary
		local mythLeft = Rarities.MythicPity - data.pity.mythic
		Ui.text({ Text = "Legendary+ guaranteed in " .. legLeft, Size = UDim2.fromOffset(300, 20), Position = UDim2.fromOffset(20, 352), MaxText = 16, Parent = content })
		Ui.bar(content, { Size = UDim2.fromOffset(300, 14), Position = UDim2.fromOffset(20, 376) }, C.gold, data.pity.legendary / Rarities.LegendaryPity)
		Ui.text({ Text = "Mythic guaranteed in " .. mythLeft, Size = UDim2.fromOffset(300, 20), Position = UDim2.fromOffset(20, 398), MaxText = 16, Parent = content })
		Ui.bar(content, { Size = UDim2.fromOffset(300, 14), Position = UDim2.fromOffset(20, 422) }, C.pink, data.pity.mythic / Rarities.MythicPity)

		local function summon(count: number)
			local ok, results = Store.call("Summon", count)
			if ok then
				showSummonResults(results)
			else
				Ui.toast(results or "Summon failed", C.red)
			end
		end
		local one = Ui.button("SUMMON x1\n💎 50", C.blue, function()
			summon(1)
		end, { Size = UDim2.fromOffset(230, 84), Position = UDim2.new(1, -490, 1, -96), MaxText = 28, Parent = content })
		one.Font = Ui.TitleFont
		local ten = Ui.button("SUMMON x10\n💎 450", C.gold, function()
			summon(10)
		end, { Size = UDim2.fromOffset(230, 84), Position = UDim2.new(1, -240, 1, -96), MaxText = 28, Parent = content })
		ten.Font = Ui.TitleFont
	end
end

-- ============================================================ Units

local function buildUnits()
	local window, content = Ui.window(gui, "Units", "🎒", UDim2.fromOffset(1000, 580), closeButton)
	windows.Units = window
	local grid = Ui.new("ScrollingFrame", {
		Size = UDim2.new(1, -380, 1, -64),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, {
		Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(110, 128), CellPadding = UDim2.fromOffset(10, 16), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.padding(10),
	})
	local footer = Ui.new("Frame", { Size = UDim2.new(1, -380, 0, 52), Position = UDim2.new(0, 0, 1, -52), BackgroundTransparency = 1, Parent = content }, { Ui.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	local detail = Ui.inset(content, { Size = UDim2.new(0, 364, 1, 0), Position = UDim2.new(1, -364, 0, 0) })
	Ui.padding(12).Parent = detail

	Ui.button("Unequip All", C.red, function()
		for i = 1, Units.TeamSize do
			if Store.data.team[i] ~= "" then
				Store.call("EquipUnit", i, "")
			end
		end
	end, { Size = UDim2.fromOffset(170, 48), Parent = footer })
	Ui.button("Equip Best", C.purple, function()
		-- the strongest unit of each type, best rarity first
		local picked, used = {}, {}
		for _, e in entries(Store.data) do
			if not used[e.u] and #picked < Units.TeamSize then
				used[e.u] = true
				table.insert(picked, e.uid)
			end
		end
		for i = 1, Units.TeamSize do
			Store.call("EquipUnit", i, picked[i] or "")
		end
	end, { Size = UDim2.fromOffset(170, 48), Parent = footer })
	local countLabel = Ui.title({ Text = "", Size = UDim2.fromOffset(200, 36), MaxText = 26, Parent = footer })

	refreshers.Units = function()
		local data = Store.data
		local list = entries(data)
		if selectedUnit and not data.units[selectedUnit] then
			selectedUnit = nil
		end
		if not selectedUnit and list[1] then
			selectedUnit = list[1].uid
		end
		countLabel.Text = #list .. " / " .. Units.InventoryLimit
		Ui.clear(grid)
		for i, e in list do
			local slot = onTeam(data, e.uid)
			local card = Ui.unitCard(grid, {
				unitId = e.u,
				level = e.l,
				trait = e.t,
				price = Stats.placeCost(e.u, e.t),
				selected = e.uid == selectedUnit,
				badge = slot and ("TEAM " .. slot) or nil,
			}, UDim2.new(), function()
				selectedUnit = e.uid
				equipMode = false
				refreshers.Units()
			end)
			card.LayoutOrder = i
		end

		Ui.clear(detail)
		local e = selectedUnit and entryOf(data, selectedUnit)
		if not e then
			return
		end
		local def = Units.ById[e.u]
		Ui.chip(def.rarity, rarityColor(def.rarity), { Size = UDim2.fromOffset(120, 26), Parent = detail })
		Ui.chip(def.role, C.panel, { Size = UDim2.fromOffset(200, 26), Position = UDim2.fromOffset(128, 0), Parent = detail })
		Ui.title({ Text = Ui.unitName(e.u), Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 32), MaxText = 32, Parent = detail })
		local stage = Ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 170),
			Position = UDim2.fromOffset(0, 72),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = detail,
		}, { Ui.corner(12), Ui.stroke(C.ink, 2), Ui.gradient(Ui.darken(rarityColor(def.rarity), 0.2), Ui.darken(rarityColor(def.rarity), 0.75)) })
		Ui.viewport(e.u, { Size = UDim2.fromScale(1, 1) }, true).Parent = stage

		-- level and xp
		local maxed = e.l >= Progression.MaxLevel
		Ui.title({ Text = "Lvl " .. e.l, Size = UDim2.fromOffset(90, 26), Position = UDim2.fromOffset(0, 250), MaxText = 22, Parent = detail })
		Ui.bar(detail, { Size = UDim2.new(1, -96, 0, 16), Position = UDim2.fromOffset(96, 256) }, C.gold, maxed and 1 or e.x / Progression.xpToNext(e.l))
		Ui.text({ Text = maxed and "MAX" or (e.x .. " / " .. Progression.xpToNext(e.l) .. " XP"), Size = UDim2.new(1, -96, 0, 14), Position = UDim2.fromOffset(96, 274), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.muted, MaxText = 12, Parent = detail })

		local s = Stats.compute(e.u, 0, e.t, nil, { l = e.l, g = e.g })
		local statRow = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 296), BackgroundTransparency = 1, Parent = detail }, { Ui.list(Enum.FillDirection.Horizontal, 6) })
		if def.attack.kind ~= "none" then
			Ui.statChip("DMG", Ui.short(s.damage), e.g.d, C.red, { Size = UDim2.fromOffset(110, 46), Parent = statRow })
			Ui.statChip("SPA", string.format("%.2fs", s.cooldown), e.g.s, C.blue, { Size = UDim2.fromOffset(110, 46), Parent = statRow })
			Ui.statChip("RNG", string.format("%.1f", s.range), e.g.r, C.gold, { Size = UDim2.fromOffset(110, 46), Parent = statRow })
		else
			Ui.statChip("FARM", "$" .. math.floor(s.farm) .. "/wave", nil, C.gold, { Size = UDim2.fromOffset(200, 46), Parent = statRow })
		end
		local targets = (s.hitsGround and "Ground" or "") .. (s.hitsGround and s.hitsAir and " + " or "") .. (s.hitsAir and "Air" or "")
		Ui.text({
			Text = string.format("$%d to place  •  limit %d%s", Stats.placeCost(e.u, e.t), def.limit, targets ~= "" and ("  •  hits " .. targets) or ""),
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 348),
			TextColor3 = C.muted,
			MaxText = 14,
			Parent = detail,
		})
		local trait = e.t and Traits.ById[e.t]
		local traitBox = Ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 46),
			Position = UDim2.fromOffset(0, 372),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = detail,
		}, { Ui.corner(10), Ui.stroke(C.ink, 2), Ui.gradient(trait and Ui.darken(rarityColor(trait.rarity), 0.3) or C.panel, trait and Ui.darken(rarityColor(trait.rarity), 0.7) or C.panelDark) })
		Ui.text({ Text = trait and ("🔮 " .. trait.name) or "🔮 No trait", Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 3), MaxText = 17, Parent = traitBox })
		Ui.text({ Text = trait and trait.desc or "Roll one in Traits with Trait Crystals", Size = UDim2.new(1, -12, 0, 16), Position = UDim2.fromOffset(8, 25), TextColor3 = C.muted, MaxText = 13, Outline = 1, Parent = traitBox })

		local buttons = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 104), Position = UDim2.new(0, 0, 1, -104), BackgroundTransparency = 1, Parent = detail })
		if equipMode then
			Ui.title({ Text = "PICK A TEAM SLOT", Size = UDim2.new(1, 0, 0, 22), MaxText = 18, Parent = buttons })
			for i = 1, Units.TeamSize do
				local current = data.team[i]
				Ui.button(tostring(i), current == selectedUnit and C.green or (current ~= "" and C.blue or C.panel), function()
					local ok, err = Store.call("EquipUnit", i, selectedUnit)
					if not ok then
						Ui.toast(err or "Could not equip", C.red)
					end
					equipMode = false
					refreshers.Units()
				end, { Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset((i - 1) * 57, 34), MaxText = 24, Parent = buttons })
			end
			return
		end
		local slot = onTeam(data, e.uid)
		if slot then
			Ui.button("Unequip", C.red, function()
				Store.call("EquipUnit", slot, "")
			end, { Size = UDim2.new(0.5, -5, 0, 48), Parent = buttons })
		else
			Ui.button("Equip", C.green, function()
				equipMode = true
				refreshers.Units()
			end, { Size = UDim2.new(0.5, -5, 0, 48), Parent = buttons })
		end
		Ui.button("Traits", C.purple, function()
			traitUnit = e.uid
			open("Traits")
		end, { Size = UDim2.new(0.5, -5, 0, 48), Position = UDim2.new(0.5, 5, 0, 0), Parent = buttons })
		local releaseGems = Rarities.Info[def.rarity].releaseGems
		local confirming = false
		local release
		release = Ui.button("Quick Sell  +💎" .. releaseGems, C.gold, function()
			if not confirming then
				confirming = true
				release.Text = "Tap again to sell"
				task.delay(3, function()
					confirming = false
					if release.Parent then
						release.Text = "Quick Sell  +💎" .. releaseGems
					end
				end)
				return
			end
			local ok, err = Store.call("ReleaseUnit", e.uid)
			if ok then
				selectedUnit = nil
			else
				Ui.toast(err or "Could not sell", C.red)
			end
		end, { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 56), Parent = buttons })
	end
end

-- ============================================================ Traits

local function buildTraits()
	local window, content = Ui.window(gui, "Traits", "🔮", UDim2.fromOffset(1000, 580), closeButton)
	windows.Traits = window
	local picker = Ui.new("ScrollingFrame", {
		Size = UDim2.new(0, 260, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, { Ui.list(Enum.FillDirection.Vertical, 8), Ui.padding(6) })
	local roller = Ui.inset(content, { Size = UDim2.new(0, 330, 1, 0), Position = UDim2.fromOffset(272, 0) })
	Ui.padding(14).Parent = roller
	local index = Ui.new("ScrollingFrame", {
		Size = UDim2.new(1, -616, 1, 0),
		Position = UDim2.fromOffset(616, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, { Ui.list(Enum.FillDirection.Vertical, 6), Ui.padding(6) })

	-- the trait index never changes
	local order = 0
	for i = #Rarities.Order, 1, -1 do
		local r = Rarities.Order[i]
		order += 1
		Ui.chip(string.format("%s  %s%%", r, tostring(Rarities.TraitRates[r])), rarityColor(r), { Size = UDim2.new(1, -10, 0, 30), LayoutOrder = order, Parent = index })
		for _, t in Traits.ByRarity[r] do
			order += 1
			local row = Ui.new("Frame", { Size = UDim2.new(1, -10, 0, 46), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.2, LayoutOrder = order, Parent = index }, { Ui.corner(8) })
			Ui.text({ Text = t.name, Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 3), TextColor3 = Ui.lighten(rarityColor(r), 0.2), MaxText = 16, Parent = row })
			Ui.text({ Text = t.desc, Size = UDim2.new(1, -12, 0, 16), Position = UDim2.fromOffset(8, 25), TextColor3 = C.muted, MaxText = 13, Outline = 1, Parent = row })
		end
	end

	refreshers.Traits = function()
		local data = Store.data
		local list = entries(data)
		if traitUnit and not data.units[traitUnit] then
			traitUnit = nil
		end
		if not traitUnit and list[1] then
			traitUnit = list[1].uid
		end
		Ui.clear(picker)
		for i, e in list do
			local def = Units.ById[e.u]
			local trait = e.t and Traits.ById[e.t]
			local row = Ui.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, -6, 0, 62),
				BackgroundColor3 = Color3.new(1, 1, 1),
				LayoutOrder = i,
				Parent = picker,
			}, {
				Ui.corner(10),
				Ui.stroke(e.uid == traitUnit and Color3.new(1, 1, 1) or C.ink, e.uid == traitUnit and 3 or 2),
				Ui.gradient(Ui.RarityGradient[def.rarity][1], Ui.RarityGradient[def.rarity][2], 0),
			})
			Ui.viewport(e.u, { Size = UDim2.fromOffset(58, 58), Position = UDim2.fromOffset(2, 2) }).Parent = row
			Ui.text({ Text = Ui.unitName(e.u) .. "  Lvl " .. e.l, Size = UDim2.new(1, -70, 0, 22), Position = UDim2.fromOffset(64, 6), MaxText = 16, Parent = row })
			Ui.text({
				Text = trait and trait.name or "no trait",
				Size = UDim2.new(1, -70, 0, 20),
				Position = UDim2.fromOffset(64, 32),
				TextColor3 = trait and Ui.lighten(rarityColor(trait.rarity), 0.3) or C.muted,
				MaxText = 15,
				Parent = row,
			})
			row.Activated:Connect(function()
				traitUnit = e.uid
				refreshers.Traits()
			end)
		end

		Ui.clear(roller)
		local e = traitUnit and entryOf(data, traitUnit)
		if not e then
			return
		end
		local def = Units.ById[e.u]
		local stage = Ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 170),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = roller,
		}, { Ui.corner(12), Ui.stroke(C.ink, 2), Ui.gradient(Ui.darken(rarityColor(def.rarity), 0.2), Ui.darken(rarityColor(def.rarity), 0.75)) })
		Ui.viewport(e.u, { Size = UDim2.fromScale(1, 1) }, true).Parent = stage
		Ui.title({ Text = Ui.unitName(e.u), Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 176), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 26, Parent = roller })
		local trait = e.t and Traits.ById[e.t]
		local current = Ui.title({
			Text = trait and trait.name or "NO TRAIT",
			Size = UDim2.new(1, 0, 0, 46),
			Position = UDim2.fromOffset(0, 214),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = trait and rarityColor(trait.rarity) or C.muted,
			MaxText = 40,
			Outline = 3,
			Parent = roller,
		})
		local desc = Ui.text({
			Text = trait and (trait.rarity .. ": " .. trait.desc) or "Roll to give this unit a trait.",
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(0, 262),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = C.muted,
			MaxText = 16,
			Parent = roller,
		})
		Ui.chip("🔮 " .. data.crystals .. " Trait Crystal" .. (data.crystals == 1 and "" or "s"), C.crystal, { Size = UDim2.new(1, -40, 0, 30), Position = UDim2.new(0, 20, 1, -116), Parent = roller })
		local confirming = false
		local rollButton
		rollButton = Ui.button("ROLL TRAIT  🔮" .. Traits.RollCost, C.purple, function()
			-- rolling replaces the current trait: confirm before throwing away a Legendary or Mythic one
			if trait and Rarities.Info[trait.rarity].rank >= 3 and not confirming then
				confirming = true
				rollButton.Text = "Replace " .. trait.name .. "? Tap again"
				task.delay(3, function()
					confirming = false
				end)
				return
			end
			rolling = true
			local ok, result = Store.call("RollTrait", e.uid)
			if not ok then
				rolling = false
				Ui.toast(result or "Could not roll", C.red)
				return
			end
			local rolled = Traits.ById[result]
			-- spin through random trait names before landing on the result
			for i = 1, 14 do
				local t = Traits.List[math.random(1, #Traits.List)]
				current.Text = t.name
				current.TextColor3 = rarityColor(t.rarity)
				task.wait(0.03 + i * 0.012)
			end
			current.Text = rolled.name
			current.TextColor3 = rarityColor(rolled.rarity)
			desc.Text = rolled.rarity .. ": " .. rolled.desc
			Ui.pop(current)
			Ui.toast("Rolled " .. rolled.rarity .. " trait: " .. rolled.name .. "!", Ui.darken(rarityColor(rolled.rarity), 0.3))
			task.wait(0.8)
			rolling = false
			if openName == "Traits" then
				refreshers.Traits()
			end
		end, { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.new(0, 0, 1, -74), MaxText = 26, Parent = roller })
		rollButton.Font = Ui.TitleFont
	end
end

-- ============================================================ Challenges

local function buildChallenges()
	local window, content = Ui.window(gui, "Challenges", "🏆", UDim2.fromOffset(940, 560), closeButton)
	windows.Challenges = window
	local list = Ui.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, { Ui.list(Enum.FillDirection.Vertical, 10), Ui.padding(6) })

	refreshers.Challenges = function()
		local data = Store.data
		Ui.clear(list)
		Ui.text({
			Text = "Each challenge pays 🔮 Trait Crystals once per day (resets 00:00 UTC). Replays pay a few gems.",
			Size = UDim2.new(1, -10, 0, 24),
			TextColor3 = C.muted,
			LayoutOrder = 0,
			MaxText = 17,
			Parent = list,
		})
		for i, ch in Challenges.List do
			local map = Maps.ById[ch.map]
			local unlocked = mapUnlocked(data, Maps.Index[ch.map]) and (data.progress[ch.map] or 0) >= 1
			local doneToday = data.challenges[ch.id] == Challenges.today()
			local row = Ui.new("Frame", {
				Size = UDim2.new(1, -10, 0, 92),
				BackgroundColor3 = Color3.new(1, 1, 1),
				LayoutOrder = i,
				Parent = list,
			}, { Ui.corner(14), Ui.stroke(C.ink, 3), Ui.gradient(Ui.darken(map.theme.ground, 0.2), Ui.darken(map.theme.ground, 0.7), 0) })
			Ui.title({ Text = ch.name, Size = UDim2.new(0.5, 0, 0, 32), Position = UDim2.fromOffset(14, 8), MaxText = 28, Parent = row })
			Ui.text({ Text = map.name .. " • stage " .. ch.stage .. " • " .. ch.desc, Size = UDim2.new(1, -330, 0, 40), Position = UDim2.fromOffset(14, 44), TextWrapped = true, TextColor3 = C.muted, MaxText = 16, Parent = row })
			local rewards = Ui.new("Frame", { Size = UDim2.fromOffset(300, 30), Position = UDim2.new(1, -310, 0, 10), BackgroundTransparency = 1, Parent = row }, { Ui.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
			if doneToday then
				Ui.chip("DONE TODAY", C.green, { Size = UDim2.fromOffset(130, 28), Parent = rewards })
				Ui.chip("💎 " .. ch.repeatGems, C.blue, { Size = UDim2.fromOffset(80, 28), Parent = rewards })
			else
				Ui.chip("🔮 x" .. ch.crystals, C.crystal, { Size = UDim2.fromOffset(90, 28), Parent = rewards })
				Ui.chip("💎 " .. ch.gems, C.blue, { Size = UDim2.fromOffset(90, 28), Parent = rewards })
			end
			local start = Ui.button(unlocked and "START" or "🔒 LOCKED", unlocked and C.green or C.panel, function()
				if not unlocked then
					Ui.toast("Clear stage 1 of " .. map.name .. " first", C.red)
					return
				end
				local ok, err = Store.call("StartBattle", "challenge", ch.id)
				if ok then
					open(nil)
				else
					Ui.toast(err or "Could not start", C.red)
				end
			end, { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -160, 0, 44), MaxText = 22, Parent = row })
			start.Font = Ui.TitleFont
		end
	end
end

-- ============================================================ lifecycle

local function refreshAll()
	local data = Store.data
	if not data then
		return
	end
	gemsLabel.Text = Ui.formatNumber(data.gems)
	crystalsLabel.Text = Ui.formatNumber(data.crystals)
	local n = 0
	for _ in data.units do
		n += 1
	end
	unitsLabel.Text = n .. "/" .. Units.InventoryLimit
	refreshTeamTray()
	if openName and refreshers[openName] and not (openName == "Traits" and rolling) then
		refreshers[openName]()
	end
end

function LobbyUI.setVisible(visible: boolean)
	gui.Enabled = visible
	if not visible then
		open(nil)
		resultOverlay.Visible = false
	end
end

function LobbyUI.start()
	gui = Ui.new("ScreenGui", {
		Name = "Lobby",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.new("UIScale", { Name = "Scale", Parent = gui })
	buildTopBar()
	buildMenu()
	buildTeamTray()
	buildPlay()
	buildSummon()
	buildUnits()
	buildTraits()
	buildChallenges()
	Store.DataChanged:Connect(refreshAll)
	refreshAll()

	-- walking up to the Summon Hall pedestal or the battle portal opens their windows
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local target = prompt:GetAttribute("OpensWindow")
		if type(target) == "string" and windows[target] and gui.Enabled then
			open(target)
		end
	end)
	return gui
end

return LobbyUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Store = require(script.Parent.Store)
local Fx = require(script.Parent.Fx)
local LobbyUI = require(script.Parent.LobbyUI)
local BattleUI = require(script.Parent.BattleUI)
local Ui = require(script.Parent.Ui)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

Store.start()
Fx.start()

-- wait for the save data before building the lobby
while not Store.data do
	Store.DataChanged:Wait()
end

local lobbyGui = LobbyUI.start()
local battleGui = BattleUI.start()

Store.BattleChanged:Connect(function(state)
	LobbyUI.setVisible(not state.active)
end)

-- scale the UI down on small screens
local camera = workspace.CurrentCamera
local function rescale()
	local size = camera.ViewportSize
	local scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.5, 1.25)
	for _, g in { lobbyGui, battleGui } do
		local s = g:FindFirstChild("Scale")
		if s then
			s.Scale = scale
		end
	end
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

Ui.toast("Welcome to Star Kingdom Defense, " .. Players.LocalPlayer.DisplayName .. "!", Ui.Colors.purple)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[-- The client's copy of the player's save data and the current battle state, with change signals.
local Net = require(game.ReplicatedStorage.Shared.Net)

local Store = {}

Store.data = nil :: any
Store.battle = { active = false } :: any

local dataChanged = Instance.new("BindableEvent")
local battleChanged = Instance.new("BindableEvent")
Store.DataChanged = dataChanged.Event
Store.BattleChanged = battleChanged.Event

function Store.start()
	Net.ev("DataChanged").OnClientEvent:Connect(function(data)
		Store.data = data
		dataChanged:Fire(data)
	end)
	Net.ev("BattleState").OnClientEvent:Connect(function(state)
		Store.battle = state
		battleChanged:Fire(state)
	end)
	task.spawn(function()
		local data = Net.fn("GetData"):InvokeServer()
		if data and not Store.data then
			Store.data = data
			dataChanged:Fire(data)
		end
	end)
end

-- invoke a remote, toasting the error message when it fails
function Store.call(name: string, ...: any): (boolean, any)
	local ok, result, extra = pcall(Net.fn(name).InvokeServer, Net.fn(name), ...)
	if not ok then
		return false, "Connection problem"
	end
	if result == false then
		return false, extra
	end
	return true, extra
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- UI toolkit and the game's look: chunky outlined text, gradient buttons, gold-bannered windows, rarity unit cards,
-- stat chips with grade badges, spinning model viewports and toasts.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = game.ReplicatedStorage.Shared
local ModelFactory = require(Shared.ModelFactory)
local Units = require(Shared.Units)
local Traits = require(Shared.Traits)
local Rarities = require(Shared.Rarities)
local Progression = require(Shared.Progression)

local Ui = {}

Ui.Font = Enum.Font.FredokaOne
Ui.TitleFont = Enum.Font.LuckiestGuy
Ui.Colors = {
	bgTop = Color3.fromRGB(52, 40, 96),
	bgBottom = Color3.fromRGB(22, 17, 44),
	panel = Color3.fromRGB(38, 30, 74),
	panelDark = Color3.fromRGB(24, 19, 48),
	card = Color3.fromRGB(58, 48, 108),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(196, 188, 236),
	ink = Color3.fromRGB(18, 12, 30),
	green = Color3.fromRGB(60, 205, 90),
	red = Color3.fromRGB(235, 55, 70),
	blue = Color3.fromRGB(55, 140, 255),
	gold = Color3.fromRGB(255, 196, 30),
	orange = Color3.fromRGB(255, 140, 30),
	purple = Color3.fromRGB(150, 80, 255),
	pink = Color3.fromRGB(255, 80, 170),
	gem = Color3.fromRGB(70, 220, 255),
	crystal = Color3.fromRGB(215, 110, 255),
}
local C = Ui.Colors

-- rarity card gradients (top -> bottom)
Ui.RarityGradient = {
	Common = { Color3.fromRGB(196, 202, 212), Color3.fromRGB(96, 102, 118) },
	Rare = { Color3.fromRGB(100, 185, 255), Color3.fromRGB(28, 72, 196) },
	Legendary = { Color3.fromRGB(255, 222, 80), Color3.fromRGB(232, 112, 16) },
	Mythic = { Color3.fromRGB(255, 96, 150), Color3.fromRGB(176, 18, 74) },
}

-- ============================================================ basics

function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	for k, v in (props or {}) :: { [string]: any } do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Ui.corner(radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Ui.round(): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function Ui.stroke(color: Color3?, thickness: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or C.ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Ui.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 })
end

function Ui.padding(n: number): UIPadding
	local u = UDim.new(0, n)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.list(direction: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return Ui.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Ui.clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if not child:IsA("UIBase") then
			child:Destroy()
		end
	end
end

local function lighten(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), t)
end
local function darken(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), t)
end
Ui.lighten = lighten
Ui.darken = darken

-- text with a chunky dark outline. Extra keys: MaxText (largest text size), Outline (stroke thickness, 0 = none)
function Ui.text(props: { [string]: any }): TextLabel
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Ui.Font,
		TextColor3 = C.text,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		if k ~= "MaxText" and k ~= "Outline" then
			p[k] = v
		end
	end
	local label = Ui.new("TextLabel", p)
	Ui.new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 24, Parent = label })
	local outline = props.Outline or 1.6
	if outline > 0 then
		Ui.new("UIStroke", { Thickness = outline, Color = C.ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = label })
	end
	return label
end

function Ui.title(props: { [string]: any }): TextLabel
	props.Font = Ui.TitleFont
	props.Outline = props.Outline or 2.4
	return Ui.text(props)
end

-- a pressable gradient button. Extra props: MaxText
function Ui.button(text: string, color: Color3, onClick: () -> (), props: { [string]: any }?): TextButton
	local p: { [string]: any } = {
		Text = text,
		Font = Ui.Font,
		TextScaled = true,
		TextColor3 = C.text,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Size = UDim2.fromOffset(140, 42),
	}
	for k, v in (props or {}) :: { [string]: any } do
		if k ~= "MaxText" then
			p[k] = v
		end
	end
	local button = Ui.new("TextButton", p, {
		Ui.corner(12),
		Ui.stroke(C.ink, 3),
		Ui.padding(6),
		Ui.gradient(lighten(color, 0.22), darken(color, 0.22)),
	})
	Ui.new("UITextSizeConstraint", { MaxTextSize = (props and props.MaxText) or 22, Parent = button })
	Ui.new("UIStroke", { Thickness = 2, Color = C.ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = button })
	local scale = Ui.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.04 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	local busy = false
	button.Activated:Connect(function()
		if busy then
			return
		end
		busy = true
		local ok, err = pcall(onClick)
		if not ok then
			warn(err)
		end
		busy = false
	end)
	return button
end

-- recolours a button made by Ui.button
function Ui.setButtonColor(button: GuiObject, color: Color3)
	local g = button:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(lighten(color, 0.22), darken(color, 0.22))
	end
end

-- a small rounded tag
function Ui.chip(text: string, color: Color3, props: { [string]: any }?): Frame
	local p: { [string]: any } = { Size = UDim2.fromOffset(110, 26), BackgroundColor3 = Color3.new(1, 1, 1) }
	for k, v in (props or {}) :: { [string]: any } do
		p[k] = v
	end
	local chip = Ui.new("Frame", p, { Ui.round(), Ui.stroke(C.ink, 2), Ui.gradient(lighten(color, 0.15), darken(color, 0.3)) })
	Ui.text({ Text = text, Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 16, ZIndex = p.ZIndex, Parent = chip })
	return chip
end

-- ============================================================ animation

-- every registered gradient spins (mythic cards, banners)
local spinning: { [UIGradient]: number } = setmetatable({}, { __mode = "k" }) :: any
RunService.RenderStepped:Connect(function(dt)
	for g, speed in spinning do
		if g.Parent then
			g.Rotation = (g.Rotation + dt * speed) % 360
		end
	end
end)
function Ui.spin(g: UIGradient, speed: number?)
	spinning[g] = speed or 60
end

-- a frame pops in (UIScale from small with an overshoot)
function Ui.pop(frame: GuiObject, delay: number?)
	local s = frame:FindFirstChild("PopScale") or Ui.new("UIScale", { Name = "PopScale", Parent = frame })
	s.Scale = 0.6
	task.delay(delay or 0, function()
		TweenService:Create(s, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
end

-- ============================================================ windows

-- A window with a dark gradient body, gold border, a slanted gold title banner and a round red close button.
-- Returns the window and its content frame.
function Ui.window(parent: Instance, title: string, icon: string, size: UDim2, onClose: () -> ()): (Frame, Frame)
	local window = Ui.new("Frame", {
		Name = title,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.53),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = parent,
	}, { Ui.corner(18), Ui.gradient(C.bgTop, C.bgBottom) })
	local border = Ui.new("UIStroke", { Thickness = 5, Color = Color3.new(1, 1, 1), Parent = window })
	Ui.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 110)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(240, 150, 30)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 90)),
		}),
		Rotation = 45,
		Parent = border,
	})
	-- the title banner, overlapping the top-left corner
	local banner = Ui.new("Frame", {
		Name = "Banner",
		Size = UDim2.fromOffset(330, 58),
		Position = UDim2.fromOffset(-16, -30),
		Rotation = -2,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
		Parent = window,
	}, { Ui.corner(14), Ui.stroke(C.ink, 3), Ui.gradient(Color3.fromRGB(255, 226, 96), Color3.fromRGB(236, 136, 22)) })
	Ui.title({ Text = icon, Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(8, 5), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 40, ZIndex = 6, Parent = banner })
	Ui.title({ Text = title, Size = UDim2.new(1, -70, 0, 44), Position = UDim2.fromOffset(62, 7), MaxText = 38, ZIndex = 6, Parent = banner })
	local close = Ui.button("X", C.red, onClose, {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(1, -30, 0, -24),
		ZIndex = 6,
		MaxText = 30,
		Parent = window,
	})
	close.Font = Ui.TitleFont
	close:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	local content = Ui.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -32, 1, -58),
		Position = UDim2.fromOffset(16, 40),
		BackgroundTransparency = 1,
		Parent = window,
	})
	return window, content
end

function Ui.openWindow(window: GuiObject)
	window.Visible = true
	Ui.pop(window)
end

-- a darker inset panel inside a window
function Ui.inset(parent: Instance, props: { [string]: any }): Frame
	local p: { [string]: any } = { BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.15 }
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return Ui.new("Frame", p, { Ui.corner(14), Ui.stroke(Color3.fromRGB(80, 66, 150), 2) })
end

-- ============================================================ models

local viewportSpin: { [ViewportFrame]: { camera: Camera, center: Vector3, dist: number, angle: number } } = setmetatable({}, { __mode = "k" }) :: any
RunService.RenderStepped:Connect(function(dt)
	for vp, s in viewportSpin do
		if vp.Parent and vp.Visible then
			s.angle += dt * 0.8
			s.camera.CFrame = CFrame.lookAt(s.center + Vector3.new(math.sin(s.angle) * s.dist, s.dist * 0.25, -math.cos(s.angle) * s.dist), s.center)
		end
	end
end)

-- a ViewportFrame showing a unit or enemy model; spin = true turns it slowly
function Ui.viewport(key: string, props: { [string]: any }?, spin: boolean?): ViewportFrame
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(180, 180, 190),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
	}
	for k, v in (props or {}) :: { [string]: any } do
		p[k] = v
	end
	local vp = Ui.new("ViewportFrame", p)
	local model = ModelFactory.build(key, 1, true)
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local dist = math.max(size.X * 0.9, size.Y, size.Z * 0.9) * 1.55 + 1
	local center = cf.Position
	local camera = Ui.new("Camera", {
		FieldOfView = 38,
		CFrame = CFrame.lookAt(center + Vector3.new(dist * 0.42, dist * 0.22, -dist), center),
		Parent = vp,
	})
	vp.CurrentCamera = camera
	if spin then
		viewportSpin[vp] = { camera = camera, center = center, dist = dist, angle = 0.4 }
	end
	return vp
end

-- ============================================================ unit cards and stats

function Ui.unitName(unitId: string): string
	return ModelFactory.displayName(unitId, Units.ById[unitId].name)
end

function Ui.gradeBadge(grade: string, props: { [string]: any }): TextLabel
	local p: { [string]: any } = {
		Text = grade,
		Font = Ui.TitleFont,
		TextColor3 = Progression.GradeColor[grade] or C.text,
		TextXAlignment = Enum.TextXAlignment.Center,
		MaxText = 22,
		Outline = 2,
	}
	for k, v in props do
		p[k] = v
	end
	local label = Ui.text(p)
	if grade == "SSS" or grade == "SS" then
		Ui.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 160)),
				ColorSequenceKeypoint.new(0.5, Progression.GradeColor[grade]),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 160)),
			}),
			Parent = label,
		})
	end
	return label
end

-- a stat pill: grade badge, value and caption ("DMG 6.5k")
function Ui.statChip(caption: string, value: string, grade: string?, color: Color3, props: { [string]: any }?): Frame
	local p: { [string]: any } = { Size = UDim2.fromOffset(120, 44), BackgroundColor3 = Color3.new(1, 1, 1) }
	for k, v in (props or {}) :: { [string]: any } do
		p[k] = v
	end
	local chip = Ui.new("Frame", p, { Ui.corner(10), Ui.stroke(darken(color, 0.4), 2), Ui.gradient(darken(color, 0.45), darken(color, 0.7)) })
	Ui.text({ Text = caption, Size = UDim2.new(0, 46, 0, 14), Position = UDim2.fromOffset(6, 3), TextColor3 = lighten(color, 0.35), MaxText = 12, Outline = 1, Parent = chip })
	if grade then
		Ui.gradeBadge(grade, { Size = UDim2.fromOffset(40, 22), Position = UDim2.new(0, 4, 1, -25), Parent = chip })
	end
	Ui.text({ Text = value, Size = UDim2.new(1, grade and -48 or -12, 0, 26), Position = UDim2.new(0, grade and 44 or 6, 1, -29), TextXAlignment = Enum.TextXAlignment.Right, MaxText = 22, Parent = chip })
	return chip
end

function Ui.short(n: number): string
	if n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fk", n / 1e3)
	elseif n >= 1000 then
		return string.format("%.2fk", n / 1e3)
	elseif n >= 100 then
		return string.format("%d", math.floor(n + 0.5))
	end
	return string.format("%.1f", n)
end

function Ui.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

export type CardInfo = {
	unitId: string,
	level: number?,
	trait: string?,
	price: number?,
	badge: string?,
	badgeColor: Color3?,
	selected: boolean?,
	dim: boolean?,
}

-- A unit card: rarity gradient, model, "Lvl N", trait gem, price tag and name strip.
function Ui.unitCard(parent: Instance, info: CardInfo, size: UDim2, onClick: (() -> ())?): TextButton
	local def = Units.ById[info.unitId]
	local grad = Ui.RarityGradient[def.rarity]
	local card = Ui.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = size,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	}, { Ui.corner(12), Ui.stroke(info.selected and Color3.new(1, 1, 1) or C.ink, info.selected and 4 or 3) })
	local g = Ui.gradient(grad[1], grad[2])
	g.Parent = card
	if def.rarity == "Mythic" then
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 160)),
			ColorSequenceKeypoint.new(0.35, Color3.fromRGB(170, 70, 255)),
			ColorSequenceKeypoint.new(0.7, Color3.fromRGB(70, 200, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 160)),
		})
		Ui.spin(g, 50)
	end
	-- a soft shine across the top
	Ui.new("Frame", {
		Size = UDim2.new(1, -8, 0.35, 0),
		Position = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Parent = card,
	}, { Ui.corner(9) })
	Ui.viewport(info.unitId, { Size = UDim2.new(1, 0, 1, -12), Position = UDim2.fromOffset(0, 2), ZIndex = 2, Parent = card })
	-- name strip
	local strip = Ui.new("Frame", {
		Size = UDim2.new(1, -6, 0, 20),
		Position = UDim2.new(0, 3, 1, -23),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		ZIndex = 3,
		Parent = card,
	}, { Ui.corner(6) })
	Ui.text({ Text = Ui.unitName(info.unitId), Size = UDim2.new(1, -6, 1, -2), Position = UDim2.fromOffset(3, 1), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 15, ZIndex = 4, Parent = strip })
	if info.level then
		Ui.text({ Text = "Lvl " .. info.level, Size = UDim2.fromOffset(60, 18), Position = UDim2.fromOffset(5, 3), MaxText = 16, ZIndex = 4, Parent = card })
	end
	if info.price then
		Ui.text({
			Text = "$" .. Ui.formatNumber(info.price),
			Size = UDim2.new(0.75, 0, 0, 18),
			Position = UDim2.new(0.25, -5, 1, -42),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Color3.fromRGB(255, 225, 90),
			MaxText = 17,
			ZIndex = 4,
			Parent = card,
		})
	end
	if info.trait and Traits.ById[info.trait] then
		local t = Traits.ById[info.trait]
		local gem = Ui.new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, -22, 0, 5),
			Rotation = 45,
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
			Parent = card,
		}, { Ui.corner(4), Ui.stroke(C.ink, 2), Ui.gradient(lighten(Rarities.Info[t.rarity].color, 0.4), Rarities.Info[t.rarity].color) })
		if t.rarity == "Mythic" then
			Ui.spin(gem:FindFirstChildOfClass("UIGradient") :: UIGradient, 120)
		end
	end
	if info.badge then
		Ui.chip(info.badge, info.badgeColor or C.green, { Size = UDim2.fromOffset(64, 20), Position = UDim2.new(0.5, -32, 0, -10), ZIndex = 6, Parent = card })
	end
	if info.dim then
		Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 7, Parent = card }, { Ui.corner(12) })
	end
	if onClick then
		card.Activated:Connect(onClick)
	end
	local scale = Ui.new("UIScale", { Parent = card })
	card.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.05 }):Play()
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	return card
end

-- a progress bar; returns the bar and its fill
function Ui.bar(parent: Instance, props: { [string]: any }, fillColor: Color3, frac: number): (Frame, Frame)
	local p: { [string]: any } = { BackgroundColor3 = Color3.fromRGB(30, 22, 50) }
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	local bar = Ui.new("Frame", p, { Ui.round(), Ui.stroke(C.ink, 2) })
	local fill = Ui.new("Frame", {
		Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bar,
	}, { Ui.round(), Ui.gradient(lighten(fillColor, 0.3), darken(fillColor, 0.15)) })
	return bar, fill
end

-- ============================================================ toasts

local toastHolder: Frame? = nil
function Ui.toast(message: string, color: Color3?)
	if not toastHolder then
		local gui = Ui.new("ScreenGui", {
			Name = "Toasts",
			ResetOnSpawn = false,
			DisplayOrder = 50,
			IgnoreGuiInset = true,
			Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
		})
		toastHolder = Ui.new("Frame", {
			Size = UDim2.new(0, 460, 1, -160),
			Position = UDim2.new(0.5, 0, 0, 120),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			Parent = gui,
		}, { Ui.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	end
	local c = color or C.panel
	local toast = Ui.new("Frame", {
		Size = UDim2.fromOffset(440, 42),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = toastHolder,
	}, { Ui.corner(12), Ui.stroke(C.ink, 3), Ui.gradient(lighten(c, 0.15), darken(c, 0.25)) })
	local label = Ui.text({ Text = message, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 20, Parent = toast })
	Ui.pop(toast)
	task.delay(2.6, function()
		TweenService:Create(toast, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
		local tween = TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

return Ui
