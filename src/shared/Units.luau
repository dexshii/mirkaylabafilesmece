-- Summonable units. Every number here is the level-0 (just placed) value; upgrades scale it (see Stats).
--   attack.kind: "single" one target, "splash" hits around the target, "slam" hits everything around the unit,
--                "cone" a fire cone toward the target, "chain" jumps between enemies, "none" (farms/support)
--   hitsGround / hitsAir: which enemy layers it can target (bosses are on the layer of their kind)
local Units = {}

export type UnitDef = {
	id: string,
	name: string,
	rarity: string,
	role: string,
	desc: string,
	cost: number,
	limit: number,
	damage: number,
	range: number,
	cooldown: number,
	hitsGround: boolean,
	hitsAir: boolean,
	attack: { [string]: any },
	farm: number?,
	aura: { [string]: any }?,
	fx: { [string]: any },
	height: number,
}

